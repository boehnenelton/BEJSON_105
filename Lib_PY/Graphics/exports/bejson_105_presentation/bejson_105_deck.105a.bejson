      "BEJSON 105 Overview",
      "Integrity Era Specification",
      4.0,
      0.0,
      1280,
      720,
      "<svg width=\"1280\" height=\"720\" viewBox=\"0 0 1280 720\" xmlns=\"http://www.w3.org/2000/svg\">\n  <rect width=\"1280\" height=\"720\" fill=\"#111113\"/>\n  <rect x=\"64\" y=\"64\" width=\"540\" height=\"520\" rx=\"6\" fill=\"#0E0E10\" stroke=\"#24242A\" stroke-width=\"1.5\"/>\n  <path d=\"M 64 88 L 64 64 L 88 64\" fill=\"none\" stroke=\"#3A3A44\" stroke-width=\"1.5\"/>\n  <path d=\"M 580 64 L 604 64 L 604 88\" fill=\"none\" stroke=\"#3A3A44\" stroke-width=\"1.5\"/>\n  <path d=\"M 64 560 L 64 584 L 88 584\" fill=\"none\" stroke=\"#3A3A44\" stroke-width=\"1.5\"/>\n  <path d=\"M 580 584 L 604 584 L 604 560\" fill=\"none\" stroke=\"#3A3A44\" stroke-width=\"1.5\"/>\n  <g transform=\"translate(154, 144)\">\n    <svg viewBox=\"0 0 360 360\" xmlns=\"http://www.w3.org/2000/svg\" style=\"width:100%;height:100%;\">\n  <defs>\n    <filter id=\"cube-glow\" x=\"-20%\" y=\"-20%\" width=\"140%\" height=\"140%\">\n      <feGaussianBlur stdDeviation=\"6\" result=\"blur\" />\n      <feMerge>\n        <feMergeNode in=\"blur\" />\n        <feMergeNode in=\"SourceGraphic\" />\n      </feMerge>\n    </filter>\n  </defs>\n  <!-- Background coordinate crosshairs -->\n  <line x1=\"180.0\" y1=\"20\" x2=\"180.0\" y2=\"340\" stroke=\"#1c1c24\" stroke-width=\"1\" stroke-dasharray=\"4,4\" />\n  <line x1=\"20\" y1=\"180.0\" x2=\"340\" y2=\"180.0\" stroke=\"#1c1c24\" stroke-width=\"1\" stroke-dasharray=\"4,4\" />\n  <!-- Floating Cap (BEJSON 104a) -->\n  <polygon points=\"180.0,61.19999999999999 267.29536070147145,111.6 180.0,162.0 92.70463929852856,111.6\" fill=\"#DE2626\" fill-opacity=\"0.25\" stroke=\"#DE2626\" stroke-width=\"2.5\" filter=\"url(#cube-glow)\" />\n  <!-- Left Face -->\n  <polygon points=\"180.0,180.0 92.70463929852856,129.6 92.70463929852856,230.4 180.0,280.8\" fill=\"#0c0c10\" stroke=\"#FFFFFF\" stroke-width=\"2\" />\n  <!-- Right Face -->\n  <polygon points=\"180.0,180.0 267.29536070147145,129.6 267.29536070147145,230.4 180.0,280.8\" fill=\"#14141a\" stroke=\"#FFFFFF\" stroke-width=\"2\" />\n  <!-- Center Core Node -->\n  <circle cx=\"180.0\" cy=\"230.4\" r=\"4.0\" fill=\"#DE2626\" />\n</svg>\n  </g>\n  <text x=\"660\" y=\"130\" fill=\"#FFFFFF\" font-size=\"48\" font-family=\"system-ui, -apple-system, sans-serif\" font-weight=\"800\" letter-spacing=\"1\">BEJSON 105</text>\n  <text x=\"660\" y=\"175\" fill=\"#777782\" font-size=\"24\" font-family=\"system-ui, -apple-system, sans-serif\" font-weight=\"600\" letter-spacing=\"1\">INTEGRITY ERA SPECIFICATION</text>\n  <text x=\"660\" y=\"340\" fill=\"#888894\" font-size=\"18\" font-family=\"system-ui, -apple-system, sans-serif\" font-weight=\"400\" letter-spacing=\"0.5\">Positional column-oriented data container with cryptographically verifiable identity.</text>\n  <line x1=\"64\" y1=\"655\" x2=\"1216\" y2=\"655\" stroke=\"#DE2626\" stroke-width=\"2\"/>\n  <g transform=\"translate(1050, 660)\">\n    <text x=\"0\" y=\"22\" fill=\"#FFFFFF\" font-size=\"24\" font-family=\"system-ui, -apple-system, sans-serif\" font-weight=\"900\" letter-spacing=\"1.5\">BEJSON</text>\n    <g transform=\"translate(112, 0)\">\n      <polygon points=\"14,2 26,8 14,14 2,8\" fill=\"#FFFFFF\" stroke=\"#FFFFFF\" stroke-width=\"1\" stroke-linejoin=\"round\"/>\n      <polygon points=\"14,5 22,9 14,13 6,9\" fill=\"#111113\" opacity=\"0.9\"/>\n      <polygon points=\"2,8 14,14 14,28 2,22\" fill=\"#1C1C22\" stroke=\"#FFFFFF\" stroke-width=\"1\" stroke-linejoin=\"round\"/>\n      <polygon points=\"14,14 26,8 26,22 14,28\" fill=\"#DE2626\" stroke=\"#FFFFFF\" stroke-width=\"1\" stroke-linejoin=\"round\"/>\n    </g>\n  </g>\n</svg>",
