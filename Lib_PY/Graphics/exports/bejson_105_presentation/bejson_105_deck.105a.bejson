      8.0,
      1280,
      720,
      "<svg width=\"1280\" height=\"720\" viewBox=\"0 0 1280 720\" xmlns=\"http://www.w3.org/2000/svg\">\n  <rect width=\"1280\" height=\"720\" fill=\"#111113\"/>\n  <!-- Red accent bar above title -->\n  <rect x=\"64\" y=\"60\" width=\"44\" height=\"4\" rx=\"2\" fill=\"#DE2626\"/>\n  <text x=\"64\" y=\"115\" fill=\"#FFFFFF\" font-size=\"44\" font-family=\"system-ui, -apple-system, sans-serif\" font-weight=\"800\" letter-spacing=\"1\">INTEGRITY PIPELINE</text>\n  <!-- Flow Cards -->\n  <rect x=\"125\" y=\"260\" width=\"270\" height=\"180\" rx=\"12\" fill=\"#16161A\" stroke=\"#26262E\" stroke-width=\"1.5\"/>\n  <text x=\"260.0\" y=\"356.0\" fill=\"#FFFFFF\" font-size=\"18\" font-family=\"system-ui, -apple-system, sans-serif\" font-weight=\"600\" text-anchor=\"middle\">1. Schema Rigor</text>\n  <text x=\"260.0\" y=\"380.0\" fill=\"#777782\" font-size=\"13\" font-family=\"system-ui, -apple-system, sans-serif\" text-anchor=\"middle\">Fields & field_uuid</text>\n  <rect x=\"505\" y=\"260\" width=\"270\" height=\"180\" rx=\"12\" fill=\"#16161A\" stroke=\"#26262E\" stroke-width=\"1.5\"/>\n  <text x=\"640.0\" y=\"356.0\" fill=\"#FFFFFF\" font-size=\"18\" font-family=\"system-ui, -apple-system, sans-serif\" font-weight=\"600\" text-anchor=\"middle\">2. Positional Rows</text>\n  <text x=\"640.0\" y=\"380.0\" fill=\"#777782\" font-size=\"13\" font-family=\"system-ui, -apple-system, sans-serif\" text-anchor=\"middle\">Column 0 Identity</text>\n  <rect x=\"885\" y=\"260\" width=\"270\" height=\"180\" rx=\"12\" fill=\"#16161A\" stroke=\"#26262E\" stroke-width=\"1.5\"/>\n  <text x=\"1020.0\" y=\"356.0\" fill=\"#FFFFFF\" font-size=\"18\" font-family=\"system-ui, -apple-system, sans-serif\" font-weight=\"600\" text-anchor=\"middle\">3. Strict Validator</text>\n  <text x=\"1020.0\" y=\"380.0\" fill=\"#777782\" font-size=\"13\" font-family=\"system-ui, -apple-system, sans-serif\" text-anchor=\"middle\">Zero Hallucination</text>\n  <!-- Directional Arrows -->\n  <g transform=\"translate(405, 350)\">\n    <line x1=\"0\" y1=\"0\" x2=\"86\" y2=\"0\" stroke=\"#DE2626\" stroke-width=\"2.5\"/>\n    <polygon points=\"84,-6 96,0 84,6\" fill=\"#DE2626\"/>\n  </g>\n  <g transform=\"translate(785, 350)\">\n    <line x1=\"0\" y1=\"0\" x2=\"86\" y2=\"0\" stroke=\"#DE2626\" stroke-width=\"2.5\"/>\n    <polygon points=\"84,-6 96,0 84,6\" fill=\"#DE2626\"/>\n  </g>\n  <!-- Bottom divider -->\n  <line x1=\"64\" y1=\"655\" x2=\"1216\" y2=\"655\" stroke=\"#1C1C22\" stroke-width=\"1\"/>\n  <g transform=\"translate(1050, 660)\">\n    <text x=\"0\" y=\"22\" fill=\"#FFFFFF\" font-size=\"24\" font-family=\"system-ui, -apple-system, sans-serif\" font-weight=\"900\" letter-spacing=\"1.5\">BEJSON</text>\n    <g transform=\"translate(112, 0)\">\n      <polygon points=\"14,2 26,8 14,14 2,8\" fill=\"#FFFFFF\" stroke=\"#FFFFFF\" stroke-width=\"1\" stroke-linejoin=\"round\"/>\n      <polygon points=\"14,5 22,9 14,13 6,9\" fill=\"#111113\" opacity=\"0.9\"/>\n      <polygon points=\"2,8 14,14 14,28 2,22\" fill=\"#1C1C22\" stroke=\"#FFFFFF\" stroke-width=\"1\" stroke-linejoin=\"round\"/>\n      <polygon points=\"14,14 26,8 26,22 14,28\" fill=\"#DE2626\" stroke=\"#FFFFFF\" stroke-width=\"1\" stroke-linejoin=\"round\"/>\n    </g>\n  </g>\n</svg>",
