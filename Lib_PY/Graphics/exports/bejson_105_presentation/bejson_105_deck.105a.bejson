      4.0,
      4.0,
      1280,
      720,
      "<svg width=\"1280\" height=\"720\" viewBox=\"0 0 1280 720\" xmlns=\"http://www.w3.org/2000/svg\">\n  <rect width=\"1280\" height=\"720\" fill=\"#111113\"/>\n  <!-- Subtle coordinate crosshairs -->\n  <path d=\"M 640 24 L 640 44 M 630 34 L 650 34\" stroke=\"#222228\" stroke-width=\"1.5\"/>\n  <path d=\"M 640 676 L 640 696 M 630 686 L 650 686\" stroke=\"#222228\" stroke-width=\"1.5\"/>\n  <path d=\"M 34 350 L 34 370 M 24 360 L 44 360\" stroke=\"#222228\" stroke-width=\"1.5\"/>\n  <path d=\"M 1246 350 L 1246 370 M 1236 360 L 1256 360\" stroke=\"#222228\" stroke-width=\"1.5\"/>\n  <!-- Left Column -->\n  <text x=\"64\" y=\"130\" fill=\"#FFFFFF\" font-size=\"48\" font-family=\"system-ui, -apple-system, sans-serif\" font-weight=\"800\" letter-spacing=\"1\">CORE INVARIANTS</text>\n  <text x=\"64\" y=\"175\" fill=\"#777782\" font-size=\"24\" font-family=\"system-ui, -apple-system, sans-serif\" font-weight=\"600\" letter-spacing=\"1\">POSITIONAL RIGOR & IDENTITY</text>\n  <text x=\"64\" y=\"280\" fill=\"#666672\" font-size=\"18\" font-family=\"system-ui, -apple-system, sans-serif\" font-weight=\"400\" letter-spacing=\"0.5\">Deterministic schema declaration separated from raw positional row values.</text>\n  <!-- Right Column -->\n  <text x=\"680\" y=\"280\" fill=\"#FFFFFF\" font-size=\"26\" font-family=\"system-ui, -apple-system, sans-serif\" font-weight=\"700\" letter-spacing=\"1\">KEY POINTS</text>\n  <circle cx=\"695\" cy=\"330\" r=\"3.5\" fill=\"#777784\"/>\n  <text x=\"715\" y=\"335\" fill=\"#888894\" font-size=\"18\" font-family=\"system-ui, -apple-system, sans-serif\" font-weight=\"400\" letter-spacing=\"0.5\">UUIDv4 column headers survive renames and reordering</text>\n  <circle cx=\"695\" cy=\"380\" r=\"3.5\" fill=\"#777784\"/>\n  <text x=\"715\" y=\"385\" fill=\"#888894\" font-size=\"18\" font-family=\"system-ui, -apple-system, sans-serif\" font-weight=\"400\" letter-spacing=\"0.5\">Reserved column 0 for immutable row record_uuid</text>\n  <circle cx=\"695\" cy=\"430\" r=\"3.5\" fill=\"#777784\"/>\n  <text x=\"715\" y=\"435\" fill=\"#888894\" font-size=\"18\" font-family=\"system-ui, -apple-system, sans-serif\" font-weight=\"400\" letter-spacing=\"0.5\">O(1) cached field-map positional lookup</text>\n  <line x1=\"64\" y1=\"655\" x2=\"1216\" y2=\"655\" stroke=\"#DE2626\" stroke-width=\"2\"/>\n  <g transform=\"translate(1050, 660)\">\n    <text x=\"0\" y=\"22\" fill=\"#FFFFFF\" font-size=\"24\" font-family=\"system-ui, -apple-system, sans-serif\" font-weight=\"900\" letter-spacing=\"1.5\">BEJSON</text>\n    <g transform=\"translate(112, 0)\">\n      <polygon points=\"14,2 26,8 14,14 2,8\" fill=\"#FFFFFF\" stroke=\"#FFFFFF\" stroke-width=\"1\" stroke-linejoin=\"round\"/>\n      <polygon points=\"14,5 22,9 14,13 6,9\" fill=\"#111113\" opacity=\"0.9\"/>\n      <polygon points=\"2,8 14,14 14,28 2,22\" fill=\"#1C1C22\" stroke=\"#FFFFFF\" stroke-width=\"1\" stroke-linejoin=\"round\"/>\n      <polygon points=\"14,14 26,8 26,22 14,28\" fill=\"#DE2626\" stroke=\"#FFFFFF\" stroke-width=\"1\" stroke-linejoin=\"round\"/>\n    </g>\n  </g>\n</svg>",
