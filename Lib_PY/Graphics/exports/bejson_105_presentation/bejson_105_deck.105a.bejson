      720,
      "<svg width=\"1280\" height=\"720\" viewBox=\"0 0 1280 720\" xmlns=\"http://www.w3.org/2000/svg\">\n  <rect width=\"1280\" height=\"720\" fill=\"#F8F9FA\"/>\n  <!-- Visual Area Registration Marks -->\n  <path d=\"M 640 24 L 640 44 M 630 34 L 650 34\" stroke=\"#D8D9E0\" stroke-width=\"1.5\"/>\n  <path d=\"M 100 240 L 100 260 M 90 250 L 110 250\" stroke=\"#D8D9E0\" stroke-width=\"1.5\"/>\n  <path d=\"M 1180 240 L 1180 260 M 1170 250 L 1190 250\" stroke=\"#D8D9E0\" stroke-width=\"1.5\"/>\n  <path d=\"M 640 450 L 640 470 M 630 460 L 650 460\" stroke=\"#D8D9E0\" stroke-width=\"1.5\"/>\n  <path d=\"M 120 100 L 120 80 L 140 80\" fill=\"none\" stroke=\"#C0C0CA\" stroke-width=\"1.5\"/>\n  <path d=\"M 1160 440 L 1160 460 L 1140 460\" fill=\"none\" stroke=\"#C0C0CA\" stroke-width=\"1.5\"/>\n  <text x=\"640\" y=\"255\" fill=\"#888892\" font-size=\"16\" font-family=\"system-ui, -apple-system, sans-serif\" font-weight=\"500\" letter-spacing=\"0.5\" text-anchor=\"middle\">[ TOKEN CONSUMPTION REDUCED BY 90% ]</text>\n  <!-- Divider -->\n  <line x1=\"64\" y1=\"510\" x2=\"1216\" y2=\"510\" stroke=\"#DE2626\" stroke-width=\"2.5\"/>\n  <!-- Lower Section -->\n  <text x=\"64\" y=\"575\" fill=\"#111111\" font-size=\"36\" font-family=\"system-ui, -apple-system, sans-serif\" font-weight=\"800\" letter-spacing=\"1\">AI-NATIVE EFFICIENCY</text>\n  <text x=\"64\" y=\"618\" fill=\"#44444A\" font-size=\"18\" font-family=\"system-ui, -apple-system, sans-serif\" font-weight=\"400\">Eliminates repetitive JSON object keys, saving up to 90% in token bandwidth while guaranteeing schema integrity.</text>\n  <g transform=\"translate(1050, 635)\">\n    <text x=\"0\" y=\"22\" fill=\"#111111\" font-size=\"24\" font-family=\"system-ui, -apple-system, sans-serif\" font-weight=\"900\" letter-spacing=\"1.5\">BEJSON</text>\n    <g transform=\"translate(112, 0)\">\n      <polygon points=\"14,2 26,8 14,14 2,8\" fill=\"#FFFFFF\" stroke=\"#111111\" stroke-width=\"1\" stroke-linejoin=\"round\"/>\n      <polygon points=\"14,5 22,9 14,13 6,9\" fill=\"#F8F9FA\" opacity=\"0.9\"/>\n      <polygon points=\"2,8 14,14 14,28 2,22\" fill=\"#E5E7EB\" stroke=\"#111111\" stroke-width=\"1\" stroke-linejoin=\"round\"/>\n      <polygon points=\"14,14 26,8 26,22 14,28\" fill=\"#DE2626\" stroke=\"#111111\" stroke-width=\"1\" stroke-linejoin=\"round\"/>\n    </g>\n  </g>\n</svg>",
