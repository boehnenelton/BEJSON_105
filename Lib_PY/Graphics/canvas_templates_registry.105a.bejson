      64,
      "64:64",
      "#capture-stage",
      "Exemplar template template_icon_64x64.html from /storage/emulated/0/Admin/Dev/Templates/Canvas_SVG_Capture_Templates",
      "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"UTF-8\">\n  <title>Canvas Icon \u2014 64x64 Small Icon</title>\n  <style>\n    * {\n      box-sizing: border-box;\n      margin: 0;\n      padding: 0;\n    }\n    body {\n      background: #000000;\n      color: #FFFFFF;\n      width: 100vw;\n      height: 100vh;\n      display: flex;\n      align-items: center;\n      justify-content: center;\n      overflow: hidden;\n    }\n    #capture-stage {\n      position: relative;\n      width: 64px;\n      height: 64px;\n      background: #000000;\n      overflow: hidden;\n      display: flex;\n      align-items: center;\n      justify-content: center;\n    }\n    .svg-container {\n      width: 100%;\n      height: 100%;\n      display: flex;\n      align-items: center;\n      justify-content: center;\n    }\n    svg {\n      width: 100%;\n      height: 100%;\n      display: block;\n    }\n\n    @keyframes pulsePip {\n      0%, 100% { fill: #FFFFFF; filter: drop-shadow(0 0 2px #FFFFFF); }\n      50% { fill: #DE2626; filter: drop-shadow(0 0 6px #DE2626); }\n    }\n    .anim-pip {\n      animation: pulsePip 2s ease-in-out infinite;\n    }\n  </style>\n</head>\n<body>\n  <div id=\"capture-stage\">\n    <div class=\"svg-container\">\n      <svg viewBox=\"0 0 64 64\" xmlns=\"http://www.w3.org/2000/svg\">\n        <!-- Rounded Micro Tile -->\n        <rect x=\"3\" y=\"3\" width=\"58\" height=\"58\" rx=\"14\" fill=\"#0d0d12\" stroke=\"#252533\" stroke-width=\"1.5\"/>\n        <rect x=\"5\" y=\"5\" width=\"54\" height=\"54\" rx=\"12\" fill=\"none\" stroke=\"#DE2626\" stroke-width=\"0.8\" opacity=\"0.5\"/>\n\n        <!-- Pixel-Snapped Isometric Glyph -->\n        <!-- Top Face -->\n        <polygon points=\"32,16 46,24 32,32 18,24\" fill=\"#FFFFFF\" stroke=\"#DE2626\" stroke-width=\"1\"/>\n        <!-- Left Face -->\n        <polygon points=\"32,32 18,24 18,38 32,46\" fill=\"#252530\" stroke=\"#353545\" stroke-width=\"1\"/>\n        <!-- Right Face -->\n        <polygon points=\"32,32 46,24 46,38 32,46\" fill=\"#14141c\" stroke=\"#353545\" stroke-width=\"1\"/>\n        <!-- Spine -->\n        <line x1=\"32\" y1=\"32\" x2=\"32\" y2=\"46\" stroke=\"#DE2626\" stroke-width=\"1.2\"/>\n\n        <!-- Center Glowing Nucleus -->\n        <circle cx=\"32\" cy=\"32\" r=\"2\" class=\"anim-pip\"/>\n      </svg>\n    </div>\n  </div>\n\n  <script>\n    window.isReadyToCapture = false;\n    window.pauseAnimation = function() {\n      document.querySelectorAll('*').forEach(el => el.style.animationPlayState = 'paused');\n    };\n    window.playAnimation = function() {\n      document.querySelectorAll('*').forEach(el => el.style.animationPlayState = 'running');\n    };\n    window.seekProgress = function(progress) {\n      const totalDurationSec = 2.0;\n      const targetTimeSec = progress * totalDurationSec;\n      document.querySelectorAll('*').forEach(el => {\n        el.style.animationDelay = `-${targetTimeSec}s`;\n        el.style.animationPlayState = 'paused';\n      });\n    };\n    window.addEventListener('DOMContentLoaded', () => {\n      setTimeout(() => { window.isReadyToCapture = true; }, 200);\n    });\n  </script>\n</body>\n</html>\n",
