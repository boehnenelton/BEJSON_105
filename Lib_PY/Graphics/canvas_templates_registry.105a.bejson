      "800:800",
      "#capture-stage",
      "Exemplar template template_icon_studio.html from /storage/emulated/0/Admin/Dev/Templates/Canvas_SVG_Capture_Templates",
      "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"UTF-8\">\n  <title>Canvas Studio \u2014 Dynamic Icon & Graphic Canvas</title>\n  <style>\n    * {\n      box-sizing: border-box;\n      margin: 0;\n      padding: 0;\n    }\n    body {\n      background: #000000;\n      color: #FFFFFF;\n      width: 100vw;\n      height: 100vh;\n      display: flex;\n      align-items: center;\n      justify-content: center;\n      overflow: hidden;\n      font-family: -apple-system, BlinkMacSystemFont, \"Segoe UI\", Roboto, monospace;\n    }\n    #capture-stage {\n      position: relative;\n      background: #000000;\n      overflow: hidden;\n      display: flex;\n      align-items: center;\n      justify-content: center;\n    }\n    .svg-container {\n      width: 100%;\n      height: 100%;\n      display: flex;\n      align-items: center;\n      justify-content: center;\n    }\n    svg {\n      width: 100%;\n      height: 100%;\n      display: block;\n    }\n\n    @keyframes pulseCore {\n      0%, 100% { transform: scale(1); filter: drop-shadow(0 0 6px rgba(222, 38, 38, 0.4)); }\n      50% { transform: scale(1.08); filter: drop-shadow(0 0 16px rgba(222, 38, 38, 0.9)); }\n    }\n    @keyframes rotateReticle {\n      0% { transform: rotate(0deg); }\n      100% { transform: rotate(360deg); }\n    }\n    .anim-pulse {\n      transform-box: fill-box;\n      transform-origin: center;\n      animation: pulseCore 3s ease-in-out infinite;\n    }\n    .anim-rotate {\n      transform-box: fill-box;\n      transform-origin: center;\n      animation: rotateReticle 10s linear infinite;\n    }\n  </style>\n</head>\n<body>\n  <div id=\"capture-stage\">\n    <div class=\"svg-container\" id=\"svg-host\">\n      <!-- Dynamically generated or parameterized SVG content -->\n      <svg id=\"default-icon\" viewBox=\"0 0 256 256\" xmlns=\"http://www.w3.org/2000/svg\">\n        <rect x=\"12\" y=\"12\" width=\"232\" height=\"232\" rx=\"54\" fill=\"#0d0d14\" stroke=\"#252535\" stroke-width=\"2\"/>\n        <rect x=\"16\" y=\"16\" width=\"224\" height=\"224\" rx=\"50\" fill=\"none\" stroke=\"#DE2626\" stroke-width=\"1.2\" stroke-dasharray=\"6 4\" opacity=\"0.5\"/>\n        <g class=\"anim-rotate\">\n          <circle cx=\"128\" cy=\"128\" r=\"80\" fill=\"none\" stroke=\"#1f1f2c\" stroke-width=\"1.5\"/>\n          <circle cx=\"128\" cy=\"128\" r=\"80\" fill=\"none\" stroke=\"#DE2626\" stroke-width=\"2\" stroke-dasharray=\"20 60\" stroke-linecap=\"round\"/>\n        </g>\n        <g class=\"anim-pulse\">\n          <polygon points=\"128,84 170,108 128,132 86,108\" fill=\"#FFFFFF\" stroke=\"#DE2626\" stroke-width=\"1.5\"/>\n          <polygon points=\"128,132 86,108 86,156 128,180\" fill=\"#242432\" stroke=\"#36364a\" stroke-width=\"1.5\"/>\n          <polygon points=\"128,132 170,108 170,156 128,180\" fill=\"#14141c\" stroke=\"#36364a\" stroke-width=\"1.5\"/>\n          <line x1=\"128\" y1=\"132\" x2=\"128\" y2=\"180\" stroke=\"#DE2626\" stroke-width=\"2\"/>\n          <circle cx=\"128\" cy=\"132\" r=\"3\" fill=\"#DE2626\"/>\n        </g>\n      </svg>\n    </div>\n  </div>\n\n  <script>\n    // URL query parser\n    const params = new URLSearchParams(window.location.search);\n    const sizeParam = params.get('size') || '256x256';\n    const bgParam = params.get('bg') || '#000000';\n    const stage = document.getElementById('capture-stage');\n\n    const [w, h] = sizeParam.includes('x') ? sizeParam.split('x').map(Number) : [Number(sizeParam), Number(sizeParam)];\n    stage.style.width = (w || 256) + 'px';\n    stage.style.height = (h || 256) + 'px';\n    stage.style.background = bgParam === 'transparent' ? 'transparent' : bgParam;\n\n    window.isReadyToCapture = false;\n    window.pauseAnimation = function() {\n      document.querySelectorAll('*').forEach(el => el.style.animationPlayState = 'paused');\n    };\n    window.playAnimation = function() {\n      document.querySelectorAll('*').forEach(el => el.style.animationPlayState = 'running');\n    };\n    window.seekProgress = function(progress) {\n      const totalDurationSec = 3.0;\n      const targetTimeSec = progress * totalDurationSec;\n      document.querySelectorAll('*').forEach(el => {\n        el.style.animationDelay = `-${targetTimeSec}s`;\n        el.style.animationPlayState = 'paused';\n      });\n    };\n    window.addEventListener('DOMContentLoaded', () => {\n      setTimeout(() => { window.isReadyToCapture = true; }, 250);\n    });\n  </script>\n</body>\n</html>\n",
