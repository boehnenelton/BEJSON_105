      "800:800",
      "#capture-stage",
      "Exemplar template template_icon_bejson_mfdb_federation.html from /storage/emulated/0/Admin/Dev/Templates/Canvas_SVG_Capture_Templates",
      "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"UTF-8\">\n  <title>BEJSON MFDB Icon \u2014 Federated Cube Network</title>\n  <style>\n    * { box-sizing: border-box; margin: 0; padding: 0; }\n    body {\n      background: #000000;\n      color: #FFFFFF;\n      width: 100vw;\n      height: 100vh;\n      display: flex;\n      align-items: center;\n      justify-content: center;\n      overflow: hidden;\n      font-family: monospace;\n    }\n    #capture-stage {\n      position: relative;\n      width: 512px;\n      height: 512px;\n      background: #000000;\n      overflow: hidden;\n      display: flex;\n      align-items: center;\n      justify-content: center;\n    }\n    .svg-container { width: 100%; height: 100%; display: flex; align-items: center; justify-content: center; }\n    svg { width: 100%; height: 100%; display: block; }\n\n    @keyframes rotateNetwork {\n      0% { transform: rotate(0deg); }\n      100% { transform: rotate(360deg); }\n    }\n    @keyframes pulseMaster {\n      0%, 100% { transform: scale(1); filter: drop-shadow(0 0 8px rgba(222, 38, 38, 0.5)); }\n      50% { transform: scale(1.06); filter: drop-shadow(0 0 20px rgba(222, 38, 38, 0.95)); }\n    }\n    @keyframes busTransmit {\n      0% { stroke-dashoffset: 40; }\n      100% { stroke-dashoffset: 0; }\n    }\n\n    .anim-network { transform-origin: 256px 256px; animation: rotateNetwork 16s linear infinite; }\n    .anim-master { transform-origin: 256px 256px; animation: pulseMaster 3.5s ease-in-out infinite; }\n    .anim-bus { stroke-dasharray: 8 6; animation: busTransmit 1.2s linear infinite; }\n  </style>\n</head>\n<body>\n  <div id=\"capture-stage\">\n    <div class=\"svg-container\">\n      <svg viewBox=\"0 0 512 512\" xmlns=\"http://www.w3.org/2000/svg\">\n        <defs>\n          <linearGradient id=\"bgGradMFDB\" x1=\"0\" y1=\"0\" x2=\"1\" y2=\"1\">\n            <stop offset=\"0%\" stop-color=\"#0c0a0c\"/>\n            <stop offset=\"100%\" stop-color=\"#020102\"/>\n          </linearGradient>\n          <linearGradient id=\"masterTop\" x1=\"0\" y1=\"0\" x2=\"1\" y2=\"1\">\n            <stop offset=\"0%\" stop-color=\"#FFFFFF\"/>\n            <stop offset=\"100%\" stop-color=\"#D0D0D0\"/>\n          </linearGradient>\n        </defs>\n\n        <!-- Squircle Shell -->\n        <rect x=\"24\" y=\"24\" width=\"464\" height=\"464\" rx=\"108\" fill=\"url(#bgGradMFDB)\" stroke=\"#221820\" stroke-width=\"3\"/>\n        <rect x=\"32\" y=\"32\" width=\"448\" height=\"448\" rx=\"100\" fill=\"none\" stroke=\"#DE2626\" stroke-width=\"1.5\" stroke-dasharray=\"10 6\" opacity=\"0.6\"/>\n\n        <!-- Orbiting Satellite Network -->\n        <g class=\"anim-network\">\n          <!-- Orbital Track -->\n          <circle cx=\"256\" cy=\"256\" r=\"150\" fill=\"none\" stroke=\"#1d151c\" stroke-width=\"2\"/>\n\n          <!-- Bus Links from Center to Satellites -->\n          <line x1=\"256\" y1=\"256\" x2=\"256\" y2=\"106\" stroke=\"#DE2626\" stroke-width=\"2\" class=\"anim-bus\"/>\n          <line x1=\"256\" y1=\"256\" x2=\"406\" y2=\"256\" stroke=\"#DE2626\" stroke-width=\"2\" class=\"anim-bus\"/>\n          <line x1=\"256\" y1=\"256\" x2=\"256\" y2=\"406\" stroke=\"#DE2626\" stroke-width=\"2\" class=\"anim-bus\"/>\n          <line x1=\"256\" y1=\"256\" x2=\"106\" y2=\"256\" stroke=\"#DE2626\" stroke-width=\"2\" class=\"anim-bus\"/>\n\n          <!-- Satellite 1 (North Slave Node) -->\n          <g transform=\"translate(256, 106)\">\n            <polygon points=\"0,-16 14,-8 0,0 -14,-8\" fill=\"#FFFFFF\" stroke=\"#DE2626\" stroke-width=\"1.5\"/>\n            <polygon points=\"0,0 -14,-8 -14,8 0,16\" fill=\"#25161c\" stroke=\"#402430\" stroke-width=\"1.5\"/>\n            <polygon points=\"0,0 14,-8 14,8 0,16\" fill=\"#140b0f\" stroke=\"#402430\" stroke-width=\"1.5\"/>\n            <circle cx=\"0\" cy=\"0\" r=\"2.5\" fill=\"#DE2626\"/>\n          </g>\n\n          <!-- Satellite 2 (East Slave Node) -->\n          <g transform=\"translate(406, 256)\">\n            <polygon points=\"0,-16 14,-8 0,0 -14,-8\" fill=\"#FFFFFF\" stroke=\"#DE2626\" stroke-width=\"1.5\"/>\n            <polygon points=\"0,0 -14,-8 -14,8 0,16\" fill=\"#25161c\" stroke=\"#402430\" stroke-width=\"1.5\"/>\n            <polygon points=\"0,0 14,-8 14,8 0,16\" fill=\"#140b0f\" stroke=\"#402430\" stroke-width=\"1.5\"/>\n            <circle cx=\"0\" cy=\"0\" r=\"2.5\" fill=\"#DE2626\"/>\n          </g>\n\n          <!-- Satellite 3 (South Slave Node) -->\n          <g transform=\"translate(256, 406)\">\n            <polygon points=\"0,-16 14,-8 0,0 -14,-8\" fill=\"#FFFFFF\" stroke=\"#DE2626\" stroke-width=\"1.5\"/>\n            <polygon points=\"0,0 -14,-8 -14,8 0,16\" fill=\"#25161c\" stroke=\"#402430\" stroke-width=\"1.5\"/>\n            <polygon points=\"0,0 14,-8 14,8 0,16\" fill=\"#140b0f\" stroke=\"#402430\" stroke-width=\"1.5\"/>\n            <circle cx=\"0\" cy=\"0\" r=\"2.5\" fill=\"#DE2626\"/>\n          </g>\n\n          <!-- Satellite 4 (West Slave Node) -->\n          <g transform=\"translate(106, 256)\">\n            <polygon points=\"0,-16 14,-8 0,0 -14,-8\" fill=\"#FFFFFF\" stroke=\"#DE2626\" stroke-width=\"1.5\"/>\n            <polygon points=\"0,0 -14,-8 -14,8 0,16\" fill=\"#25161c\" stroke=\"#402430\" stroke-width=\"1.5\"/>\n            <polygon points=\"0,0 14,-8 14,8 0,16\" fill=\"#140b0f\" stroke=\"#402430\" stroke-width=\"1.5\"/>\n            <circle cx=\"0\" cy=\"0\" r=\"2.5\" fill=\"#DE2626\"/>\n          </g>\n        </g>\n\n        <!-- Large Central Master Cube (MFDB Manifest Node) -->\n        <g class=\"anim-master\">\n          <!-- Top Face -->\n          <polygon points=\"256,192 316,226 256,260 196,226\" fill=\"url(#masterTop)\" stroke=\"#DE2626\" stroke-width=\"2.5\"/>\n          <!-- Left Face -->\n          <polygon points=\"256,260 196,226 196,296 256,330\" fill=\"#2e1a22\" stroke=\"#4a2836\" stroke-width=\"2\"/>\n          <!-- Right Face -->\n          <polygon points=\"256,260 316,226 316,296 256,330\" fill=\"#1a0e14\" stroke=\"#4a2836\" stroke-width=\"2\"/>\n          <!-- Center Spine -->\n          <line x1=\"256\" y1=\"260\" x2=\"256\" y2=\"330\" stroke=\"#DE2626\" stroke-width=\"3\"/>\n          <circle cx=\"256\" cy=\"260\" r=\"4.5\" fill=\"#DE2626\" filter=\"drop-shadow(0 0 6px #DE2626)\"/>\n        </g>\n\n        <!-- Title & Spec Labels -->\n        <text x=\"256\" y=\"80\" fill=\"#DE2626\" font-size=\"15\" font-family=\"monospace\" font-weight=\"700\" letter-spacing=\"4\" text-anchor=\"middle\">BEJSON MFDB</text>\n        <text x=\"256\" y=\"98\" fill=\"#776677\" font-size=\"10\" font-family=\"monospace\" letter-spacing=\"2\" text-anchor=\"middle\">FEDERATED CUBE NETWORK</text>\n      </svg>\n    </div>\n  </div>\n\n  <script>\n    window.isReadyToCapture = false;\n    window.pauseAnimation = function() { document.querySelectorAll('*').forEach(el => el.style.animationPlayState = 'paused'); };\n    window.playAnimation = function() { document.querySelectorAll('*').forEach(el => el.style.animationPlayState = 'running'); };\n    window.seekProgress = function(progress) {\n      const dur = 3.5;\n      const t = progress * dur;\n      document.querySelectorAll('*').forEach(el => {\n        el.style.animationDelay = `-${t}s`;\n        el.style.animationPlayState = 'paused';\n      });\n    };\n    window.addEventListener('DOMContentLoaded', () => { setTimeout(() => { window.isReadyToCapture = true; }, 300); });\n  </script>\n</body>\n</html>\n",
