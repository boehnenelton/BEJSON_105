    [
      "976abccd-9988-4bdb-b8ea-cc4a13ca8c65",
      "legacy_template_texture_isometric_cube",
      "template_texture_isometric_cube.html",
      "legacy_exemplar",
      800,
      800,
      "800:800",
      "#capture-stage",
      "Exemplar template template_texture_isometric_cube.html from /storage/emulated/0/Admin/Dev/Templates/Canvas_SVG_Capture_Templates",
      "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"UTF-8\">\n  <title>Seamless Texture Tile Stage \u2014 Isometric Cube</title>\n  <style>\n    * {\n      box-sizing: border-box;\n      margin: 0;\n      padding: 0;\n    }\n    body {\n      background: #000000;\n      color: #FFFFFF;\n      width: 100vw;\n      height: 100vh;\n      display: flex;\n      align-items: center;\n      justify-content: center;\n      overflow: hidden;\n      font-family: -apple-system, BlinkMacSystemFont, \"Segoe UI\", Roboto, monospace;\n    }\n\n    /* Fixed-size capture stage for tiled canvas */\n    #capture-stage {\n      position: relative;\n      width: 800px;\n      height: 800px;\n      background: #000000;\n      border: 1px solid #1c1c22;\n      overflow: hidden;\n      display: flex;\n      align-items: center;\n      justify-content: center;\n    }\n\n    /* Isolated single tile container for direct seamless tile unit capture */\n    #tile-unit {\n      position: absolute;\n      top: -9999px;\n      left: -9999px;\n      width: 128px;\n      height: 128px;\n      background: #000000;\n      overflow: hidden;\n    }\n\n    svg.canvas-fill {\n      width: 100%;\n      height: 100%;\n      display: block;\n    }\n\n    /* Seamless diagonal drift animation for pattern coordinate space */\n    @keyframes patternDrift {\n      0% {\n        transform: translate(0px, 0px);\n      }\n      100% {\n        transform: translate(128px, 128px);\n      }\n    }\n\n    /* Pulse animation for accent nodes */\n    @keyframes nodePulse {\n      0%, 100% {\n        opacity: 0.35;\n        fill: #DE2626;\n        filter: drop-shadow(0 0 2px #DE2626);\n      }\n      50% {\n        opacity: 1.0;\n        fill: #FFFFFF;\n        filter: drop-shadow(0 0 8px #DE2626);\n      }\n    }\n\n    .anim-drift {\n      animation: patternDrift 6s linear infinite;\n    }\n\n    .anim-pulse {\n      animation: nodePulse 3s ease-in-out infinite;\n    }\n\n    /* Telemetry overlay */\n    .telemetry-tag {\n      position: absolute;\n      bottom: 16px;\n      left: 16px;\n      font-size: 11px;\n      letter-spacing: 1px;\n      color: rgba(255, 255, 255, 0.4);\n      background: rgba(0, 0, 0, 0.75);\n      padding: 4px 8px;\n      border: 1px solid #1c1c22;\n      pointer-events: none;\n      z-index: 10;\n    }\n  </style>\n</head>\n<body>\n\n  <!-- Full Tiled Canvas Stage (800x800) -->\n  <div id=\"capture-stage\">\n    <svg class=\"canvas-fill\" xmlns=\"http://www.w3.org/2000/svg\">\n      <defs>\n        <!-- Seamless 128x128 Isometric Cube Pattern -->\n        <pattern id=\"isometric-cube-pattern\" width=\"128\" height=\"128\" patternUnits=\"userSpaceOnUse\" class=\"anim-drift\">\n          <!-- Background cell fill -->\n          <rect width=\"128\" height=\"128\" fill=\"#050508\"/>\n\n          <!-- Primary Isometric Cube Unit A (Center: 64, 64) -->\n          <!-- Top Face -->\n          <polygon points=\"64,36 96,52 64,68 32,52\" fill=\"#181820\" stroke=\"#2c2c36\" stroke-width=\"1\"/>\n          <!-- Left Face -->\n          <polygon points=\"32,52 64,68 64,100 32,84\" fill=\"#0d0d12\" stroke=\"#2c2c36\" stroke-width=\"1\"/>\n          <!-- Right Face -->\n          <polygon points=\"64,68 96,52 96,84 64,100\" fill=\"#13131a\" stroke=\"#2c2c36\" stroke-width=\"1\"/>\n          <!-- Isometric Accent Floating Top (104a Taxonomy) -->\n          <polygon points=\"64,28 88,40 64,52 40,40\" fill=\"none\" stroke=\"#DE2626\" stroke-width=\"1.2\" opacity=\"0.85\"/>\n\n          <!-- Secondary Half-Offset Cube Units for Seamless Edge Tiling -->\n          <!-- Top-Left Corner Cube (0, 0) -->\n          <polygon points=\"0,-28 32,-12 0,4 -32,-12\" fill=\"#181820\" stroke=\"#2c2c36\" stroke-width=\"1\"/>\n          <polygon points=\"-32,-12 0,4 0,36 -32,20\" fill=\"#0d0d12\" stroke=\"#2c2c36\" stroke-width=\"1\"/>\n          <polygon points=\"0,4 32,-12 32,20 0,36\" fill=\"#13131a\" stroke=\"#2c2c36\" stroke-width=\"1\"/>\n          <polygon points=\"0,-36 24,-24 0,-12 -24,-24\" fill=\"none\" stroke=\"#DE2626\" stroke-width=\"1.2\" opacity=\"0.85\"/>\n\n          <!-- Top-Right Corner Cube (128, 0) -->\n          <polygon points=\"128,-28 160,-12 128,4 96,-12\" fill=\"#181820\" stroke=\"#2c2c36\" stroke-width=\"1\"/>\n          <polygon points=\"96,-12 128,4 128,36 96,20\" fill=\"#0d0d12\" stroke=\"#2c2c36\" stroke-width=\"1\"/>\n          <polygon points=\"128,4 160,-12 160,20 128,36\" fill=\"#13131a\" stroke=\"#2c2c36\" stroke-width=\"1\"/>\n          <polygon points=\"128,-36 152,-24 128,-12 104,-24\" fill=\"none\" stroke=\"#DE2626\" stroke-width=\"1.2\" opacity=\"0.85\"/>\n\n          <!-- Bottom-Left Corner Cube (0, 128) -->\n          <polygon points=\"0,100 32,116 0,132 -32,116\" fill=\"#181820\" stroke=\"#2c2c36\" stroke-width=\"1\"/>\n          <polygon points=\"-32,116 0,132 0,164 -32,148\" fill=\"#0d0d12\" stroke=\"#2c2c36\" stroke-width=\"1\"/>\n          <polygon points=\"0,132 32,116 32,148 0,164\" fill=\"#13131a\" stroke=\"#2c2c36\" stroke-width=\"1\"/>\n          <polygon points=\"0,92 24,104 0,116 -24,104\" fill=\"none\" stroke=\"#DE2626\" stroke-width=\"1.2\" opacity=\"0.85\"/>\n\n          <!-- Bottom-Right Corner Cube (128, 128) -->\n          <polygon points=\"128,100 160,116 128,132 96,116\" fill=\"#181820\" stroke=\"#2c2c36\" stroke-width=\"1\"/>\n          <polygon points=\"96,116 128,132 128,164 96,148\" fill=\"#0d0d12\" stroke=\"#2c2c36\" stroke-width=\"1\"/>\n          <polygon points=\"128,132 160,116 160,148 128,164\" fill=\"#13131a\" stroke=\"#2c2c36\" stroke-width=\"1\"/>\n          <polygon points=\"128,92 152,104 128,116 104,104\" fill=\"none\" stroke=\"#DE2626\" stroke-width=\"1.2\" opacity=\"0.85\"/>\n\n          <!-- Pulsing Micro-Nodes on Vertices -->\n          <circle cx=\"64\" cy=\"68\" r=\"2\" class=\"anim-pulse\"/>\n          <circle cx=\"0\" cy=\"4\" r=\"2\" class=\"anim-pulse\"/>\n          <circle cx=\"128\" cy=\"4\" r=\"2\" class=\"anim-pulse\"/>\n          <circle cx=\"0\" cy=\"132\" r=\"2\" class=\"anim-pulse\"/>\n          <circle cx=\"128\" cy=\"132\" r=\"2\" class=\"anim-pulse\"/>\n        </pattern>\n      </defs>\n\n      <!-- Fill entire canvas with seamless pattern -->\n      <rect width=\"100%\" height=\"100%\" fill=\"url(#isometric-cube-pattern)\"/>\n\n      <!-- Ambient Vignette -->\n      <radialGradient id=\"vignette\" cx=\"50%\" cy=\"50%\" r=\"60%\">\n        <stop offset=\"60%\" stop-color=\"#000000\" stop-opacity=\"0\"/>\n        <stop offset=\"100%\" stop-color=\"#000000\" stop-opacity=\"0.85\"/>\n      </radialGradient>\n      <rect width=\"100%\" height=\"100%\" fill=\"url(#vignette)\" pointer-events=\"none\"/>\n    </svg>\n\n    <div class=\"telemetry-tag\">TEXTURE_TILE // ISOMETRIC_CUBE_128PX</div>\n  </div>\n\n  <!-- Single 128x128 Tile Unit (Extractable by Playwright: --selector \"#tile-unit svg\") -->\n  <div id=\"tile-unit\">\n    <svg width=\"128\" height=\"128\" viewBox=\"0 0 128 128\" xmlns=\"http://www.w3.org/2000/svg\">\n      <rect width=\"128\" height=\"128\" fill=\"#050508\"/>\n      <polygon points=\"64,36 96,52 64,68 32,52\" fill=\"#181820\" stroke=\"#2c2c36\" stroke-width=\"1\"/>\n      <polygon points=\"32,52 64,68 64,100 32,84\" fill=\"#0d0d12\" stroke=\"#2c2c36\" stroke-width=\"1\"/>\n      <polygon points=\"64,68 96,52 96,84 64,100\" fill=\"#13131a\" stroke=\"#2c2c36\" stroke-width=\"1\"/>\n      <polygon points=\"64,28 88,40 64,52 40,40\" fill=\"none\" stroke=\"#DE2626\" stroke-width=\"1.2\" opacity=\"0.85\"/>\n      <circle cx=\"64\" cy=\"68\" r=\"2\" fill=\"#DE2626\"/>\n    </svg>\n  </div>\n\n  <script>\n    window.isReadyToCapture = false;\n\n    window.pauseAnimation = function() {\n      document.querySelectorAll('*').forEach(el => {\n        el.style.animationPlayState = 'paused';\n      });\n    };\n\n    window.playAnimation = function() {\n      document.querySelectorAll('*').forEach(el => {\n        el.style.animationPlayState = 'running';\n      });\n    };\n\n    window.seekProgress = function(progress) {\n      const totalDurationSec = 6.0;\n      const targetTimeSec = progress * totalDurationSec;\n      document.querySelectorAll('*').forEach(el => {\n        el.style.animationDelay = `-${targetTimeSec}s`;\n        el.style.animationPlayState = 'paused';\n      });\n    };\n\n    window.addEventListener('DOMContentLoaded', () => {\n      setTimeout(() => {\n        window.isReadyToCapture = true;\n      }, 300);\n    });\n  </script>\n</body>\n</html>\n",
      "0f3a2317c5e11b2b172378aac4927f95c7d8d35f3d35d3bdb04bde29619d2465"
