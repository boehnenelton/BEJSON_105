    [
      "6fe76d30-543b-438c-88eb-b0c9ab1358bf",
      "legacy_template_square_800x800",
      "template_square_800x800.html",
      "legacy_exemplar",
      800,
      800,
      "800:800",
      "#capture-stage",
      "Exemplar template template_square_800x800.html from /storage/emulated/0/Admin/Dev/Templates/Canvas_SVG_Capture_Templates",
      "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"UTF-8\">\n  <title>Canvas Stage \u2014 Square 800x800 (1:1)</title>\n  <style>\n    * {\n      box-sizing: border-box;\n      margin: 0;\n      padding: 0;\n    }\n    body {\n      background: #000000;\n      color: #FFFFFF;\n      width: 100vw;\n      height: 100vh;\n      display: flex;\n      align-items: center;\n      justify-content: center;\n      overflow: hidden;\n      font-family: -apple-system, BlinkMacSystemFont, \"Segoe UI\", Roboto, monospace;\n    }\n    /* Fixed-size capture stage */\n    #capture-stage {\n      position: relative;\n      width: 800px;\n      height: 800px;\n      background: #000000;\n      border: 1px solid #1c1c22;\n      overflow: hidden;\n      display: flex;\n      align-items: center;\n      justify-content: center;\n    }\n    /* Embedded SVG container */\n    .svg-container {\n      width: 100%;\n      height: 100%;\n      display: flex;\n      align-items: center;\n      justify-content: center;\n    }\n    svg {\n      width: 100%;\n      height: 100%;\n      display: block;\n    }\n    /* Animated element keyframes */\n    @keyframes pulseCore {\n      0%, 100% {\n        transform: scale(1);\n        filter: drop-shadow(0 0 10px rgba(222, 38, 38, 0.4));\n      }\n      50% {\n        transform: scale(1.08);\n        filter: drop-shadow(0 0 24px rgba(222, 38, 38, 0.9));\n      }\n    }\n    @keyframes orbitRing {\n      0% {\n        transform: rotate(0deg);\n      }\n      100% {\n        transform: rotate(360deg);\n      }\n    }\n    .anim-pulse {\n      transform-origin: 400px 400px;\n      animation: pulseCore 3s ease-in-out infinite;\n    }\n    .anim-orbit {\n      transform-origin: 400px 400px;\n      animation: orbitRing 8s linear infinite;\n    }\n  </style>\n</head>\n<body>\n  <div id=\"capture-stage\" data-width=\"800\" data-height=\"800\" data-ratio=\"1:1\">\n    <div class=\"svg-container\">\n      <svg id=\"svg-root\" viewBox=\"0 0 800 800\" xmlns=\"http://www.w3.org/2000/svg\">\n        <defs>\n          <radialGradient id=\"stageGlow\" cx=\"50%\" cy=\"50%\" r=\"50%\">\n            <stop offset=\"0%\" stop-color=\"#1e0a0a\" stop-opacity=\"0.8\" />\n            <stop offset=\"60%\" stop-color=\"#0a0a0d\" stop-opacity=\"0.4\" />\n            <stop offset=\"100%\" stop-color=\"#000000\" stop-opacity=\"0\" />\n          </radialGradient>\n          <linearGradient id=\"redAccentGrad\" x1=\"0%\" y1=\"0%\" x2=\"100%\" y2=\"100%\">\n            <stop offset=\"0%\" stop-color=\"#FF4D4D\" />\n            <stop offset=\"60%\" stop-color=\"#DE2626\" />\n            <stop offset=\"100%\" stop-color=\"#800A0A\" />\n          </linearGradient>\n          <linearGradient id=\"isoTop\" x1=\"0%\" y1=\"100%\" x2=\"100%\" y2=\"0%\">\n            <stop offset=\"0%\" stop-color=\"#2c2c34\" />\n            <stop offset=\"100%\" stop-color=\"#444450\" />\n          </linearGradient>\n          <linearGradient id=\"isoLeft\" x1=\"0%\" y1=\"0%\" x2=\"100%\" y2=\"100%\">\n            <stop offset=\"0%\" stop-color=\"#18181e\" />\n            <stop offset=\"100%\" stop-color=\"#101014\" />\n          </linearGradient>\n          <linearGradient id=\"isoRight\" x1=\"100%\" y1=\"0%\" x2=\"0%\" y2=\"100%\">\n            <stop offset=\"0%\" stop-color=\"#121216\" />\n            <stop offset=\"100%\" stop-color=\"#08080a\" />\n          </linearGradient>\n        </defs>\n\n        <!-- Background Ambient Glow -->\n        <rect width=\"800\" height=\"800\" fill=\"url(#stageGlow)\" />\n\n        <!-- Outer Reticle & Scale Marks -->\n        <circle cx=\"400\" cy=\"400\" r=\"340\" fill=\"none\" stroke=\"#222228\" stroke-width=\"1.5\" stroke-dasharray=\"8,6\" />\n        <circle cx=\"400\" cy=\"400\" r=\"280\" fill=\"none\" stroke=\"#18181f\" stroke-width=\"1\" />\n\n        <!-- Rotating Orbit Nodes (L6) -->\n        <g class=\"anim-orbit\">\n          <circle cx=\"400\" cy=\"60\" r=\"6\" fill=\"#DE2626\" />\n          <line x1=\"400\" y1=\"60\" x2=\"400\" y2=\"85\" stroke=\"#DE2626\" stroke-width=\"1.5\" />\n          <circle cx=\"740\" cy=\"400\" r=\"4\" fill=\"#FFFFFF\" opacity=\"0.8\" />\n          <circle cx=\"400\" cy=\"740\" r=\"4\" fill=\"#FFFFFF\" opacity=\"0.8\" />\n          <circle cx=\"60\" cy=\"400\" r=\"4\" fill=\"#FFFFFF\" opacity=\"0.8\" />\n        </g>\n\n        <!-- Center Isometric Cube Cluster (Core L1-L3) -->\n        <g class=\"anim-pulse\">\n          <!-- Base Platform -->\n          <polygon points=\"400,280 520,350 400,420 280,350\" fill=\"url(#isoTop)\" stroke=\"#555562\" stroke-width=\"1.5\" />\n          <polygon points=\"280,350 400,420 400,560 280,490\" fill=\"url(#isoLeft)\" stroke=\"#383844\" stroke-width=\"1.5\" />\n          <polygon points=\"400,420 520,350 520,490 400,560\" fill=\"url(#isoRight)\" stroke=\"#22222a\" stroke-width=\"1.5\" />\n\n          <!-- Floating Core Red Cube -->\n          <g transform=\"translate(0, -60)\">\n            <polygon points=\"400,310 460,345 400,380 340,345\" fill=\"url(#redAccentGrad)\" stroke=\"#FFAAAA\" stroke-width=\"1.5\" />\n            <polygon points=\"340,345 400,380 400,450 340,415\" fill=\"#CC1F1F\" stroke=\"#991414\" stroke-width=\"1.5\" />\n            <polygon points=\"400,380 460,345 460,415 400,450\" fill=\"#880D0D\" stroke=\"#660A0A\" stroke-width=\"1.5\" />\n          </g>\n        </g>\n\n        <!-- Coordinate Geometry HUD Overlay -->\n        <text x=\"40\" y=\"70\" fill=\"#888899\" font-size=\"12\" font-family=\"monospace\" letter-spacing=\"2\">CANVAS_DIM: 800x800</text>\n        <text x=\"40\" y=\"90\" fill=\"#DE2626\" font-size=\"11\" font-family=\"monospace\" letter-spacing=\"1\">RATIO: 1:1 SQUARE</text>\n        <text x=\"760\" y=\"70\" fill=\"#555566\" font-size=\"11\" font-family=\"monospace\" text-anchor=\"end\">FPS: 60 SYNC</text>\n        <text x=\"400\" y=\"740\" fill=\"#777788\" font-size=\"13\" font-family=\"sans-serif\" font-weight=\"700\" letter-spacing=\"4\" text-anchor=\"middle\">ANIMATION STAGE</text>\n      </svg>\n    </div>\n  </div>\n\n  <script>\n    // Playwright deterministic capture hooks\n    window.isReadyToCapture = false;\n\n    window.pauseAnimation = function() {\n      document.querySelectorAll('*').forEach(el => {\n        el.style.animationPlayState = 'paused';\n      });\n    };\n\n    window.playAnimation = function() {\n      document.querySelectorAll('*').forEach(el => {\n        el.style.animationPlayState = 'running';\n      });\n    };\n\n    window.seekProgress = function(progress) {\n      // Seek CSS animation progression [0.0 to 1.0]\n      const totalDurationSec = 8.0;\n      const targetTimeSec = progress * totalDurationSec;\n      document.querySelectorAll('*').forEach(el => {\n        el.style.animationDelay = `-${targetTimeSec}s`;\n        el.style.animationPlayState = 'paused';\n      });\n    };\n\n    window.addEventListener('DOMContentLoaded', () => {\n      // Allow fonts and SVG layout to settle\n      setTimeout(() => {\n        window.isReadyToCapture = true;\n      }, 300);\n    });\n  </script>\n</body>\n</html>\n",
      "81ab31812039bcef1f9a907aa42ad30d3249f89ac8dc50f63e42afecad8e848b"
