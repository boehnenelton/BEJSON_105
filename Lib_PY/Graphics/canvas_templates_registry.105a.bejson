    [
      "c4ee0fc3-1564-4dce-b389-b5ff6f37b344",
      "legacy_template_portrait_720x1280",
      "template_portrait_720x1280.html",
      "legacy_exemplar",
      720,
      1280,
      "720:1280",
      "#capture-stage",
      "Exemplar template template_portrait_720x1280.html from /storage/emulated/0/Admin/Dev/Templates/Canvas_SVG_Capture_Templates",
      "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"UTF-8\">\n  <title>Canvas Stage \u2014 Portrait 720x1280 (9:16)</title>\n  <style>\n    * {\n      box-sizing: border-box;\n      margin: 0;\n      padding: 0;\n    }\n    body {\n      background: #000000;\n      color: #FFFFFF;\n      width: 100vw;\n      height: 100vh;\n      display: flex;\n      align-items: center;\n      justify-content: center;\n      overflow: hidden;\n      font-family: -apple-system, BlinkMacSystemFont, \"Segoe UI\", Roboto, monospace;\n    }\n    #capture-stage {\n      position: relative;\n      width: 720px;\n      height: 1280px;\n      background: #09090c;\n      border: 1px solid #1c1c22;\n      overflow: hidden;\n      display: flex;\n      align-items: center;\n      justify-content: center;\n    }\n    .svg-container {\n      width: 100%;\n      height: 100%;\n    }\n    svg {\n      width: 100%;\n      height: 100%;\n      display: block;\n    }\n    @keyframes dropPulse {\n      0% {\n        transform: translateY(0);\n        opacity: 0.2;\n      }\n      50% {\n        opacity: 1;\n      }\n      100% {\n        transform: translateY(600px);\n        opacity: 0.1;\n      }\n    }\n    .anim-drop {\n      animation: dropPulse 3.5s cubic-bezier(0.4, 0, 0.2, 1) infinite;\n    }\n  </style>\n</head>\n<body>\n  <div id=\"capture-stage\" data-width=\"720\" data-height=\"1280\" data-ratio=\"9:16\">\n    <div class=\"svg-container\">\n      <svg id=\"svg-root\" viewBox=\"0 0 720 1280\" xmlns=\"http://www.w3.org/2000/svg\">\n        <defs>\n          <linearGradient id=\"verticalBg\" x1=\"0%\" y1=\"0%\" x2=\"0%\" y2=\"100%\">\n            <stop offset=\"0%\" stop-color=\"#0a0a0f\" />\n            <stop offset=\"50%\" stop-color=\"#050507\" />\n            <stop offset=\"100%\" stop-color=\"#020203\" />\n          </linearGradient>\n          <linearGradient id=\"redPillarGrad\" x1=\"0%\" y1=\"0%\" x2=\"0%\" y2=\"100%\">\n            <stop offset=\"0%\" stop-color=\"#DE2626\" stop-opacity=\"1\" />\n            <stop offset=\"100%\" stop-color=\"#DE2626\" stop-opacity=\"0\" />\n          </linearGradient>\n        </defs>\n\n        <rect width=\"720\" height=\"1280\" fill=\"url(#verticalBg)\" />\n\n        <!-- Header HUD Area -->\n        <g transform=\"translate(48, 64)\">\n          <rect x=\"0\" y=\"0\" width=\"140\" height=\"28\" rx=\"4\" fill=\"#181820\" stroke=\"#282834\" stroke-width=\"1\" />\n          <circle cx=\"14\" cy=\"14\" r=\"4\" fill=\"#DE2626\" />\n          <text x=\"28\" y=\"18\" fill=\"#888899\" font-size=\"11\" font-family=\"monospace\">PORTRAIT REEL</text>\n\n          <text x=\"0\" y=\"64\" fill=\"#FFFFFF\" font-size=\"28\" font-family=\"sans-serif\" font-weight=\"900\" letter-spacing=\"1\">TELEMETRY STACK</text>\n          <text x=\"0\" y=\"90\" fill=\"#DE2626\" font-size=\"13\" font-family=\"monospace\">DIMENSIONS: 720x1280 (9:16)</text>\n        </g>\n\n        <!-- Vertical Guide Lines -->\n        <line x1=\"360\" y1=\"200\" x2=\"360\" y2=\"1140\" stroke=\"#1c1c24\" stroke-width=\"2\" />\n        <line x1=\"180\" y1=\"200\" x2=\"180\" y2=\"1140\" stroke=\"#14141a\" stroke-width=\"1\" stroke-dasharray=\"6,6\" />\n        <line x1=\"540\" y1=\"200\" x2=\"540\" y2=\"1140\" stroke=\"#14141a\" stroke-width=\"1\" stroke-dasharray=\"6,6\" />\n\n        <!-- Falling Data Pulse Signal -->\n        <g class=\"anim-drop\" transform=\"translate(360, 240)\">\n          <line x1=\"0\" y1=\"-80\" x2=\"0\" y2=\"0\" stroke=\"url(#redPillarGrad)\" stroke-width=\"3\" />\n          <circle cx=\"0\" cy=\"0\" r=\"6\" fill=\"#DE2626\" />\n        </g>\n\n        <!-- Stacked Card Blocks (6 Tiers) -->\n        <g transform=\"translate(180, 260)\">\n          <!-- Tier 6 -->\n          <rect x=\"0\" y=\"0\" width=\"360\" height=\"110\" rx=\"10\" fill=\"#141418\" stroke=\"#2c2c38\" stroke-width=\"1.5\" />\n          <text x=\"24\" y=\"44\" fill=\"#FFFFFF\" font-size=\"16\" font-weight=\"700\">L6 Composition</text>\n          <text x=\"24\" y=\"74\" fill=\"#777788\" font-size=\"12\" font-family=\"monospace\">DAG Execution Root</text>\n          <circle cx=\"320\" cy=\"55\" r=\"12\" fill=\"#1e1e26\" />\n          <text x=\"320\" y=\"59\" fill=\"#DE2626\" font-size=\"11\" font-weight=\"700\" text-anchor=\"middle\">6</text>\n\n          <!-- Tier 4 -->\n          <rect x=\"0\" y=\"150\" width=\"360\" height=\"110\" rx=\"10\" fill=\"#141418\" stroke=\"#2c2c38\" stroke-width=\"1.5\" />\n          <text x=\"24\" y=\"194\" fill=\"#FFFFFF\" font-size=\"16\" font-weight=\"700\">L4 Presentation</text>\n          <text x=\"24\" y=\"224\" fill=\"#777788\" font-size=\"12\" font-family=\"monospace\">BEHTML Spatial Grids</text>\n          <circle cx=\"320\" cy=\"205\" r=\"12\" fill=\"#1e1e26\" />\n          <text x=\"320\" y=\"209\" fill=\"#DE2626\" font-size=\"11\" font-weight=\"700\" text-anchor=\"middle\">4</text>\n\n          <!-- Tier 2 -->\n          <rect x=\"0\" y=\"300\" width=\"360\" height=\"110\" rx=\"10\" fill=\"#141418\" stroke=\"#2c2c38\" stroke-width=\"1.5\" />\n          <text x=\"24\" y=\"344\" fill=\"#FFFFFF\" font-size=\"16\" font-weight=\"700\">L2 Verification</text>\n          <text x=\"24\" y=\"374\" fill=\"#777788\" font-size=\"12\" font-family=\"monospace\">Stage-Gate Validators</text>\n          <circle cx=\"320\" cy=\"355\" r=\"12\" fill=\"#1e1e26\" />\n          <text x=\"320\" y=\"359\" fill=\"#DE2626\" font-size=\"11\" font-weight=\"700\" text-anchor=\"middle\">2</text>\n\n          <!-- Tier 1 Core Anchor -->\n          <rect x=\"0\" y=\"450\" width=\"360\" height=\"130\" rx=\"10\" fill=\"#181822\" stroke=\"#DE2626\" stroke-width=\"2\" />\n          <polygon points=\"24,484 34,492 24,500\" fill=\"#DE2626\" />\n          <text x=\"44\" y=\"496\" fill=\"#FFFFFF\" font-size=\"18\" font-weight=\"900\">L1 Substrate</text>\n          <text x=\"24\" y=\"534\" fill=\"#AAAAAA\" font-size=\"12\" font-family=\"monospace\">BEJSON Tabular Discipline</text>\n          <circle cx=\"320\" cy=\"515\" r=\"14\" fill=\"#DE2626\" />\n          <text x=\"320\" y=\"520\" fill=\"#FFFFFF\" font-size=\"12\" font-weight=\"900\" text-anchor=\"middle\">1</text>\n        </g>\n\n        <!-- Footer -->\n        <text x=\"360\" y=\"1220\" fill=\"#555566\" font-size=\"12\" font-family=\"monospace\" letter-spacing=\"2\" text-anchor=\"middle\">PLAYWRIGHT_PORTRAIT_CAPTURE</text>\n      </svg>\n    </div>\n  </div>\n\n  <script>\n    window.isReadyToCapture = false;\n\n    window.pauseAnimation = function() {\n      document.querySelectorAll('*').forEach(el => {\n        el.style.animationPlayState = 'paused';\n      });\n    };\n\n    window.playAnimation = function() {\n      document.querySelectorAll('*').forEach(el => {\n        el.style.animationPlayState = 'running';\n      });\n    };\n\n    window.seekProgress = function(progress) {\n      const totalDurationSec = 3.5;\n      const targetTimeSec = progress * totalDurationSec;\n      document.querySelectorAll('*').forEach(el => {\n        el.style.animationDelay = `-${targetTimeSec}s`;\n        el.style.animationPlayState = 'paused';\n      });\n    };\n\n    window.addEventListener('DOMContentLoaded', () => {\n      setTimeout(() => {\n        window.isReadyToCapture = true;\n      }, 300);\n    });\n  </script>\n</body>\n</html>\n",
