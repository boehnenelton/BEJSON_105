    [
      "d561f754-db48-4d36-8f90-89afdaeabee7",
      "legacy_template_texture_tile_studio",
      "template_texture_tile_studio.html",
      "legacy_exemplar",
      800,
      800,
      "800:800",
      "#capture-stage",
      "Exemplar template template_texture_tile_studio.html from /storage/emulated/0/Admin/Dev/Templates/Canvas_SVG_Capture_Templates",
      "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"UTF-8\">\n  <title>Seamless Texture Tile Studio & Playwright Capture</title>\n  <style>\n    * {\n      box-sizing: border-box;\n      margin: 0;\n      padding: 0;\n    }\n    body {\n      background: #000000;\n      color: #FFFFFF;\n      width: 100vw;\n      height: 100vh;\n      display: flex;\n      flex-direction: column;\n      align-items: center;\n      justify-content: center;\n      overflow: hidden;\n      font-family: -apple-system, BlinkMacSystemFont, \"Segoe UI\", Roboto, monospace;\n    }\n\n    /* Fixed-size capture stage for tiled canvas */\n    #capture-stage {\n      position: relative;\n      width: 800px;\n      height: 800px;\n      background: #000000;\n      border: 1px solid #1c1c22;\n      overflow: hidden;\n      display: flex;\n      align-items: center;\n      justify-content: center;\n      flex-shrink: 0;\n    }\n\n    /* Standalone tile unit container */\n    #tile-unit {\n      position: absolute;\n      top: -9999px;\n      left: -9999px;\n      background: #000000;\n      overflow: hidden;\n    }\n\n    /* In mode=tile, tile-unit replaces stage view */\n    body.mode-tile #capture-stage {\n      display: none;\n    }\n    body.mode-tile #tile-unit {\n      position: relative;\n      top: 0;\n      left: 0;\n      border: 1px solid #DE2626;\n      box-shadow: 0 0 20px rgba(222, 38, 38, 0.4);\n    }\n\n    svg.canvas-fill {\n      width: 100%;\n      height: 100%;\n      display: block;\n    }\n\n    /* Animations */\n    @keyframes patternDrift {\n      0% {\n        transform: translate(0px, 0px);\n      }\n      100% {\n        transform: translate(var(--tile-size, 64px), var(--tile-size, 64px));\n      }\n    }\n\n    @keyframes pulseGlow {\n      0%, 100% {\n        opacity: 0.35;\n        filter: drop-shadow(0 0 2px #DE2626);\n      }\n      50% {\n        opacity: 1.0;\n        filter: drop-shadow(0 0 8px #DE2626);\n      }\n    }\n\n    .anim-drift {\n      animation: patternDrift 6s linear infinite;\n    }\n\n    .anim-pulse {\n      animation: pulseGlow 2.5s ease-in-out infinite;\n    }\n\n    /* Compact studio toolbar */\n    #studio-bar {\n      position: fixed;\n      top: 12px;\n      display: flex;\n      gap: 8px;\n      background: rgba(10, 10, 14, 0.9);\n      padding: 6px 12px;\n      border: 1px solid #22222a;\n      border-radius: 4px;\n      font-size: 11px;\n      z-index: 100;\n    }\n    #studio-bar.hidden {\n      display: none;\n    }\n    .bar-btn {\n      background: #181820;\n      color: #FFFFFF;\n      border: 1px solid #33333f;\n      padding: 4px 8px;\n      font-size: 11px;\n      cursor: pointer;\n      font-family: inherit;\n    }\n    .bar-btn:hover, .bar-btn.active {\n      background: #DE2626;\n      border-color: #DE2626;\n      color: #FFFFFF;\n    }\n  </style>\n</head>\n<body>\n\n  <!-- Controls bar (hidden if ?ui=hide) -->\n  <div id=\"studio-bar\">\n    <button class=\"bar-btn active\" onclick=\"setPattern('cube')\">Cube</button>\n    <button class=\"bar-btn\" onclick=\"setPattern('checkerboard')\">Checkerboard</button>\n    <button class=\"bar-btn\" onclick=\"setPattern('circuit')\">Circuit</button>\n    <button class=\"bar-btn\" onclick=\"setPattern('hex')\">Hex Mesh</button>\n    <button class=\"bar-btn\" onclick=\"setPattern('dots')\">Dots</button>\n    <button class=\"bar-btn\" onclick=\"toggleMode()\">Toggle Tile/Canvas</button>\n  </div>\n\n  <!-- Full Tiled Canvas Stage -->\n  <div id=\"capture-stage\">\n    <svg class=\"canvas-fill\" xmlns=\"http://www.w3.org/2000/svg\">\n      <defs id=\"svg-defs\">\n        <!-- Injected dynamically via JS to support all patterns & tile sizes -->\n      </defs>\n\n      <!-- Fill entire canvas with active pattern -->\n      <rect id=\"canvas-rect\" width=\"100%\" height=\"100%\" fill=\"url(#studio-pattern)\"/>\n\n      <!-- Ambient Vignette -->\n      <radialGradient id=\"vignette\" cx=\"50%\" cy=\"50%\" r=\"60%\">\n        <stop offset=\"60%\" stop-color=\"#000000\" stop-opacity=\"0\"/>\n        <stop offset=\"100%\" stop-color=\"#000000\" stop-opacity=\"0.85\"/>\n      </radialGradient>\n      <rect width=\"100%\" height=\"100%\" fill=\"url(#vignette)\" pointer-events=\"none\"/>\n    </svg>\n  </div>\n\n  <!-- Isolated Tile Unit -->\n  <div id=\"tile-unit\">\n    <svg id=\"tile-svg\" xmlns=\"http://www.w3.org/2000/svg\">\n      <!-- Injected dynamically via JS -->\n    </svg>\n  </div>\n\n  <script>\n    window.isReadyToCapture = false;\n\n    // Pattern definitions dictionary\n    const PATTERN_REGISTRY = {\n      cube: (size) => `\n        <pattern id=\"studio-pattern\" width=\"${size}\" height=\"${size}\" patternUnits=\"userSpaceOnUse\" class=\"anim-drift\">\n          <rect width=\"${size}\" height=\"${size}\" fill=\"#050508\"/>\n          <!-- Top Face -->\n          <polygon points=\"${size*0.5},${size*0.28} ${size*0.75},${size*0.4} ${size*0.5},${size*0.53} ${size*0.25},${size*0.4}\" fill=\"#181820\" stroke=\"#2c2c36\" stroke-width=\"1\"/>\n          <!-- Left Face -->\n          <polygon points=\"${size*0.25},${size*0.4} ${size*0.5},${size*0.53} ${size*0.5},${size*0.78} ${size*0.25},${size*0.65}\" fill=\"#0d0d12\" stroke=\"#2c2c36\" stroke-width=\"1\"/>\n          <!-- Right Face -->\n          <polygon points=\"${size*0.5},${size*0.53} ${size*0.75},${size*0.4} ${size*0.75},${size*0.65} ${size*0.5},${size*0.78}\" fill=\"#13131a\" stroke=\"#2c2c36\" stroke-width=\"1\"/>\n          <!-- Accent floating outline (104a) -->\n          <polygon points=\"${size*0.5},${size*0.22} ${size*0.68},${size*0.31} ${size*0.5},${size*0.4} ${size*0.32},${size*0.31}\" fill=\"none\" stroke=\"#DE2626\" stroke-width=\"1.2\" opacity=\"0.85\"/>\n          <circle cx=\"${size*0.5}\" cy=\"${size*0.53}\" r=\"2\" fill=\"#DE2626\" class=\"anim-pulse\"/>\n        </pattern>\n      `,\n      checkerboard: (size) => `\n        <pattern id=\"studio-pattern\" width=\"${size}\" height=\"${size}\" patternUnits=\"userSpaceOnUse\" class=\"anim-drift\">\n          <rect x=\"0\" y=\"0\" width=\"${size*0.5}\" height=\"${size*0.5}\" fill=\"#000000\"/>\n          <rect x=\"${size*0.5}\" y=\"0\" width=\"${size*0.5}\" height=\"${size*0.5}\" fill=\"#111116\"/>\n          <rect x=\"0\" y=\"${size*0.5}\" width=\"${size*0.5}\" height=\"${size*0.5}\" fill=\"#111116\"/>\n          <rect x=\"${size*0.5}\" y=\"${size*0.5}\" width=\"${size*0.5}\" height=\"${size*0.5}\" fill=\"#000000\"/>\n          <path d=\"M 0,0 L ${size},0 L ${size},${size} L 0,${size} Z\" fill=\"none\" stroke=\"#1c1c24\" stroke-width=\"1\"/>\n          <path d=\"M ${size*0.5},0 L ${size*0.5},${size} M 0,${size*0.5} L ${size},${size*0.5}\" stroke=\"#22222c\" stroke-width=\"0.75\"/>\n          <circle cx=\"${size*0.5}\" cy=\"${size*0.5}\" r=\"3\" fill=\"none\" stroke=\"#DE2626\" stroke-width=\"1\" class=\"anim-pulse\"/>\n        </pattern>\n      `,\n      circuit: (size) => `\n        <pattern id=\"studio-pattern\" width=\"${size}\" height=\"${size}\" patternUnits=\"userSpaceOnUse\" class=\"anim-drift\">\n          <rect width=\"${size}\" height=\"${size}\" fill=\"#040407\"/>\n          <line x1=\"0\" y1=\"${size*0.5}\" x2=\"${size*0.3}\" y2=\"${size*0.5}\" stroke=\"#22222a\" stroke-width=\"1.5\"/>\n          <line x1=\"${size*0.7}\" y1=\"${size*0.5}\" x2=\"${size}\" y2=\"${size*0.5}\" stroke=\"#22222a\" stroke-width=\"1.5\"/>\n          <line x1=\"${size*0.5}\" y1=\"0\" x2=\"${size*0.5}\" y2=\"${size*0.3}\" stroke=\"#22222a\" stroke-width=\"1.5\"/>\n          <line x1=\"${size*0.5}\" y1=\"${size*0.7}\" x2=\"${size*0.5}\" y2=\"${size}\" stroke=\"#22222a\" stroke-width=\"1.5\"/>\n          <line x1=\"0\" y1=\"${size*0.75}\" x2=\"${size}\" y2=\"${size*0.75}\" stroke=\"#DE2626\" stroke-width=\"1\" class=\"anim-pulse\"/>\n          <circle cx=\"${size*0.5}\" cy=\"${size*0.5}\" r=\"${size*0.08}\" fill=\"#0a0a0f\" stroke=\"#33333f\" stroke-width=\"1\"/>\n          <circle cx=\"${size*0.5}\" cy=\"${size*0.5}\" r=\"${size*0.04}\" fill=\"#DE2626\" class=\"anim-pulse\"/>\n        </pattern>\n      `,\n      hex: (size) => `\n        <pattern id=\"studio-pattern\" width=\"${size}\" height=\"${size*0.866}\" patternUnits=\"userSpaceOnUse\" class=\"anim-drift\">\n          <rect width=\"${size}\" height=\"${size*0.866}\" fill=\"#020204\"/>\n          <polygon points=\"${size*0.5},0 ${size},${size*0.288} ${size},${size*0.577} ${size*0.5},${size*0.866} 0,${size*0.577} 0,${size*0.288}\" fill=\"none\" stroke=\"#161622\" stroke-width=\"1\"/>\n          <circle cx=\"${size*0.5}\" cy=\"${size*0.433}\" r=\"2\" fill=\"#DE2626\" class=\"anim-pulse\"/>\n        </pattern>\n      `,\n      dots: (size) => `\n        <pattern id=\"studio-pattern\" width=\"${size*0.25}\" height=\"${size*0.25}\" patternUnits=\"userSpaceOnUse\" class=\"anim-drift\">\n          <rect width=\"${size*0.25}\" height=\"${size*0.25}\" fill=\"#000000\"/>\n          <circle cx=\"${size*0.125}\" cy=\"${size*0.125}\" r=\"1.5\" fill=\"#33333f\"/>\n          <circle cx=\"${size*0.125}\" cy=\"${size*0.125}\" r=\"0.8\" fill=\"#DE2626\" class=\"anim-pulse\"/>\n        </pattern>\n      `\n    };\n\n    let activePatternKey = 'cube';\n    let currentTileSize = 64;\n    let isTileOnlyMode = false;\n\n    function applyPattern() {\n      document.documentElement.style.setProperty('--tile-size', `${currentTileSize}px`);\n      const generator = PATTERN_REGISTRY[activePatternKey] || PATTERN_REGISTRY.cube;\n      document.getElementById('svg-defs').innerHTML = generator(currentTileSize);\n\n      // Also render isolated tile unit SVG\n      const tileSvg = document.getElementById('tile-svg');\n      tileSvg.setAttribute('width', currentTileSize);\n      tileSvg.setAttribute('height', currentTileSize);\n      tileSvg.setAttribute('viewBox', `0 0 ${currentTileSize} ${currentTileSize}`);\n      tileSvg.innerHTML = generator(currentTileSize).replace(/id=\"studio-pattern\"[^>]*>/, '').replace('</pattern>', '');\n    }\n\n    function setPattern(key) {\n      activePatternKey = key;\n      document.querySelectorAll('.bar-btn').forEach(btn => {\n        btn.classList.toggle('active', btn.textContent.toLowerCase().includes(key));\n      });\n      applyPattern();\n    }\n\n    function toggleMode() {\n      isTileOnlyMode = !isTileOnlyMode;\n      document.body.classList.toggle('mode-tile', isTileOnlyMode);\n    }\n\n    // Playwright hooks\n    window.pauseAnimation = function() {\n      document.querySelectorAll('*').forEach(el => {\n        el.style.animationPlayState = 'paused';\n      });\n    };\n\n    window.playAnimation = function() {\n      document.querySelectorAll('*').forEach(el => {\n        el.style.animationPlayState = 'running';\n      });\n    };\n\n    window.seekProgress = function(progress) {\n      const totalDurationSec = 6.0;\n      const targetTimeSec = progress * totalDurationSec;\n      document.querySelectorAll('*').forEach(el => {\n        el.style.animationDelay = `-${targetTimeSec}s`;\n        el.style.animationPlayState = 'paused';\n      });\n    };\n\n    // Parse URL parameters\n    window.addEventListener('DOMContentLoaded', () => {\n      const urlParams = new URLSearchParams(window.location.search);\n      if (urlParams.has('pattern')) {\n        activePatternKey = urlParams.get('pattern');\n      }\n      if (urlParams.has('tilesize')) {\n        currentTileSize = parseInt(urlParams.get('tilesize'), 10) || 64;\n      }\n      if (urlParams.has('mode') && urlParams.get('mode') === 'tile') {\n        isTileOnlyMode = true;\n        document.body.classList.add('mode-tile');\n      }\n      if (urlParams.has('ui') && urlParams.get('ui') === 'hide') {\n        document.getElementById('studio-bar').classList.add('hidden');\n      }\n      if (urlParams.has('canvas')) {\n        const [w, h] = urlParams.get('canvas').split('x').map(n => parseInt(n, 10));\n        if (w && h) {\n          const stage = document.getElementById('capture-stage');\n          stage.style.width = `${w}px`;\n          stage.style.height = `${h}px`;\n        }\n      }\n\n      applyPattern();\n\n      setTimeout(() => {\n        window.isReadyToCapture = true;\n      }, 300);\n    });\n  </script>\n</body>\n</html>\n",
      "34588a9c7be6bf9f1c9d92b054edde74d95baf164eb7eb5aa9a8774040fbe7d7"
    ],
    [
      "047af442-389e-402a-9ff2-21a1a4186841",
      "legacy_template_universal_stage",
      "template_universal_stage.html",
      "legacy_exemplar",
      800,
      800,
      "800:800",
      "#capture-stage",
      "Exemplar template template_universal_stage.html from /storage/emulated/0/Admin/Dev/Templates/Canvas_SVG_Capture_Templates",
      "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"UTF-8\">\n  <title>Canvas Stage \u2014 Universal Dynamic Size Switcher</title>\n  <style>\n    * {\n      box-sizing: border-box;\n      margin: 0;\n      padding: 0;\n    }\n    body {\n      background: #000000;\n      width: 100vw;\n      height: 100vh;\n      display: flex;\n      align-items: center;\n      justify-content: center;\n      overflow: hidden;\n      font-family: -apple-system, BlinkMacSystemFont, \"Segoe UI\", Roboto, monospace;\n    }\n    body.theme-light {\n      background: #FFFFFF;\n    }\n    body.theme-transparent {\n      background: transparent !important;\n    }\n    #capture-stage {\n      position: relative;\n      background: #000000;\n      overflow: hidden;\n      display: flex;\n      align-items: center;\n      justify-content: center;\n      border: 1px solid #1c1c24;\n    }\n    body.theme-light #capture-stage {\n      background: #FFFFFF;\n      border-color: #E2E2E8;\n    }\n    body.theme-transparent #capture-stage {\n      background: transparent !important;\n      border-color: transparent !important;\n    }\n    .svg-container {\n      width: 100%;\n      height: 100%;\n      display: flex;\n      align-items: center;\n      justify-content: center;\n    }\n    svg, img {\n      width: 100%;\n      height: 100%;\n      display: block;\n      object-fit: contain;\n    }\n    /* Fallback default sample SVG animation */\n    @keyframes spinWheel {\n      0% { transform: rotate(0deg); }\n      100% { transform: rotate(360deg); }\n    }\n    .default-wheel {\n      transform-origin: center;\n      animation: spinWheel 6s linear infinite;\n    }\n  </style>\n</head>\n<body>\n  <div id=\"capture-stage\">\n    <div class=\"svg-container\" id=\"svg-slot\">\n      <!-- Default Fallback Geometric SVG -->\n      <svg viewBox=\"0 0 400 400\" xmlns=\"http://www.w3.org/2000/svg\">\n        <circle cx=\"200\" cy=\"200\" r=\"140\" fill=\"none\" stroke=\"#22222a\" stroke-width=\"2\" />\n        <g class=\"default-wheel\">\n          <circle cx=\"200\" cy=\"200\" r=\"100\" fill=\"none\" stroke=\"#DE2626\" stroke-width=\"3\" stroke-dasharray=\"16,8\" />\n          <polygon points=\"200,80 230,130 170,130\" fill=\"#DE2626\" />\n        </g>\n        <circle cx=\"200\" cy=\"200\" r=\"30\" fill=\"#181820\" stroke=\"#333340\" stroke-width=\"2\" />\n        <circle cx=\"200\" cy=\"200\" r=\"10\" fill=\"#FFFFFF\" />\n        <text x=\"200\" y=\"360\" fill=\"#888899\" font-size=\"12\" font-family=\"monospace\" letter-spacing=\"2\" text-anchor=\"middle\">UNIVERSAL_STAGE</text>\n      </svg>\n    </div>\n  </div>\n\n  <script>\n    window.isReadyToCapture = false;\n\n    // Parse URL parameters\n    const queryParams = new URLSearchParams(window.location.search);\n    const sizeParam = queryParams.get('size') || '800x800';\n    const bgParam = queryParams.get('bg') || 'dark';\n    const svgParam = queryParams.get('svg');\n\n    // Apply dimensions\n    const [targetWidth, targetHeight] = sizeParam.toLowerCase().split('x').map(val => parseInt(val, 10));\n    const stageElement = document.getElementById('capture-stage');\n\n    if (!isNaN(targetWidth) && !isNaN(targetHeight)) {\n      stageElement.style.width = `${targetWidth}px`;\n      stageElement.style.height = `${targetHeight}px`;\n      stageElement.setAttribute('data-width', targetWidth);\n      stageElement.setAttribute('data-height', targetHeight);\n    } else {\n      stageElement.style.width = '800px';\n      stageElement.style.height = '800px';\n    }\n\n    // Apply theme\n    if (bgParam === 'light') {\n      document.body.classList.add('theme-light');\n    } else if (bgParam === 'transparent') {\n      document.body.classList.add('theme-transparent');\n    }\n\n    // Load external SVG if specified\n    if (svgParam) {\n      fetch(svgParam)\n        .then(res => res.text())\n        .then(svgText => {\n          document.getElementById('svg-slot').innerHTML = svgText;\n          window.isReadyToCapture = true;\n        })\n        .catch(err => {\n          console.error(\"Failed to load custom SVG:\", err);\n          window.isReadyToCapture = true;\n        });\n    } else {\n      window.isReadyToCapture = true;\n    }\n\n    // Playwright animation hooks\n    window.pauseAnimation = function() {\n      document.querySelectorAll('*').forEach(el => {\n        el.style.animationPlayState = 'paused';\n      });\n    };\n\n    window.playAnimation = function() {\n      document.querySelectorAll('*').forEach(el => {\n        el.style.animationPlayState = 'running';\n      });\n    };\n\n    window.seekProgress = function(progress, durationSeconds = 6.0) {\n      const targetTimeSec = progress * durationSeconds;\n      document.querySelectorAll('*').forEach(el => {\n        el.style.animationDelay = `-${targetTimeSec}s`;\n        el.style.animationPlayState = 'paused';\n      });\n    };\n  </script>\n</body>\n</html>\n",
      "151ed4193b7902eaaef5276fedb42dd86886ffdbfecdd069cbca977c6902000c"
    ],
    [
      "3cf427f2-0564-44c1-a821-c63003e6710f",
      "legacy_template_widescreen_1280x720",
      "template_widescreen_1280x720.html",
      "legacy_exemplar",
      1280,
      720,
      "1280:720",
      "#capture-stage",
      "Exemplar template template_widescreen_1280x720.html from /storage/emulated/0/Admin/Dev/Templates/Canvas_SVG_Capture_Templates",
      "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"UTF-8\">\n  <title>Canvas Stage \u2014 Widescreen 1280x720 (16:9)</title>\n  <style>\n    * {\n      box-sizing: border-box;\n      margin: 0;\n      padding: 0;\n    }\n    body {\n      background: #000000;\n      color: #FFFFFF;\n      width: 100vw;\n      height: 100vh;\n      display: flex;\n      align-items: center;\n      justify-content: center;\n      overflow: hidden;\n      font-family: -apple-system, BlinkMacSystemFont, \"Segoe UI\", Roboto, monospace;\n    }\n    #capture-stage {\n      position: relative;\n      width: 1280px;\n      height: 720px;\n      background: #08080a;\n      border: 1px solid #1f1f26;\n      overflow: hidden;\n      display: flex;\n      align-items: center;\n      justify-content: center;\n    }\n    .svg-container {\n      width: 100%;\n      height: 100%;\n    }\n    svg {\n      width: 100%;\n      height: 100%;\n      display: block;\n    }\n    @keyframes cycleNodes {\n      0%, 100% {\n        stroke: #333340;\n      }\n      50% {\n        stroke: #DE2626;\n      }\n    }\n    @keyframes glowPulse {\n      0%, 100% {\n        opacity: 0.6;\n        transform: scale(1);\n      }\n      50% {\n        opacity: 1;\n        transform: scale(1.05);\n      }\n    }\n    .anim-cycle {\n      animation: cycleNodes 3s ease-in-out infinite;\n    }\n    .anim-pulse-glow {\n      transform-origin: 640px 360px;\n      animation: glowPulse 4s ease-in-out infinite;\n    }\n  </style>\n</head>\n<body>\n  <div id=\"capture-stage\" data-width=\"1280\" data-height=\"720\" data-ratio=\"16:9\">\n    <div class=\"svg-container\">\n      <svg id=\"svg-root\" viewBox=\"0 0 1280 720\" xmlns=\"http://www.w3.org/2000/svg\">\n        <defs>\n          <radialGradient id=\"hdCenterGlow\" cx=\"50%\" cy=\"50%\" r=\"55%\">\n            <stop offset=\"0%\" stop-color=\"#140a0a\" stop-opacity=\"0.9\" />\n            <stop offset=\"60%\" stop-color=\"#08080c\" stop-opacity=\"0.5\" />\n            <stop offset=\"100%\" stop-color=\"#000000\" stop-opacity=\"0\" />\n          </radialGradient>\n        </defs>\n\n        <!-- Ambient Backdrop -->\n        <rect width=\"1280\" height=\"720\" fill=\"url(#hdCenterGlow)\" />\n\n        <!-- 8-Lane X-Axis Production Grid -->\n        <g opacity=\"0.06\" stroke=\"#FFFFFF\" stroke-width=\"1\">\n          <line x1=\"160\" y1=\"0\" x2=\"160\" y2=\"720\" />\n          <line x1=\"320\" y1=\"0\" x2=\"320\" y2=\"720\" />\n          <line x1=\"480\" y1=\"0\" x2=\"480\" y2=\"720\" />\n          <line x1=\"640\" y1=\"0\" x2=\"640\" y2=\"720\" />\n          <line x1=\"800\" y1=\"0\" x2=\"800\" y2=\"720\" />\n          <line x1=\"960\" y1=\"0\" x2=\"960\" y2=\"720\" />\n          <line x1=\"1120\" y1=\"0\" x2=\"1120\" y2=\"720\" />\n        </g>\n\n        <!-- Header HUD -->\n        <text x=\"48\" y=\"64\" fill=\"#888899\" font-size=\"14\" font-family=\"monospace\" letter-spacing=\"2\">STAGE_DIM: 1280x720</text>\n        <text x=\"48\" y=\"88\" fill=\"#DE2626\" font-size=\"12\" font-family=\"monospace\">RATIO: 16:9 WIDESCREEN HD</text>\n        <text x=\"1232\" y=\"64\" fill=\"#555566\" font-size=\"12\" font-family=\"monospace\" text-anchor=\"end\">ASPECT_QUANTIZED: Ry=32px</text>\n\n        <!-- 6-Tier Architecture Visual Matrix (L1 to L6) -->\n        <g transform=\"translate(140, 140)\">\n          <!-- Tier Track Lines -->\n          <line x1=\"0\" y1=\"60\" x2=\"1000\" y2=\"60\" stroke=\"#22222a\" stroke-width=\"2\" />\n          <line x1=\"0\" y1=\"180\" x2=\"1000\" y2=\"180\" stroke=\"#22222a\" stroke-width=\"2\" />\n          <line x1=\"0\" y1=\"300\" x2=\"1000\" y2=\"300\" stroke=\"#22222a\" stroke-width=\"2\" />\n\n          <!-- Connecting Vertical Buses -->\n          <line x1=\"180\" y1=\"60\" x2=\"180\" y2=\"300\" stroke=\"#1d1d24\" stroke-width=\"2\" />\n          <line x1=\"500\" y1=\"60\" x2=\"500\" y2=\"300\" stroke=\"#1d1d24\" stroke-width=\"2\" />\n          <line x1=\"820\" y1=\"60\" x2=\"820\" y2=\"300\" stroke=\"#1d1d24\" stroke-width=\"2\" />\n\n          <!-- Node L6 Root Composition -->\n          <g transform=\"translate(500, 60)\" class=\"anim-cycle\">\n            <rect x=\"-80\" y=\"-24\" width=\"160\" height=\"48\" rx=\"6\" fill=\"#141418\" stroke=\"#383848\" stroke-width=\"2\" />\n            <circle cx=\"-60\" cy=\"0\" r=\"5\" fill=\"#DE2626\" />\n            <text x=\"-40\" y=\"5\" fill=\"#FFFFFF\" font-size=\"12\" font-family=\"monospace\" font-weight=\"700\">L6_COMPOSITION</text>\n          </g>\n\n          <!-- Node L5 Use Cases -->\n          <g transform=\"translate(180, 180)\">\n            <rect x=\"-80\" y=\"-24\" width=\"160\" height=\"48\" rx=\"6\" fill=\"#141418\" stroke=\"#2c2c36\" stroke-width=\"1.5\" />\n            <text x=\"0\" y=\"5\" fill=\"#AAAAAA\" font-size=\"11\" font-family=\"monospace\" text-anchor=\"middle\">L5_USE_CASES</text>\n          </g>\n\n          <!-- Node L4 Presentation -->\n          <g transform=\"translate(820, 180)\">\n            <rect x=\"-80\" y=\"-24\" width=\"160\" height=\"48\" rx=\"6\" fill=\"#141418\" stroke=\"#2c2c36\" stroke-width=\"1.5\" />\n            <text x=\"0\" y=\"5\" fill=\"#AAAAAA\" font-size=\"11\" font-family=\"monospace\" text-anchor=\"middle\">L4_PRESENTATION</text>\n          </g>\n\n          <!-- Node L1 Substrate & Core Entities -->\n          <g transform=\"translate(500, 300)\" class=\"anim-pulse-glow\">\n            <rect x=\"-100\" y=\"-28\" width=\"200\" height=\"56\" rx=\"8\" fill=\"#181820\" stroke=\"#DE2626\" stroke-width=\"2\" />\n            <polygon points=\"-75,-8 -65,0 -75,8\" fill=\"#DE2626\" />\n            <text x=\"-50\" y=\"6\" fill=\"#FFFFFF\" font-size=\"13\" font-family=\"monospace\" font-weight=\"700\">L1_SUBSTRATE</text>\n          </g>\n        </g>\n\n        <!-- Footer Metric Bar -->\n        <rect x=\"48\" y=\"656\" width=\"1184\" height=\"2\" fill=\"#1c1c24\" />\n        <text x=\"640\" y=\"684\" fill=\"#666677\" font-size=\"12\" font-family=\"sans-serif\" letter-spacing=\"3\" text-anchor=\"middle\">AUTONOMOUS MULTI-TIER EXECUTION PIPELINE</text>\n      </svg>\n    </div>\n  </div>\n\n  <script>\n    window.isReadyToCapture = false;\n\n    window.pauseAnimation = function() {\n      document.querySelectorAll('*').forEach(el => {\n        el.style.animationPlayState = 'paused';\n      });\n    };\n\n    window.playAnimation = function() {\n      document.querySelectorAll('*').forEach(el => {\n        el.style.animationPlayState = 'running';\n      });\n    };\n\n    window.seekProgress = function(progress) {\n      const totalDurationSec = 4.0;\n      const targetTimeSec = progress * totalDurationSec;\n      document.querySelectorAll('*').forEach(el => {\n        el.style.animationDelay = `-${targetTimeSec}s`;\n        el.style.animationPlayState = 'paused';\n      });\n    };\n\n    window.addEventListener('DOMContentLoaded', () => {\n      setTimeout(() => {\n        window.isReadyToCapture = true;\n      }, 300);\n    });\n  </script>\n</body>\n</html>\n",
      "aeaaf939509e763b1db64547b8c099a2ac2711f36391693dc1753f507d4249eb"
    ]
