      "32:32",
      "#capture-stage",
      "Exemplar template template_icon_32x32.html from /storage/emulated/0/Admin/Dev/Templates/Canvas_SVG_Capture_Templates",
      "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"UTF-8\">\n  <title>Canvas Icon \u2014 32x32 Favicon</title>\n  <style>\n    * {\n      box-sizing: border-box;\n      margin: 0;\n      padding: 0;\n    }\n    body {\n      background: #000000;\n      color: #FFFFFF;\n      width: 100vw;\n      height: 100vh;\n      display: flex;\n      align-items: center;\n      justify-content: center;\n      overflow: hidden;\n    }\n    #capture-stage {\n      position: relative;\n      width: 32px;\n      height: 32px;\n      background: #000000;\n      overflow: hidden;\n      display: flex;\n      align-items: center;\n      justify-content: center;\n    }\n    .svg-container {\n      width: 100%;\n      height: 100%;\n      display: flex;\n      align-items: center;\n      justify-content: center;\n    }\n    svg {\n      width: 100%;\n      height: 100%;\n      display: block;\n    }\n    @keyframes pulseGlow {\n      0%, 100% { fill: #DE2626; }\n      50% { fill: #FFFFFF; }\n    }\n    .anim-dot {\n      animation: pulseGlow 1.8s ease-in-out infinite;\n    }\n  </style>\n</head>\n<body>\n  <div id=\"capture-stage\">\n    <div class=\"svg-container\">\n      <svg viewBox=\"0 0 32 32\" xmlns=\"http://www.w3.org/2000/svg\">\n        <!-- Rounded Micro Background -->\n        <rect x=\"1\" y=\"1\" width=\"30\" height=\"30\" rx=\"7\" fill=\"#0d0d12\" stroke=\"#252533\" stroke-width=\"1\"/>\n\n        <!-- Crisp Micro 104 Isometric Cube Glyph -->\n        <!-- Top -->\n        <polygon points=\"16,6 24,11 16,16 8,11\" fill=\"#FFFFFF\" stroke=\"#DE2626\" stroke-width=\"0.8\"/>\n        <!-- Left -->\n        <polygon points=\"16,16 8,11 8,20 16,25\" fill=\"#252530\" stroke=\"#353545\" stroke-width=\"0.8\"/>\n        <!-- Right -->\n        <polygon points=\"16,16 24,11 24,20 16,25\" fill=\"#14141c\" stroke=\"#353545\" stroke-width=\"0.8\"/>\n        <!-- Spine -->\n        <line x1=\"16\" y1=\"16\" x2=\"16\" y2=\"25\" stroke=\"#DE2626\" stroke-width=\"1\"/>\n\n        <!-- Micro Center Dot -->\n        <circle cx=\"16\" cy=\"16\" r=\"1.5\" class=\"anim-dot\"/>\n      </svg>\n    </div>\n  </div>\n\n  <script>\n    window.isReadyToCapture = false;\n    window.pauseAnimation = function() {\n      document.querySelectorAll('*').forEach(el => el.style.animationPlayState = 'paused');\n    };\n    window.playAnimation = function() {\n      document.querySelectorAll('*').forEach(el => el.style.animationPlayState = 'running');\n    };\n    window.seekProgress = function(progress) {\n      const totalDurationSec = 1.8;\n      const targetTimeSec = progress * totalDurationSec;\n      document.querySelectorAll('*').forEach(el => {\n        el.style.animationDelay = `-${targetTimeSec}s`;\n        el.style.animationPlayState = 'paused';\n      });\n    };\n    window.addEventListener('DOMContentLoaded', () => {\n      setTimeout(() => { window.isReadyToCapture = true; }, 150);\n    });\n  </script>\n</body>\n</html>\n",
