      "512:512",
      "#capture-stage",
      "Exemplar template template_icon_512x512.html from /storage/emulated/0/Admin/Dev/Templates/Canvas_SVG_Capture_Templates",
      "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"UTF-8\">\n  <title>Canvas Icon \u2014 512x512 Master App Icon</title>\n  <style>\n    * {\n      box-sizing: border-box;\n      margin: 0;\n      padding: 0;\n    }\n    body {\n      background: #000000;\n      color: #FFFFFF;\n      width: 100vw;\n      height: 100vh;\n      display: flex;\n      align-items: center;\n      justify-content: center;\n      overflow: hidden;\n      font-family: -apple-system, BlinkMacSystemFont, \"Segoe UI\", Roboto, monospace;\n    }\n    #capture-stage {\n      position: relative;\n      width: 512px;\n      height: 512px;\n      background: #000000;\n      overflow: hidden;\n      display: flex;\n      align-items: center;\n      justify-content: center;\n    }\n    .svg-container {\n      width: 100%;\n      height: 100%;\n      display: flex;\n      align-items: center;\n      justify-content: center;\n    }\n    svg {\n      width: 100%;\n      height: 100%;\n      display: block;\n    }\n\n    @keyframes pulseRing {\n      0%, 100% {\n        transform: scale(1);\n        opacity: 0.85;\n      }\n      50% {\n        transform: scale(1.04);\n        opacity: 1;\n        filter: drop-shadow(0 0 16px rgba(222, 38, 38, 0.8));\n      }\n    }\n    @keyframes rotateReticle {\n      0% { transform: rotate(0deg); }\n      100% { transform: rotate(360deg); }\n    }\n    @keyframes floatCap {\n      0%, 100% { transform: translateY(0); }\n      50% { transform: translateY(-14px); }\n    }\n    @keyframes glowVertex {\n      0%, 100% { fill: #FFFFFF; filter: drop-shadow(0 0 4px #FFFFFF); }\n      50% { fill: #DE2626; filter: drop-shadow(0 0 12px #DE2626); }\n    }\n\n    .anim-pulse {\n      transform-origin: 256px 256px;\n      animation: pulseRing 4s ease-in-out infinite;\n    }\n    .anim-rotate {\n      transform-origin: 256px 256px;\n      animation: rotateReticle 12s linear infinite;\n    }\n    .anim-float {\n      animation: floatCap 4s ease-in-out infinite;\n    }\n    .anim-vertex {\n      animation: glowVertex 2.5s ease-in-out infinite;\n    }\n  </style>\n</head>\n<body>\n  <div id=\"capture-stage\">\n    <div class=\"svg-container\">\n      <svg viewBox=\"0 0 512 512\" xmlns=\"http://www.w3.org/2000/svg\">\n        <defs>\n          <linearGradient id=\"bgGrad\" x1=\"0\" y1=\"0\" x2=\"1\" y2=\"1\">\n            <stop offset=\"0%\" stop-color=\"#0a0a0f\"/>\n            <stop offset=\"100%\" stop-color=\"#000000\"/>\n          </linearGradient>\n          <linearGradient id=\"cubeTop\" x1=\"0\" y1=\"0\" x2=\"1\" y2=\"1\">\n            <stop offset=\"0%\" stop-color=\"#FFFFFF\"/>\n            <stop offset=\"100%\" stop-color=\"#CCCCCC\"/>\n          </linearGradient>\n          <linearGradient id=\"cubeLeft\" x1=\"0\" y1=\"0\" x2=\"0\" y2=\"1\">\n            <stop offset=\"0%\" stop-color=\"#2a2a35\"/>\n            <stop offset=\"100%\" stop-color=\"#14141a\"/>\n          </linearGradient>\n          <linearGradient id=\"cubeRight\" x1=\"0\" y1=\"0\" x2=\"0\" y2=\"1\">\n            <stop offset=\"0%\" stop-color=\"#1e1e26\"/>\n            <stop offset=\"100%\" stop-color=\"#0d0d12\"/>\n          </linearGradient>\n        </defs>\n\n        <!-- Outer Squircle Container -->\n        <rect x=\"24\" y=\"24\" width=\"464\" height=\"464\" rx=\"108\" fill=\"url(#bgGrad)\" stroke=\"#1f1f28\" stroke-width=\"3\"/>\n        <rect x=\"32\" y=\"32\" width=\"448\" height=\"448\" rx=\"100\" fill=\"none\" stroke=\"#DE2626\" stroke-width=\"1.5\" stroke-dasharray=\"8 6\" opacity=\"0.6\"/>\n\n        <!-- Orbiting Reticle -->\n        <g class=\"anim-rotate\">\n          <circle cx=\"256\" cy=\"256\" r=\"180\" fill=\"none\" stroke=\"#22222e\" stroke-width=\"1.5\"/>\n          <circle cx=\"256\" cy=\"256\" r=\"180\" fill=\"none\" stroke=\"#DE2626\" stroke-width=\"2.5\" stroke-dasharray=\"30 110\" stroke-linecap=\"round\"/>\n          <circle cx=\"436\" cy=\"256\" r=\"5\" fill=\"#DE2626\"/>\n          <circle cx=\"76\" cy=\"256\" r=\"5\" fill=\"#DE2626\"/>\n        </g>\n\n        <!-- Inner Target Ring -->\n        <circle cx=\"256\" cy=\"256\" r=\"144\" fill=\"none\" stroke=\"#1c1c24\" stroke-width=\"1.5\"/>\n        <circle cx=\"256\" cy=\"256\" r=\"144\" fill=\"none\" stroke=\"#FFFFFF\" stroke-width=\"1.5\" stroke-dasharray=\"4 8\" opacity=\"0.3\"/>\n\n        <!-- 104a Isometric Floating Cube Core -->\n        <g class=\"anim-pulse\">\n          <!-- Base Cube Body -->\n          <!-- Left Face -->\n          <polygon points=\"256,236 176,282 176,374 256,328\" fill=\"url(#cubeLeft)\" stroke=\"#3a3a48\" stroke-width=\"2\"/>\n          <!-- Right Face -->\n          <polygon points=\"256,236 336,282 336,374 256,328\" fill=\"url(#cubeRight)\" stroke=\"#3a3a48\" stroke-width=\"2\"/>\n          <!-- Center Seam Accent -->\n          <line x1=\"256\" y1=\"236\" x2=\"256\" y2=\"328\" stroke=\"#DE2626\" stroke-width=\"2.5\"/>\n\n          <!-- 104a Floating Top Cap -->\n          <g class=\"anim-float\">\n            <polygon points=\"256,180 336,226 256,272 176,226\" fill=\"url(#cubeTop)\" stroke=\"#DE2626\" stroke-width=\"2\"/>\n            <line x1=\"256\" y1=\"180\" x2=\"256\" y2=\"272\" stroke=\"#DE2626\" stroke-width=\"1.5\" opacity=\"0.7\"/>\n            <line x1=\"176\" y1=\"226\" x2=\"336\" y2=\"226\" stroke=\"#DE2626\" stroke-width=\"1.5\" opacity=\"0.7\"/>\n          </g>\n\n          <!-- Glowing Vertex Nodes -->\n          <circle cx=\"256\" cy=\"236\" r=\"4.5\" class=\"anim-vertex\"/>\n          <circle cx=\"176\" cy=\"282\" r=\"3.5\" fill=\"#FFFFFF\"/>\n          <circle cx=\"336\" cy=\"282\" r=\"3.5\" fill=\"#FFFFFF\"/>\n          <circle cx=\"256\" cy=\"328\" r=\"4.5\" fill=\"#DE2626\"/>\n        </g>\n\n        <!-- Corner Micro-Crosshairs -->\n        <path d=\"M 64 64 L 76 64 M 64 64 L 64 76\" stroke=\"#DE2626\" stroke-width=\"2\" fill=\"none\"/>\n        <path d=\"M 448 64 L 436 64 M 448 64 L 448 76\" stroke=\"#DE2626\" stroke-width=\"2\" fill=\"none\"/>\n        <path d=\"M 64 448 L 76 448 M 64 448 L 64 436\" stroke=\"#DE2626\" stroke-width=\"2\" fill=\"none\"/>\n        <path d=\"M 448 448 L 436 448 M 448 448 L 448 436\" stroke=\"#DE2626\" stroke-width=\"2\" fill=\"none\"/>\n\n        <!-- Micro Telemetry -->\n        <text x=\"256\" y=\"442\" fill=\"#555566\" font-size=\"11\" font-family=\"monospace\" letter-spacing=\"3\" text-anchor=\"middle\">512px ICON STAGE</text>\n      </svg>\n    </div>\n  </div>\n\n  <script>\n    window.isReadyToCapture = false;\n    window.pauseAnimation = function() {\n      document.querySelectorAll('*').forEach(el => el.style.animationPlayState = 'paused');\n    };\n    window.playAnimation = function() {\n      document.querySelectorAll('*').forEach(el => el.style.animationPlayState = 'running');\n    };\n    window.seekProgress = function(progress) {\n      const totalDurationSec = 4.0;\n      const targetTimeSec = progress * totalDurationSec;\n      document.querySelectorAll('*').forEach(el => {\n        el.style.animationDelay = `-${targetTimeSec}s`;\n        el.style.animationPlayState = 'paused';\n      });\n    };\n    window.addEventListener('DOMContentLoaded', () => {\n      setTimeout(() => { window.isReadyToCapture = true; }, 300);\n    });\n  </script>\n</body>\n</html>\n",
