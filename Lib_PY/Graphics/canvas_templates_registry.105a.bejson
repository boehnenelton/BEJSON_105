      "800:800",
      "#capture-stage",
      "Exemplar template template_icon_bejson_104a_floating.html from /storage/emulated/0/Admin/Dev/Templates/Canvas_SVG_Capture_Templates",
      "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"UTF-8\">\n  <title>BEJSON 104a Icon \u2014 Floating Top Cube</title>\n  <style>\n    * { box-sizing: border-box; margin: 0; padding: 0; }\n    body {\n      background: #000000;\n      color: #FFFFFF;\n      width: 100vw;\n      height: 100vh;\n      display: flex;\n      align-items: center;\n      justify-content: center;\n      overflow: hidden;\n      font-family: monospace;\n    }\n    #capture-stage {\n      position: relative;\n      width: 512px;\n      height: 512px;\n      background: #000000;\n      overflow: hidden;\n      display: flex;\n      align-items: center;\n      justify-content: center;\n    }\n    .svg-container { width: 100%; height: 100%; display: flex; align-items: center; justify-content: center; }\n    svg { width: 100%; height: 100%; display: block; }\n\n    @keyframes floatCap {\n      0%, 100% {\n        transform: translateY(0);\n        filter: drop-shadow(0 0 10px rgba(222, 38, 38, 0.6));\n      }\n      50% {\n        transform: translateY(-22px);\n        filter: drop-shadow(0 0 28px rgba(222, 38, 38, 1));\n      }\n    }\n    @keyframes pulsePlasma {\n      0%, 100% { opacity: 0.3; stroke-width: 1.5; }\n      50% { opacity: 1; stroke-width: 3.5; stroke: #FFFFFF; }\n    }\n    @keyframes rotateGears {\n      0% { transform: rotate(0deg); }\n      100% { transform: rotate(360deg); }\n    }\n\n    .anim-float { animation: floatCap 3.5s ease-in-out infinite; }\n    .anim-plasma { animation: pulsePlasma 1.8s ease-in-out infinite; }\n    .anim-gear { transform-origin: 256px 256px; animation: rotateGears 14s linear infinite; }\n  </style>\n</head>\n<body>\n  <div id=\"capture-stage\">\n    <div class=\"svg-container\">\n      <svg viewBox=\"0 0 512 512\" xmlns=\"http://www.w3.org/2000/svg\">\n        <defs>\n          <linearGradient id=\"bgGrad104a\" x1=\"0\" y1=\"0\" x2=\"1\" y2=\"1\">\n            <stop offset=\"0%\" stop-color=\"#0e0a0a\"/>\n            <stop offset=\"100%\" stop-color=\"#020202\"/>\n          </linearGradient>\n          <linearGradient id=\"floatingTop\" x1=\"0\" y1=\"0\" x2=\"1\" y2=\"1\">\n            <stop offset=\"0%\" stop-color=\"#FFFFFF\"/>\n            <stop offset=\"100%\" stop-color=\"#E0E0E0\"/>\n          </linearGradient>\n          <linearGradient id=\"baseLeft\" x1=\"0\" y1=\"0\" x2=\"0\" y2=\"1\">\n            <stop offset=\"0%\" stop-color=\"#2a2224\"/>\n            <stop offset=\"100%\" stop-color=\"#120e10\"/>\n          </linearGradient>\n          <linearGradient id=\"baseRight\" x1=\"0\" y1=\"0\" x2=\"0\" y2=\"1\">\n            <stop offset=\"0%\" stop-color=\"#1c1618\"/>\n            <stop offset=\"100%\" stop-color=\"#0c090a\"/>\n          </linearGradient>\n        </defs>\n\n        <!-- Outer Squircle Container -->\n        <rect x=\"24\" y=\"24\" width=\"464\" height=\"464\" rx=\"108\" fill=\"url(#bgGrad104a)\" stroke=\"#2e1a1c\" stroke-width=\"3\"/>\n        <rect x=\"32\" y=\"32\" width=\"448\" height=\"448\" rx=\"100\" fill=\"none\" stroke=\"#DE2626\" stroke-width=\"1.5\" stroke-dasharray=\"12 6\" opacity=\"0.7\"/>\n\n        <!-- Orbiting Telemetry Rings -->\n        <g class=\"anim-gear\">\n          <circle cx=\"256\" cy=\"256\" r=\"176\" fill=\"none\" stroke=\"#221416\" stroke-width=\"2\"/>\n          <circle cx=\"256\" cy=\"256\" r=\"176\" fill=\"none\" stroke=\"#DE2626\" stroke-width=\"3\" stroke-dasharray=\"24 64\" stroke-linecap=\"round\"/>\n          <circle cx=\"432\" cy=\"256\" r=\"6\" fill=\"#DE2626\"/>\n          <circle cx=\"80\" cy=\"256\" r=\"6\" fill=\"#DE2626\"/>\n        </g>\n\n        <!-- Base Cube Body -->\n        <g>\n          <!-- Left Face -->\n          <polygon points=\"256,252 166,304 166,408 256,460\" fill=\"url(#baseLeft)\" stroke=\"#3e2428\" stroke-width=\"2\"/>\n          <!-- Right Face -->\n          <polygon points=\"256,252 346,304 346,408 256,460\" fill=\"url(#baseRight)\" stroke=\"#3e2428\" stroke-width=\"2\"/>\n          <!-- Base Spine -->\n          <line x1=\"256\" y1=\"252\" x2=\"256\" y2=\"460\" stroke=\"#DE2626\" stroke-width=\"3\"/>\n\n          <!-- Plasma Beams Connecting Base to Floating Top -->\n          <line x1=\"256\" y1=\"252\" x2=\"256\" y2=\"195\" stroke=\"#DE2626\" class=\"anim-plasma\"/>\n          <line x1=\"166\" y1=\"304\" x2=\"166\" y2=\"245\" stroke=\"#DE2626\" class=\"anim-plasma\"/>\n          <line x1=\"346\" y1=\"304\" x2=\"346\" y2=\"245\" stroke=\"#DE2626\" class=\"anim-plasma\"/>\n\n          <!-- Floating Top Cap with Independent Levitation -->\n          <g class=\"anim-float\">\n            <!-- Levitating Diamond Top -->\n            <polygon points=\"256,120 346,172 256,224 166,172\" fill=\"url(#floatingTop)\" stroke=\"#DE2626\" stroke-width=\"3\"/>\n            <!-- Inner Facet Traces -->\n            <line x1=\"256\" y1=\"120\" x2=\"256\" y2=\"224\" stroke=\"#DE2626\" stroke-width=\"2\"/>\n            <line x1=\"166\" y1=\"172\" x2=\"346\" y2=\"172\" stroke=\"#DE2626\" stroke-width=\"2\"/>\n\n            <!-- Floating Cap Vertices -->\n            <circle cx=\"256\" cy=\"120\" r=\"5\" fill=\"#DE2626\"/>\n            <circle cx=\"346\" cy=\"172\" r=\"5\" fill=\"#FFFFFF\"/>\n            <circle cx=\"166\" cy=\"172\" r=\"5\" fill=\"#FFFFFF\"/>\n            <circle cx=\"256\" cy=\"224\" r=\"6\" fill=\"#DE2626\" filter=\"drop-shadow(0 0 6px #DE2626)\"/>\n          </g>\n        </g>\n\n        <!-- Monogram & Label -->\n        <text x=\"256\" y=\"80\" fill=\"#DE2626\" font-size=\"16\" font-family=\"monospace\" font-weight=\"700\" letter-spacing=\"4\" text-anchor=\"middle\">BEJSON 104a</text>\n        <text x=\"256\" y=\"98\" fill=\"#776666\" font-size=\"10\" font-family=\"monospace\" letter-spacing=\"2\" text-anchor=\"middle\">FLOATING CAP CUBE</text>\n      </svg>\n    </div>\n  </div>\n\n  <script>\n    window.isReadyToCapture = false;\n    window.pauseAnimation = function() { document.querySelectorAll('*').forEach(el => el.style.animationPlayState = 'paused'); };\n    window.playAnimation = function() { document.querySelectorAll('*').forEach(el => el.style.animationPlayState = 'running'); };\n    window.seekProgress = function(progress) {\n      const dur = 3.5;\n      const t = progress * dur;\n      document.querySelectorAll('*').forEach(el => {\n        el.style.animationDelay = `-${t}s`;\n        el.style.animationPlayState = 'paused';\n      });\n    };\n    window.addEventListener('DOMContentLoaded', () => { setTimeout(() => { window.isReadyToCapture = true; }, 300); });\n  </script>\n</body>\n</html>\n",
