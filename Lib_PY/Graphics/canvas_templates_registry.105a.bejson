      "9bd92de0-73fa-4eed-a117-2d4a21570d4d",
      "legacy_template_graphic_badge_400x200",
      "template_graphic_badge_400x200.html",
      "legacy_exemplar",
      400,
      200,
      "400:200",
      "#capture-stage",
      "Exemplar template template_graphic_badge_400x200.html from /storage/emulated/0/Admin/Dev/Templates/Canvas_SVG_Capture_Templates",
      "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"UTF-8\">\n  <title>Canvas Graphic \u2014 400x200 Component Badge</title>\n  <style>\n    * {\n      box-sizing: border-box;\n      margin: 0;\n      padding: 0;\n    }\n    body {\n      background: #000000;\n      color: #FFFFFF;\n      width: 100vw;\n      height: 100vh;\n      display: flex;\n      align-items: center;\n      justify-content: center;\n      overflow: hidden;\n      font-family: -apple-system, BlinkMacSystemFont, \"Segoe UI\", Roboto, monospace;\n    }\n    #capture-stage {\n      position: relative;\n      width: 400px;\n      height: 200px;\n      background: #000000;\n      overflow: hidden;\n      display: flex;\n      align-items: center;\n      justify-content: center;\n    }\n    .svg-container {\n      width: 100%;\n      height: 100%;\n      display: flex;\n      align-items: center;\n      justify-content: center;\n    }\n    svg {\n      width: 100%;\n      height: 100%;\n      display: block;\n    }\n\n    @keyframes scanLine {\n      0% { transform: translateY(0); opacity: 0; }\n      10% { opacity: 0.8; }\n      90% { opacity: 0.8; }\n      100% { transform: translateY(180px); opacity: 0; }\n    }\n    @keyframes pulseOrb {\n      0%, 100% { transform: scale(1); filter: drop-shadow(0 0 4px #DE2626); }\n      50% { transform: scale(1.08); filter: drop-shadow(0 0 12px #DE2626); }\n    }\n    @keyframes rotateRing {\n      0% { transform: rotate(0deg); }\n      100% { transform: rotate(360deg); }\n    }\n\n    .anim-scan {\n      animation: scanLine 3s linear infinite;\n    }\n    .anim-pulse {\n      transform-origin: 90px 100px;\n      animation: pulseOrb 3s ease-in-out infinite;\n    }\n    .anim-rotate {\n      transform-origin: 90px 100px;\n      animation: rotateRing 8s linear infinite;\n    }\n  </style>\n</head>\n<body>\n  <div id=\"capture-stage\">\n    <div class=\"svg-container\">\n      <svg viewBox=\"0 0 400 200\" xmlns=\"http://www.w3.org/2000/svg\">\n        <defs>\n          <linearGradient id=\"badgeGrad\" x1=\"0\" y1=\"0\" x2=\"1\" y2=\"1\">\n            <stop offset=\"0%\" stop-color=\"#0e0e14\"/>\n            <stop offset=\"100%\" stop-color=\"#040406\"/>\n          </linearGradient>\n          <linearGradient id=\"scanGrad\" x1=\"0\" y1=\"0\" x2=\"1\" y2=\"0\">\n            <stop offset=\"0%\" stop-color=\"#DE2626\" stop-opacity=\"0\"/>\n            <stop offset=\"50%\" stop-color=\"#DE2626\" stop-opacity=\"0.6\"/>\n            <stop offset=\"100%\" stop-color=\"#DE2626\" stop-opacity=\"0\"/>\n          </linearGradient>\n        </defs>\n\n        <!-- Chamfered Container Card -->\n        <polygon points=\"12,12 360,12 388,40 388,188 40,188 12,160\" fill=\"url(#badgeGrad)\" stroke=\"#22222e\" stroke-width=\"2\"/>\n        <polygon points=\"16,16 357,16 384,43 384,184 43,184 16,157\" fill=\"none\" stroke=\"#DE2626\" stroke-width=\"1.2\" stroke-dasharray=\"8 6\" opacity=\"0.5\"/>\n\n        <!-- Animated Scanline Sweep -->\n        <g class=\"anim-scan\">\n          <line x1=\"16\" y1=\"10\" x2=\"384\" y2=\"10\" stroke=\"url(#scanGrad)\" stroke-width=\"2\"/>\n        </g>\n\n        <!-- Left Visual: Isometric Cube + Reticle Orbit -->\n        <g class=\"anim-rotate\">\n          <circle cx=\"90\" cy=\"100\" r=\"50\" fill=\"none\" stroke=\"#1d1d28\" stroke-width=\"1.5\"/>\n          <circle cx=\"90\" cy=\"100\" r=\"50\" fill=\"none\" stroke=\"#DE2626\" stroke-width=\"2\" stroke-dasharray=\"24 70\" stroke-linecap=\"round\"/>\n          <circle cx=\"140\" cy=\"100\" r=\"3\" fill=\"#DE2626\"/>\n        </g>\n\n        <g class=\"anim-pulse\">\n          <!-- Cube Top -->\n          <polygon points=\"90,74 116,89 90,104 64,89\" fill=\"#FFFFFF\" stroke=\"#DE2626\" stroke-width=\"1.5\"/>\n          <!-- Cube Left -->\n          <polygon points=\"90,104 64,89 64,119 90,134\" fill=\"#242432\" stroke=\"#36364a\" stroke-width=\"1.5\"/>\n          <!-- Cube Right -->\n          <polygon points=\"90,104 116,89 116,119 90,134\" fill=\"#14141c\" stroke=\"#36364a\" stroke-width=\"1.5\"/>\n          <line x1=\"90\" y1=\"104\" x2=\"90\" y2=\"134\" stroke=\"#DE2626\" stroke-width=\"2\"/>\n          <circle cx=\"90\" cy=\"104\" r=\"3\" fill=\"#DE2626\"/>\n        </g>\n\n        <!-- Vertical Divider -->\n        <line x1=\"165\" y1=\"36\" x2=\"165\" y2=\"164\" stroke=\"#252533\" stroke-width=\"1.5\"/>\n        <line x1=\"165\" y1=\"75\" x2=\"165\" y2=\"125\" stroke=\"#DE2626\" stroke-width=\"2\"/>\n\n        <!-- Right Content & Telemetry Labels -->\n        <rect x=\"185\" y=\"36\" width=\"60\" height=\"18\" rx=\"4\" fill=\"#DE2626\" fill-opacity=\"0.15\" stroke=\"#DE2626\" stroke-width=\"1\"/>\n        <text x=\"215\" y=\"49\" fill=\"#DE2626\" font-size=\"10\" font-family=\"monospace\" font-weight=\"700\" text-anchor=\"middle\">VERIFIED</text>\n\n        <text x=\"185\" y=\"80\" fill=\"#FFFFFF\" font-size=\"16\" font-family=\"-apple-system, sans-serif\" font-weight=\"700\" letter-spacing=\"1\">CANVAS COMPONENT</text>\n        <text x=\"185\" y=\"100\" fill=\"#888899\" font-size=\"11\" font-family=\"monospace\">RELEASE_VERSION: 300</text>\n        <text x=\"185\" y=\"118\" fill=\"#888899\" font-size=\"11\" font-family=\"monospace\">SPEC: BEJSON 105a</text>\n\n        <!-- Bottom Telemetry Indicator -->\n        <rect x=\"185\" y=\"142\" width=\"180\" height=\"8\" rx=\"2\" fill=\"#15151e\"/>\n        <rect x=\"185\" y=\"142\" width=\"126\" height=\"8\" rx=\"2\" fill=\"#DE2626\"/>\n        <text x=\"185\" y=\"166\" fill=\"#555566\" font-size=\"9\" font-family=\"monospace\">TELEMETRY SYNC: 100% OPTIMAL</text>\n      </svg>\n    </div>\n  </div>\n\n  <script>\n    window.isReadyToCapture = false;\n    window.pauseAnimation = function() {\n      document.querySelectorAll('*').forEach(el => el.style.animationPlayState = 'paused');\n    };\n    window.playAnimation = function() {\n      document.querySelectorAll('*').forEach(el => el.style.animationPlayState = 'running');\n    };\n    window.seekProgress = function(progress) {\n      const totalDurationSec = 3.0;\n      const targetTimeSec = progress * totalDurationSec;\n      document.querySelectorAll('*').forEach(el => {\n        el.style.animationDelay = `-${targetTimeSec}s`;\n        el.style.animationPlayState = 'paused';\n      });\n    };\n    window.addEventListener('DOMContentLoaded', () => {\n      setTimeout(() => { window.isReadyToCapture = true; }, 300);\n    });\n  </script>\n</body>\n</html>\n",
