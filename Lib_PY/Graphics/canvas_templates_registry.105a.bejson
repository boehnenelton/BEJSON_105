    [
      "31b87843-d2a5-468e-aa34-934cd3916f33",
      "legacy_template_texture_checkerboard",
      "template_texture_checkerboard.html",
      "legacy_exemplar",
      800,
      800,
      "800:800",
      "#capture-stage",
      "Exemplar template template_texture_checkerboard.html from /storage/emulated/0/Admin/Dev/Templates/Canvas_SVG_Capture_Templates",
      "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"UTF-8\">\n  <title>Seamless Texture Tile Stage \u2014 Checkerboard</title>\n  <style>\n    * {\n      box-sizing: border-box;\n      margin: 0;\n      padding: 0;\n    }\n    body {\n      background: #000000;\n      color: #FFFFFF;\n      width: 100vw;\n      height: 100vh;\n      display: flex;\n      align-items: center;\n      justify-content: center;\n      overflow: hidden;\n      font-family: -apple-system, BlinkMacSystemFont, \"Segoe UI\", Roboto, monospace;\n    }\n\n    /* Fixed 840x420 Banner Stage */\n    #capture-stage {\n      position: relative;\n      width: 840px;\n      height: 420px;\n      background: #000000;\n      border: 1px solid #1c1c22;\n      overflow: hidden;\n      display: flex;\n      align-items: center;\n      justify-content: center;\n    }\n\n    /* Isolated single tile container for direct seamless tile unit capture */\n    #tile-unit {\n      position: absolute;\n      top: -9999px;\n      left: -9999px;\n      width: 64px;\n      height: 64px;\n      background: #000000;\n      overflow: hidden;\n    }\n\n    svg.canvas-fill {\n      width: 100%;\n      height: 100%;\n      display: block;\n    }\n\n    /* Seamless scroll animation */\n    @keyframes checkerDrift {\n      0% {\n        transform: translate(0px, 0px);\n      }\n      100% {\n        transform: translate(64px, 64px);\n      }\n    }\n\n    /* Subtle pulse animation for accent borders */\n    @keyframes accentGlow {\n      0%, 100% {\n        opacity: 0.35;\n        stroke: #DE2626;\n      }\n      50% {\n        opacity: 0.95;\n        stroke: #FFFFFF;\n      }\n    }\n\n    .anim-drift {\n      animation: checkerDrift 4s linear infinite;\n    }\n\n    .anim-glow {\n      animation: accentGlow 2.5s ease-in-out infinite;\n    }\n\n    .telemetry-tag {\n      position: absolute;\n      bottom: 12px;\n      left: 16px;\n      font-size: 10px;\n      letter-spacing: 1px;\n      color: rgba(255, 255, 255, 0.45);\n      background: rgba(0, 0, 0, 0.8);\n      padding: 3px 6px;\n      border: 1px solid #1c1c22;\n      pointer-events: none;\n      z-index: 10;\n    }\n  </style>\n</head>\n<body>\n\n  <!-- Full Tiled Canvas Stage (840x420) -->\n  <div id=\"capture-stage\">\n    <svg class=\"canvas-fill\" xmlns=\"http://www.w3.org/2000/svg\">\n      <defs>\n        <!-- Seamless 64x64 Checkerboard Pattern -->\n        <pattern id=\"checker-pattern\" width=\"64\" height=\"64\" patternUnits=\"userSpaceOnUse\" class=\"anim-drift\">\n          <!-- Quadrant 1 (Top-Left: 32x32) -->\n          <rect x=\"0\" y=\"0\" width=\"32\" height=\"32\" fill=\"#000000\"/>\n          <line x1=\"0\" y1=\"0\" x2=\"32\" y2=\"32\" stroke=\"#16161c\" stroke-width=\"0.5\"/>\n          <line x1=\"32\" y1=\"0\" x2=\"0\" y2=\"32\" stroke=\"#16161c\" stroke-width=\"0.5\"/>\n          <circle cx=\"16\" cy=\"16\" r=\"1.5\" fill=\"#DE2626\" opacity=\"0.6\"/>\n\n          <!-- Quadrant 2 (Top-Right: 32x32) -->\n          <rect x=\"32\" y=\"0\" width=\"32\" height=\"32\" fill=\"#111116\"/>\n          <rect x=\"36\" y=\"4\" width=\"24\" height=\"24\" fill=\"none\" stroke=\"#22222a\" stroke-width=\"1\"/>\n          <circle cx=\"48\" cy=\"16\" r=\"1\" fill=\"#FFFFFF\" opacity=\"0.4\"/>\n\n          <!-- Quadrant 3 (Bottom-Left: 32x32) -->\n          <rect x=\"0\" y=\"32\" width=\"32\" height=\"32\" fill=\"#111116\"/>\n          <rect x=\"4\" y=\"36\" width=\"24\" height=\"24\" fill=\"none\" stroke=\"#22222a\" stroke-width=\"1\"/>\n          <circle cx=\"16\" cy=\"48\" r=\"1\" fill=\"#FFFFFF\" opacity=\"0.4\"/>\n\n          <!-- Quadrant 4 (Bottom-Right: 32x32) -->\n          <rect x=\"32\" y=\"32\" width=\"32\" height=\"32\" fill=\"#000000\"/>\n          <line x1=\"32\" y1=\"32\" x2=\"64\" y2=\"64\" stroke=\"#16161c\" stroke-width=\"0.5\"/>\n          <line x1=\"64\" y1=\"32\" x2=\"32\" y2=\"64\" stroke=\"#16161c\" stroke-width=\"0.5\"/>\n          <circle cx=\"48\" cy=\"48\" r=\"1.5\" fill=\"#DE2626\" opacity=\"0.6\"/>\n\n          <!-- Seamless Grid Boundary & Accent Crosshair -->\n          <path d=\"M 0,0 L 64,0 L 64,64 L 0,64 Z\" fill=\"none\" stroke=\"#1c1c24\" stroke-width=\"1\"/>\n          <path d=\"M 32,0 L 32,64 M 0,32 L 64,32\" stroke=\"#22222c\" stroke-width=\"0.75\"/>\n          <!-- Active Center Reticle -->\n          <circle cx=\"32\" cy=\"32\" r=\"3\" fill=\"none\" stroke=\"#DE2626\" stroke-width=\"1\" class=\"anim-glow\"/>\n        </pattern>\n      </defs>\n\n      <!-- Fill entire canvas with seamless pattern -->\n      <rect width=\"100%\" height=\"100%\" fill=\"url(#checker-pattern)\"/>\n\n      <!-- Ambient Vignette -->\n      <radialGradient id=\"vignette\" cx=\"50%\" cy=\"50%\" r=\"55%\">\n        <stop offset=\"65%\" stop-color=\"#000000\" stop-opacity=\"0\"/>\n        <stop offset=\"100%\" stop-color=\"#000000\" stop-opacity=\"0.9\"/>\n      </radialGradient>\n      <rect width=\"100%\" height=\"100%\" fill=\"url(#vignette)\" pointer-events=\"none\"/>\n    </svg>\n\n    <div class=\"telemetry-tag\">TEXTURE_TILE // CHECKERBOARD_64PX</div>\n  </div>\n\n  <!-- Single 64x64 Tile Unit -->\n  <div id=\"tile-unit\">\n    <svg width=\"64\" height=\"64\" viewBox=\"0 0 64 64\" xmlns=\"http://www.w3.org/2000/svg\">\n      <rect x=\"0\" y=\"0\" width=\"32\" height=\"32\" fill=\"#000000\"/>\n      <rect x=\"32\" y=\"0\" width=\"32\" height=\"32\" fill=\"#111116\"/>\n      <rect x=\"0\" y=\"32\" width=\"32\" height=\"32\" fill=\"#111116\"/>\n      <rect x=\"32\" y=\"32\" width=\"32\" height=\"32\" fill=\"#000000\"/>\n      <path d=\"M 0,0 L 64,0 L 64,64 L 0,64 Z\" fill=\"none\" stroke=\"#1c1c24\" stroke-width=\"1\"/>\n      <path d=\"M 32,0 L 32,64 M 0,32 L 64,32\" stroke=\"#22222c\" stroke-width=\"0.75\"/>\n      <circle cx=\"32\" cy=\"32\" r=\"3\" fill=\"none\" stroke=\"#DE2626\" stroke-width=\"1\"/>\n      <circle cx=\"16\" cy=\"16\" r=\"1.5\" fill=\"#DE2626\"/>\n      <circle cx=\"48\" cy=\"48\" r=\"1.5\" fill=\"#DE2626\"/>\n    </svg>\n  </div>\n\n  <script>\n    window.isReadyToCapture = false;\n\n    window.pauseAnimation = function() {\n      document.querySelectorAll('*').forEach(el => {\n        el.style.animationPlayState = 'paused';\n      });\n    };\n\n    window.playAnimation = function() {\n      document.querySelectorAll('*').forEach(el => {\n        el.style.animationPlayState = 'running';\n      });\n    };\n\n    window.seekProgress = function(progress) {\n      const totalDurationSec = 4.0;\n      const targetTimeSec = progress * totalDurationSec;\n      document.querySelectorAll('*').forEach(el => {\n        el.style.animationDelay = `-${targetTimeSec}s`;\n        el.style.animationPlayState = 'paused';\n      });\n    };\n\n    window.addEventListener('DOMContentLoaded', () => {\n      setTimeout(() => {\n        window.isReadyToCapture = true;\n      }, 300);\n    });\n  </script>\n</body>\n</html>\n",
      "9624698f5075e3fb94bc0122f4a8c151c50b504056352229eb1a103b99f51a86"
    ],
    [
      "3d5a26fc-e3a8-4639-a64e-c89436f77c32",
      "legacy_template_texture_circuit_grid",
      "template_texture_circuit_grid.html",
      "legacy_exemplar",
      800,
      800,
      "800:800",
      "#capture-stage",
      "Exemplar template template_texture_circuit_grid.html from /storage/emulated/0/Admin/Dev/Templates/Canvas_SVG_Capture_Templates",
      "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"UTF-8\">\n  <title>Seamless Texture Tile Stage \u2014 Circuit Architecture Grid</title>\n  <style>\n    * {\n      box-sizing: border-box;\n      margin: 0;\n      padding: 0;\n    }\n    body {\n      background: #000000;\n      color: #FFFFFF;\n      width: 100vw;\n      height: 100vh;\n      display: flex;\n      align-items: center;\n      justify-content: center;\n      overflow: hidden;\n      font-family: -apple-system, BlinkMacSystemFont, \"Segoe UI\", Roboto, monospace;\n    }\n\n    /* Fixed 1280x720 Widescreen Stage */\n    #capture-stage {\n      position: relative;\n      width: 1280px;\n      height: 720px;\n      background: #000000;\n      border: 1px solid #1c1c22;\n      overflow: hidden;\n      display: flex;\n      align-items: center;\n      justify-content: center;\n    }\n\n    /* Isolated single tile container */\n    #tile-unit {\n      position: absolute;\n      top: -9999px;\n      left: -9999px;\n      width: 64px;\n      height: 64px;\n      background: #000000;\n      overflow: hidden;\n    }\n\n    svg.canvas-fill {\n      width: 100%;\n      height: 100%;\n      display: block;\n    }\n\n    /* Seamless coordinate drift */\n    @keyframes circuitDrift {\n      0% {\n        transform: translate(0px, 0px);\n      }\n      100% {\n        transform: translate(64px, 64px);\n      }\n    }\n\n    /* Trace light transmission pulse */\n    @keyframes tracePulse {\n      0%, 100% {\n        stroke: #DE2626;\n        opacity: 0.4;\n      }\n      50% {\n        stroke: #FFFFFF;\n        opacity: 1.0;\n        filter: drop-shadow(0 0 4px #DE2626);\n      }\n    }\n\n    .anim-drift {\n      animation: circuitDrift 8s linear infinite;\n    }\n\n    .anim-pulse {\n      animation: tracePulse 2s ease-in-out infinite;\n    }\n\n    .telemetry-tag {\n      position: absolute;\n      bottom: 16px;\n      left: 20px;\n      font-size: 11px;\n      letter-spacing: 1px;\n      color: rgba(255, 255, 255, 0.4);\n      background: rgba(0, 0, 0, 0.8);\n      padding: 4px 8px;\n      border: 1px solid #1c1c22;\n      pointer-events: none;\n      z-index: 10;\n    }\n  </style>\n</head>\n<body>\n\n  <!-- Full Tiled Canvas Stage (1280x720) -->\n  <div id=\"capture-stage\">\n    <svg class=\"canvas-fill\" xmlns=\"http://www.w3.org/2000/svg\">\n      <defs>\n        <!-- Seamless 64x64 Circuit Trace Pattern -->\n        <pattern id=\"circuit-pattern\" width=\"64\" height=\"64\" patternUnits=\"userSpaceOnUse\" class=\"anim-drift\">\n          <!-- Dark background base -->\n          <rect width=\"64\" height=\"64\" fill=\"#040407\"/>\n\n          <!-- Secondary Grid lines (subtle) -->\n          <path d=\"M 0,0 L 64,0 L 64,64 L 0,64 Z\" fill=\"none\" stroke=\"#0e0e14\" stroke-width=\"0.5\"/>\n\n          <!-- Seamless Horizontal and Vertical Traces matching opposite edges -->\n          <!-- Horizontal trace passing through y=32 -->\n          <line x1=\"0\" y1=\"32\" x2=\"20\" y2=\"32\" stroke=\"#22222a\" stroke-width=\"1.5\"/>\n          <line x1=\"44\" y1=\"32\" x2=\"64\" y2=\"32\" stroke=\"#22222a\" stroke-width=\"1.5\"/>\n\n          <!-- Vertical trace passing through x=32 -->\n          <line x1=\"32\" y1=\"0\" x2=\"32\" y2=\"20\" stroke=\"#22222a\" stroke-width=\"1.5\"/>\n          <line x1=\"32\" y1=\"44\" x2=\"32\" y2=\"64\" stroke=\"#22222a\" stroke-width=\"1.5\"/>\n\n          <!-- Corner bypass route (from x=0, y=16 to x=16, y=0) -->\n          <path d=\"M 0,16 L 8,16 L 16,8 L 16,0\" fill=\"none\" stroke=\"#1c1c24\" stroke-width=\"1.2\"/>\n          <!-- Matching corner bypass (from x=64, y=48 to x=48, y=64) -->\n          <path d=\"M 64,48 L 56,48 L 48,56 L 48,64\" fill=\"none\" stroke=\"#1c1c24\" stroke-width=\"1.2\"/>\n\n          <!-- Active Red High-Speed Bus Trace passing through (y=48) -->\n          <line x1=\"0\" y1=\"48\" x2=\"64\" y2=\"48\" stroke=\"#DE2626\" stroke-width=\"1\" class=\"anim-pulse\"/>\n\n          <!-- Central Junction Pad Node -->\n          <circle cx=\"32\" cy=\"32\" r=\"6\" fill=\"#0a0a0f\" stroke=\"#33333f\" stroke-width=\"1\"/>\n          <circle cx=\"32\" cy=\"32\" r=\"3\" fill=\"#DE2626\" class=\"anim-pulse\"/>\n\n          <!-- Edge Connection Terminals (matching seamlessly at borders) -->\n          <circle cx=\"0\" cy=\"32\" r=\"2\" fill=\"#22222a\"/>\n          <circle cx=\"64\" cy=\"32\" r=\"2\" fill=\"#22222a\"/>\n          <circle cx=\"32\" cy=\"0\" r=\"2\" fill=\"#22222a\"/>\n          <circle cx=\"32\" cy=\"64\" r=\"2\" fill=\"#22222a\"/>\n\n          <!-- Diagonal accent node pads -->\n          <rect x=\"14\" y=\"46\" width=\"4\" height=\"4\" fill=\"#FFFFFF\" opacity=\"0.7\"/>\n          <rect x=\"46\" y=\"14\" width=\"4\" height=\"4\" fill=\"#FFFFFF\" opacity=\"0.7\"/>\n        </pattern>\n      </defs>\n\n      <!-- Fill entire canvas with seamless pattern -->\n      <rect width=\"100%\" height=\"100%\" fill=\"url(#circuit-pattern)\"/>\n\n      <!-- Ambient Vignette -->\n      <radialGradient id=\"vignette\" cx=\"50%\" cy=\"50%\" r=\"60%\">\n        <stop offset=\"60%\" stop-color=\"#000000\" stop-opacity=\"0\"/>\n        <stop offset=\"100%\" stop-color=\"#000000\" stop-opacity=\"0.85\"/>\n      </radialGradient>\n      <rect width=\"100%\" height=\"100%\" fill=\"url(#vignette)\" pointer-events=\"none\"/>\n    </svg>\n\n    <div class=\"telemetry-tag\">TEXTURE_TILE // CIRCUIT_ARCHITECTURE_GRID_64PX</div>\n  </div>\n\n  <!-- Single 64x64 Tile Unit -->\n  <div id=\"tile-unit\">\n    <svg width=\"64\" height=\"64\" viewBox=\"0 0 64 64\" xmlns=\"http://www.w3.org/2000/svg\">\n      <rect width=\"64\" height=\"64\" fill=\"#040407\"/>\n      <path d=\"M 0,0 L 64,0 L 64,64 L 0,64 Z\" fill=\"none\" stroke=\"#0e0e14\" stroke-width=\"0.5\"/>\n      <line x1=\"0\" y1=\"32\" x2=\"20\" y2=\"32\" stroke=\"#22222a\" stroke-width=\"1.5\"/>\n      <line x1=\"44\" y1=\"32\" x2=\"64\" y2=\"32\" stroke=\"#22222a\" stroke-width=\"1.5\"/>\n      <line x1=\"32\" y1=\"0\" x2=\"32\" y2=\"20\" stroke=\"#22222a\" stroke-width=\"1.5\"/>\n      <line x1=\"32\" y1=\"44\" x2=\"32\" y2=\"64\" stroke=\"#22222a\" stroke-width=\"1.5\"/>\n      <path d=\"M 0,16 L 8,16 L 16,8 L 16,0\" fill=\"none\" stroke=\"#1c1c24\" stroke-width=\"1.2\"/>\n      <path d=\"M 64,48 L 56,48 L 48,56 L 48,64\" fill=\"none\" stroke=\"#1c1c24\" stroke-width=\"1.2\"/>\n      <line x1=\"0\" y1=\"48\" x2=\"64\" y2=\"48\" stroke=\"#DE2626\" stroke-width=\"1\"/>\n      <circle cx=\"32\" cy=\"32\" r=\"6\" fill=\"#0a0a0f\" stroke=\"#33333f\" stroke-width=\"1\"/>\n      <circle cx=\"32\" cy=\"32\" r=\"3\" fill=\"#DE2626\"/>\n      <circle cx=\"0\" cy=\"32\" r=\"2\" fill=\"#22222a\"/>\n      <circle cx=\"64\" cy=\"32\" r=\"2\" fill=\"#22222a\"/>\n      <circle cx=\"32\" cy=\"0\" r=\"2\" fill=\"#22222a\"/>\n      <circle cx=\"32\" cy=\"64\" r=\"2\" fill=\"#22222a\"/>\n    </svg>\n  </div>\n\n  <script>\n    window.isReadyToCapture = false;\n\n    window.pauseAnimation = function() {\n      document.querySelectorAll('*').forEach(el => {\n        el.style.animationPlayState = 'paused';\n      });\n    };\n\n    window.playAnimation = function() {\n      document.querySelectorAll('*').forEach(el => {\n        el.style.animationPlayState = 'running';\n      });\n    };\n\n    window.seekProgress = function(progress) {\n      const totalDurationSec = 8.0;\n      const targetTimeSec = progress * totalDurationSec;\n      document.querySelectorAll('*').forEach(el => {\n        el.style.animationDelay = `-${targetTimeSec}s`;\n        el.style.animationPlayState = 'paused';\n      });\n    };\n\n    window.addEventListener('DOMContentLoaded', () => {\n      setTimeout(() => {\n        window.isReadyToCapture = true;\n      }, 300);\n    });\n  </script>\n</body>\n</html>\n",
      "f0f2be9a053813544c599f16f3da5310f25679685dee4584ea928fae8e0d82a8"
