      "#capture-stage",
      "Exemplar template template_banner_840x420.html from /storage/emulated/0/Admin/Dev/Templates/Canvas_SVG_Capture_Templates",
      "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"UTF-8\">\n  <title>Canvas Stage \u2014 Banner 840x420 (2:1)</title>\n  <style>\n    * {\n      box-sizing: border-box;\n      margin: 0;\n      padding: 0;\n    }\n    body {\n      background: #000000;\n      color: #FFFFFF;\n      width: 100vw;\n      height: 100vh;\n      display: flex;\n      align-items: center;\n      justify-content: center;\n      overflow: hidden;\n      font-family: -apple-system, BlinkMacSystemFont, \"Segoe UI\", Roboto, monospace;\n    }\n    #capture-stage {\n      position: relative;\n      width: 840px;\n      height: 420px;\n      background: #0a0a0d;\n      border: 1px solid #222228;\n      overflow: hidden;\n      display: flex;\n      align-items: center;\n      justify-content: center;\n    }\n    .svg-container {\n      width: 100%;\n      height: 100%;\n    }\n    svg {\n      width: 100%;\n      height: 100%;\n      display: block;\n    }\n    @keyframes scanWave {\n      0% {\n        stroke-dashoffset: 400;\n      }\n      100% {\n        stroke-dashoffset: 0;\n      }\n    }\n    @keyframes floatCluster {\n      0%, 100% {\n        transform: translateY(0px);\n      }\n      50% {\n        transform: translateY(-8px);\n      }\n    }\n    .anim-wave {\n      stroke-dasharray: 20, 10;\n      animation: scanWave 4s linear infinite;\n    }\n    .anim-float {\n      animation: floatCluster 4s ease-in-out infinite;\n    }\n  </style>\n</head>\n<body>\n  <div id=\"capture-stage\" data-width=\"840\" data-height=\"420\" data-ratio=\"2:1\">\n    <div class=\"svg-container\">\n      <svg id=\"svg-root\" viewBox=\"0 0 840 420\" xmlns=\"http://www.w3.org/2000/svg\">\n        <defs>\n          <linearGradient id=\"bannerBgGrad\" x1=\"0%\" y1=\"0%\" x2=\"100%\" y2=\"100%\">\n            <stop offset=\"0%\" stop-color=\"#0a0a0d\" />\n            <stop offset=\"100%\" stop-color=\"#020203\" />\n          </linearGradient>\n          <linearGradient id=\"beamGrad\" x1=\"0%\" y1=\"0%\" x2=\"100%\" y2=\"0%\">\n            <stop offset=\"0%\" stop-color=\"#DE2626\" stop-opacity=\"0\" />\n            <stop offset=\"50%\" stop-color=\"#DE2626\" stop-opacity=\"1\" />\n            <stop offset=\"100%\" stop-color=\"#DE2626\" stop-opacity=\"0\" />\n          </linearGradient>\n        </defs>\n\n        <!-- Canvas Background -->\n        <rect width=\"840\" height=\"420\" fill=\"url(#bannerBgGrad)\" />\n\n        <!-- 8-Lane Subtle Production Grid -->\n        <g opacity=\"0.08\" stroke=\"#FFFFFF\" stroke-width=\"1\">\n          <line x1=\"105\" y1=\"0\" x2=\"105\" y2=\"420\" />\n          <line x1=\"210\" y1=\"0\" x2=\"210\" y2=\"420\" />\n          <line x1=\"315\" y1=\"0\" x2=\"315\" y2=\"420\" />\n          <line x1=\"420\" y1=\"0\" x2=\"420\" y2=\"420\" />\n          <line x1=\"525\" y1=\"0\" x2=\"525\" y2=\"420\" />\n          <line x1=\"630\" y1=\"0\" x2=\"630\" y2=\"420\" />\n          <line x1=\"735\" y1=\"0\" x2=\"735\" y2=\"420\" />\n        </g>\n\n        <!-- Dynamic Data Beams -->\n        <path d=\"M 40,210 L 800,210\" stroke=\"#22222a\" stroke-width=\"2\" />\n        <path d=\"M 40,210 L 800,210\" stroke=\"url(#beamGrad)\" stroke-width=\"2\" class=\"anim-wave\" />\n\n        <!-- Floating Stage Cluster -->\n        <g class=\"anim-float\" transform=\"translate(420, 210)\">\n          <!-- Left Node -->\n          <circle cx=\"-260\" cy=\"0\" r=\"28\" fill=\"#141418\" stroke=\"#2d2d38\" stroke-width=\"2\" />\n          <circle cx=\"-260\" cy=\"0\" r=\"10\" fill=\"#DE2626\" />\n          <text x=\"-260\" y=\"48\" fill=\"#888899\" font-size=\"11\" font-family=\"monospace\" text-anchor=\"middle\">SOURCE</text>\n\n          <!-- Center Cube Complex -->\n          <!-- Base Hexagon -->\n          <polygon points=\"0,-60 52,-30 52,30 0,60 -52,30 -52,-30\" fill=\"#18181f\" stroke=\"#333340\" stroke-width=\"2\" />\n          <!-- Inner Isometric Cube -->\n          <polygon points=\"0,-40 34,-20 0,0 -34,-20\" fill=\"#3a3a46\" stroke=\"#4e4e5c\" stroke-width=\"1.2\" />\n          <polygon points=\"-34,-20 0,0 0,40 -34,20\" fill=\"#1f1f26\" stroke=\"#33333e\" stroke-width=\"1.2\" />\n          <polygon points=\"0,0 34,-20 34,20 0,40\" fill=\"#14141a\" stroke=\"#262630\" stroke-width=\"1.2\" />\n          <!-- Red Core Point -->\n          <circle cx=\"0\" cy=\"0\" r=\"5\" fill=\"#DE2626\" />\n          <text x=\"0\" y=\"80\" fill=\"#FFFFFF\" font-size=\"13\" font-family=\"sans-serif\" font-weight=\"700\" letter-spacing=\"2\" text-anchor=\"middle\">PIPELINE CORE</text>\n\n          <!-- Right Node -->\n          <circle cx=\"260\" cy=\"0\" r=\"28\" fill=\"#141418\" stroke=\"#2d2d38\" stroke-width=\"2\" />\n          <polygon points=\"260,-10 268,6 252,6\" fill=\"#DE2626\" />\n          <text x=\"260\" y=\"48\" fill=\"#888899\" font-size=\"11\" font-family=\"monospace\" text-anchor=\"middle\">OUTPUT</text>\n        </g>\n\n        <!-- Stage Header & Footers -->\n        <text x=\"32\" y=\"48\" fill=\"#888899\" font-size=\"12\" font-family=\"monospace\" letter-spacing=\"2\">STAGE_DIM: 840x420</text>\n        <text x=\"32\" y=\"68\" fill=\"#DE2626\" font-size=\"11\" font-family=\"monospace\">RATIO: 2:1 HERO BANNER</text>\n        <text x=\"808\" y=\"48\" fill=\"#555566\" font-size=\"11\" font-family=\"monospace\" text-anchor=\"end\">RENDER_TARGET: 420p</text>\n      </svg>\n    </div>\n  </div>\n\n  <script>\n    window.isReadyToCapture = false;\n\n    window.pauseAnimation = function() {\n      document.querySelectorAll('*').forEach(el => {\n        el.style.animationPlayState = 'paused';\n      });\n    };\n\n    window.playAnimation = function() {\n      document.querySelectorAll('*').forEach(el => {\n        el.style.animationPlayState = 'running';\n      });\n    };\n\n    window.seekProgress = function(progress) {\n      const totalDurationSec = 4.0;\n      const targetTimeSec = progress * totalDurationSec;\n      document.querySelectorAll('*').forEach(el => {\n        el.style.animationDelay = `-${targetTimeSec}s`;\n        el.style.animationPlayState = 'paused';\n      });\n    };\n\n    window.addEventListener('DOMContentLoaded', () => {\n      setTimeout(() => {\n        window.isReadyToCapture = true;\n      }, 300);\n    });\n  </script>\n</body>\n</html>\n",
      "d25b6a4c61a67c7956f8b4f20ed3cf28ac34ba1f9b0e4783f6f773ebc6d60d81"
