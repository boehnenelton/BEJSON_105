      128,
      128,
      "128:128",
      "#capture-stage",
      "Exemplar template template_icon_128x128.html from /storage/emulated/0/Admin/Dev/Templates/Canvas_SVG_Capture_Templates",
      "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"UTF-8\">\n  <title>Canvas Icon \u2014 128x128 System Icon</title>\n  <style>\n    * {\n      box-sizing: border-box;\n      margin: 0;\n      padding: 0;\n    }\n    body {\n      background: #000000;\n      color: #FFFFFF;\n      width: 100vw;\n      height: 100vh;\n      display: flex;\n      align-items: center;\n      justify-content: center;\n      overflow: hidden;\n    }\n    #capture-stage {\n      position: relative;\n      width: 128px;\n      height: 128px;\n      background: #000000;\n      overflow: hidden;\n      display: flex;\n      align-items: center;\n      justify-content: center;\n    }\n    .svg-container {\n      width: 100%;\n      height: 100%;\n      display: flex;\n      align-items: center;\n      justify-content: center;\n    }\n    svg {\n      width: 100%;\n      height: 100%;\n      display: block;\n    }\n\n    @keyframes pulseGlow {\n      0%, 100% {\n        transform: scale(1);\n        filter: drop-shadow(0 0 4px rgba(222, 38, 38, 0.4));\n      }\n      50% {\n        transform: scale(1.08);\n        filter: drop-shadow(0 0 10px rgba(222, 38, 38, 0.9));\n      }\n    }\n    .anim-pulse {\n      transform-origin: 64px 64px;\n      animation: pulseGlow 3s ease-in-out infinite;\n    }\n  </style>\n</head>\n<body>\n  <div id=\"capture-stage\">\n    <div class=\"svg-container\">\n      <svg viewBox=\"0 0 128 128\" xmlns=\"http://www.w3.org/2000/svg\">\n        <!-- Outer Border -->\n        <rect x=\"6\" y=\"6\" width=\"116\" height=\"116\" rx=\"28\" fill=\"#0d0d12\" stroke=\"#252533\" stroke-width=\"2\"/>\n        <rect x=\"10\" y=\"10\" width=\"108\" height=\"108\" rx=\"24\" fill=\"none\" stroke=\"#DE2626\" stroke-width=\"1\" stroke-dasharray=\"4 3\" opacity=\"0.6\"/>\n\n        <!-- Central Glyph Container -->\n        <g class=\"anim-pulse\">\n          <!-- Isometric Cube 104 -->\n          <!-- Top Face -->\n          <polygon points=\"64,36 88,50 64,64 40,50\" fill=\"#FFFFFF\" stroke=\"#DE2626\" stroke-width=\"1.5\"/>\n          <!-- Left Face -->\n          <polygon points=\"64,64 40,50 40,78 64,92\" fill=\"#2a2a38\" stroke=\"#3d3d52\" stroke-width=\"1.5\"/>\n          <!-- Right Face -->\n          <polygon points=\"64,64 88,50 88,78 64,92\" fill=\"#181822\" stroke=\"#3d3d52\" stroke-width=\"1.5\"/>\n          <!-- Central Spine -->\n          <line x1=\"64\" y1=\"64\" x2=\"64\" y2=\"92\" stroke=\"#DE2626\" stroke-width=\"2\"/>\n          <circle cx=\"64\" cy=\"64\" r=\"2.5\" fill=\"#DE2626\"/>\n        </g>\n\n        <!-- Corner Micro Accents -->\n        <circle cx=\"20\" cy=\"20\" r=\"1.5\" fill=\"#DE2626\"/>\n        <circle cx=\"108\" cy=\"20\" r=\"1.5\" fill=\"#DE2626\"/>\n        <circle cx=\"20\" cy=\"108\" r=\"1.5\" fill=\"#DE2626\"/>\n        <circle cx=\"108\" cy=\"108\" r=\"1.5\" fill=\"#DE2626\"/>\n      </svg>\n    </div>\n  </div>\n\n  <script>\n    window.isReadyToCapture = false;\n    window.pauseAnimation = function() {\n      document.querySelectorAll('*').forEach(el => el.style.animationPlayState = 'paused');\n    };\n    window.playAnimation = function() {\n      document.querySelectorAll('*').forEach(el => el.style.animationPlayState = 'running');\n    };\n    window.seekProgress = function(progress) {\n      const totalDurationSec = 3.0;\n      const targetTimeSec = progress * totalDurationSec;\n      document.querySelectorAll('*').forEach(el => {\n        el.style.animationDelay = `-${targetTimeSec}s`;\n        el.style.animationPlayState = 'paused';\n      });\n    };\n    window.addEventListener('DOMContentLoaded', () => {\n      setTimeout(() => { window.isReadyToCapture = true; }, 250);\n    });\n  </script>\n</body>\n</html>\n",
