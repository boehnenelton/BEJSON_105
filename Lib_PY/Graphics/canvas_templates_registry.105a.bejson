      "16:9 Minimal 3-Step Horizontal Process Flow presentation slide template with red directional arrows and red accent tag.",
      "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"UTF-8\">\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n  <title>16:9 Minimal 3-Step Horizontal Process Flow presentation slide template with red directional arrows and red accent tag.</title>\n  <style>\n    * {\n      box-sizing: border-box;\n      margin: 0;\n      padding: 0;\n    }\n    html, body {\n      width: 100vw;\n      height: 100vh;\n      background: #111113;\n      display: flex;\n      align-items: center;\n      justify-content: center;\n      overflow: hidden;\n      font-family: -apple-system, BlinkMacSystemFont, \"Segoe UI\", Roboto, monospace;\n    }\n    #capture-stage {\n      position: relative;\n      width: 1280px;\n      height: 720px;\n      background: #111113;\n      border: 1px solid #1c1c24;\n      overflow: hidden;\n      display: flex;\n      align-items: center;\n      justify-content: center;\n    }\n    .canvas-slot {\n      width: 100%;\n      height: 100%;\n      display: flex;\n      align-items: center;\n      justify-content: center;\n      position: relative;\n    }\n    .canvas-slot > svg, .canvas-slot > img {\n      width: 100%;\n      height: 100%;\n      display: block;\n      object-fit: contain;\n    }\n  </style>\n</head>\n<body>\n  <div id=\"capture-stage\" data-width=\"1280\" data-height=\"720\">\n    <div class=\"canvas-slot\" id=\"stage-slot\">\n      <svg width=\"1280\" height=\"720\" viewBox=\"0 0 1280 720\" xmlns=\"http://www.w3.org/2000/svg\">\n  <rect width=\"1280\" height=\"720\" fill=\"#111113\"/>\n  <!-- Red accent bar above title -->\n  <rect x=\"64\" y=\"60\" width=\"44\" height=\"4\" rx=\"2\" fill=\"#DE2626\"/>\n  <text x=\"64\" y=\"115\" fill=\"#FFFFFF\" font-size=\"44\" font-family=\"system-ui, -apple-system, sans-serif\" font-weight=\"800\" letter-spacing=\"1\">FLOW</text>\n  <!-- Flow Cards -->\n  <rect x=\"125\" y=\"260\" width=\"270\" height=\"180\" rx=\"12\" fill=\"#16161A\" stroke=\"#26262E\" stroke-width=\"1.5\"/>\n  <text x=\"260.0\" y=\"356.0\" fill=\"#FFFFFF\" font-size=\"18\" font-family=\"system-ui, -apple-system, sans-serif\" font-weight=\"600\" text-anchor=\"middle\">Step 1</text>\n  \n  <rect x=\"505\" y=\"260\" width=\"270\" height=\"180\" rx=\"12\" fill=\"#16161A\" stroke=\"#26262E\" stroke-width=\"1.5\"/>\n  <text x=\"640.0\" y=\"356.0\" fill=\"#FFFFFF\" font-size=\"18\" font-family=\"system-ui, -apple-system, sans-serif\" font-weight=\"600\" text-anchor=\"middle\">Step 2</text>\n  \n  <rect x=\"885\" y=\"260\" width=\"270\" height=\"180\" rx=\"12\" fill=\"#16161A\" stroke=\"#26262E\" stroke-width=\"1.5\"/>\n  <text x=\"1020.0\" y=\"356.0\" fill=\"#FFFFFF\" font-size=\"18\" font-family=\"system-ui, -apple-system, sans-serif\" font-weight=\"600\" text-anchor=\"middle\">Step 3</text>\n  \n  <!-- Directional Arrows -->\n  <g transform=\"translate(405, 350)\">\n    <line x1=\"0\" y1=\"0\" x2=\"86\" y2=\"0\" stroke=\"#DE2626\" stroke-width=\"2.5\"/>\n    <polygon points=\"84,-6 96,0 84,6\" fill=\"#DE2626\"/>\n  </g>\n  <g transform=\"translate(785, 350)\">\n    <line x1=\"0\" y1=\"0\" x2=\"86\" y2=\"0\" stroke=\"#DE2626\" stroke-width=\"2.5\"/>\n    <polygon points=\"84,-6 96,0 84,6\" fill=\"#DE2626\"/>\n  </g>\n  <!-- Bottom divider -->\n  <line x1=\"64\" y1=\"655\" x2=\"1216\" y2=\"655\" stroke=\"#1C1C22\" stroke-width=\"1\"/>\n  <g transform=\"translate(1050, 660)\">\n    <text x=\"0\" y=\"22\" fill=\"#FFFFFF\" font-size=\"24\" font-family=\"system-ui, -apple-system, sans-serif\" font-weight=\"900\" letter-spacing=\"1.5\">BEJSON</text>\n    <g transform=\"translate(112, 0)\">\n      <polygon points=\"14,2 26,8 14,14 2,8\" fill=\"#FFFFFF\" stroke=\"#FFFFFF\" stroke-width=\"1\" stroke-linejoin=\"round\"/>\n      <polygon points=\"14,5 22,9 14,13 6,9\" fill=\"#111113\" opacity=\"0.9\"/>\n      <polygon points=\"2,8 14,14 14,28 2,22\" fill=\"#1C1C22\" stroke=\"#FFFFFF\" stroke-width=\"1\" stroke-linejoin=\"round\"/>\n      <polygon points=\"14,14 26,8 26,22 14,28\" fill=\"#DE2626\" stroke=\"#FFFFFF\" stroke-width=\"1\" stroke-linejoin=\"round\"/>\n    </g>\n  </g>\n</svg>\n    </div>\n    <!-- Pre-recording Coordinate-Based Text Overlay Layer -->\n    <div id=\"overlay-layer\" style=\"position:absolute;top:0;left:0;width:100%;height:100%;pointer-events:none;z-index:100;overflow:hidden;\"></div>\n  </div>\n\n  <script>\n    window.isReadyToCapture = true;\n    window._activeOverlays = [];\n\n    // Dynamically replace the SVG / graphic content in the blank slate\n    window.setSvgContent = function(svgMarkup) {\n      const slot = document.getElementById('stage-slot');\n      if (slot) {\n        slot.innerHTML = svgMarkup;\n        window.isReadyToCapture = true;\n      }\n    };\n\n    // Update dimensions dynamically\n    window.setDimensions = function(width, height) {\n      const stage = document.getElementById('capture-stage');\n      if (stage) {\n        stage.style.width = width + 'px';\n        stage.style.height = height + 'px';\n        stage.setAttribute('data-width', width);\n        stage.setAttribute('data-height', height);\n      }\n    };\n\n    // Pre-recording Coordinate-Based Text Overlay Injection\n    window.setTextOverlays = function(overlays, context) {\n      const layer = document.getElementById('overlay-layer');\n      if (!layer) return;\n      layer.innerHTML = '';\n      window._activeOverlays = overlays || [];\n      const ctx = context || {};\n\n      (window._activeOverlays).forEach(o => {\n        const item = document.createElement('div');\n        item.style.position = 'absolute';\n        item.style.left = typeof o.x === 'number' ? o.x + 'px' : o.x;\n        item.style.top = typeof o.y === 'number' ? o.y + 'px' : o.y;\n        item.style.fontSize = (o.font_size || 20) + 'px';\n        item.style.fontFamily = o.font_family || 'monospace';\n        item.style.fontWeight = o.font_weight || 'bold';\n        item.style.color = o.color || '#FFFFFF';\n        if (o.bg_color) item.style.backgroundColor = o.bg_color;\n        if (o.padding) item.style.padding = o.padding;\n        if (o.border_radius) item.style.borderRadius = o.border_radius;\n        if (o.opacity !== undefined) item.style.opacity = o.opacity;\n        if (o.z_index) item.style.zIndex = o.z_index;\n        if (o.align) item.style.textAlign = o.align;\n\n        let rawText = o.text || '';\n        // Token interpolation\n        rawText = rawText.replace(/{frame}/g, ctx.frame !== undefined ? ctx.frame : '')\n                         .replace(/{time}/g, ctx.time !== undefined ? Number(ctx.time).toFixed(2) : '')\n                         .replace(/{fps}/g, ctx.fps || '')\n                         .replace(/{caption}/g, ctx.caption || '');\n        item.textContent = rawText;\n        layer.appendChild(item);\n      });\n      window.isReadyToCapture = true;\n    };\n\n    // Timeline seeking hook for CSS/SMIL animations inside the dynamic SVG\n    window.seekProgress = function(progress, durationSeconds) {\n      const dur = durationSeconds || 8.0;\n      const targetTimeSec = progress * dur;\n      document.querySelectorAll('#capture-stage *').forEach(el => {\n        el.style.animationDelay = `-${targetTimeSec}s`;\n        el.style.animationPlayState = 'paused';\n      });\n    };\n\n    // Dynamic Diagram View Loader\n    window.loadDiagram = function(diagramData, state, viewport) {\n      const slot = document.getElementById('stage-slot');\n      if (!slot) return;\n      window._activeDiagram = diagramData;\n      window.setDiagramState(state, viewport);\n    };\n\n    window.setDiagramState = function(state, viewport) {\n      const slot = document.getElementById('stage-slot');\n      if (!slot || !window._activeDiagram) return;\n      const diag = window._activeDiagram;\n      const st = state || {};\n      const vp = viewport || {};\n\n      const activeShapes = new Set(st.active_shapes || []);\n      const dimmedShapes = new Set(st.dimmed_shapes || []);\n      const activeConns = new Set(st.active_connectors || []);\n\n      const stage = document.getElementById('capture-stage');\n      const cw = parseInt(stage.getAttribute('data-width') || 800, 10);\n      const ch = parseInt(stage.getAttribute('data-height') || 800, 10);\n\n      const panX = vp.pan_x !== undefined ? vp.pan_x : 0;\n      const panY = vp.pan_y !== undefined ? vp.pan_y : 0;\n      const zoom = vp.zoom !== undefined ? vp.zoom : 1.0;\n\n      // Build internal SVG representation\n      let svg = `<svg viewBox=\"0 0 ${cw} ${ch}\" width=\"${cw}\" height=\"${ch}\" xmlns=\"http://www.w3.org/2000/svg\" style=\"background:#000000;width:100%;height:100%;\">\n        <defs>\n          <marker id=\"arr\" viewBox=\"0 0 10 10\" refX=\"8\" refY=\"5\" markerWidth=\"6\" markerHeight=\"6\" orient=\"auto-start-reverse\">\n            <path d=\"M 0 1.5 L 8 5 L 0 8.5 z\" fill=\"#FFFFFF\" />\n          </marker>\n          <marker id=\"arr-red\" viewBox=\"0 0 10 10\" refX=\"8\" refY=\"5\" markerWidth=\"7\" markerHeight=\"7\" orient=\"auto-start-reverse\">\n            <path d=\"M 0 1 L 9 5 L 0 9 z\" fill=\"#DE2626\" />\n          </marker>\n          <filter id=\"red-glow\" x=\"-20%\" y=\"-20%\" width=\"140%\" height=\"140%\">\n            <feGaussianBlur stdDeviation=\"6\" result=\"blur\" />\n            <feMerge><feMergeNode in=\"blur\" /><feMergeNode in=\"SourceGraphic\" /></feMerge>\n          </filter>\n        </defs>\n        <g id=\"viewport-group\" transform=\"translate(${panX}, ${panY}) scale(${zoom})\">`;\n\n      const shapeMap = {};\n      (diag.shapes || []).forEach(s => {\n        const sid = s.id || s.tempId;\n        if (sid) shapeMap[sid] = s;\n      });\n\n      // Territories\n      (diag.territories || []).forEach(t => {\n        const sz = t.size || 200;\n        const color = t.color || '#DE2626';\n        svg += `<rect x=\"${t.cx - sz/2}\" y=\"${t.cy - sz/2}\" width=\"${sz}\" height=\"${sz}\" rx=\"16\" fill=\"${color}\" fill-opacity=\"0.05\" stroke=\"${color}\" stroke-opacity=\"0.3\" stroke-width=\"1.5\" stroke-dasharray=\"6,4\" />`;\n        if (t.label) {\n          svg += `<text x=\"${t.cx}\" y=\"${t.cy - sz/2 + 20}\" fill=\"${color}\" font-size=\"11\" font-family=\"monospace\" font-weight=\"bold\" letter-spacing=\"1\" text-anchor=\"middle\">${t.label.toUpperCase()}</text>`;\n        }\n      });\n\n      // Connectors\n      (diag.connectors || []).forEach(c => {\n        const fid = c.from || c.fromTempId;\n        const tid = c.to || c.toTempId;\n        if (shapeMap[fid] && shapeMap[tid]) {\n          const s1 = shapeMap[fid];\n          const s2 = shapeMap[tid];\n          const isAct = activeConns.has(`${fid}->${tid}`) || (activeShapes.has(fid) && activeShapes.has(tid));\n          const col = isAct ? '#DE2626' : '#FFFFFF';\n          const mkr = isAct ? 'url(#arr-red)' : 'url(#arr)';\n          svg += `<line x1=\"${s1.cx}\" y1=\"${s1.cy}\" x2=\"${s2.cx}\" y2=\"${s2.cy}\" stroke=\"${col}\" stroke-width=\"${isAct ? 2.5 : 1.5}\" stroke-opacity=\"${isAct ? 1 : 0.4}\" marker-end=\"${mkr}\" />`;\n        }\n      });\n\n      // Shapes\n      (diag.shapes || []).forEach(s => {\n        const sid = s.id || s.tempId;\n        const w = s.sizeClass === 'small' ? 120 : (s.sizeClass === 'large' ? 300 : 200);\n        const h = s.sizeClass === 'small' ? 70 : (s.sizeClass === 'large' ? 150 : 100);\n        const isAct = activeShapes.has(sid);\n        const isDim = dimmedShapes.has(sid);\n        const col = isAct ? '#DE2626' : '#FFFFFF';\n        const bg = isAct ? '#1c0d0d' : '#121218';\n        const glow = isAct ? 'filter=\"url(#red-glow)\"' : '';\n        const op = isDim ? '0.25' : '1.0';\n\n        svg += `<g id=\"s-${sid}\" opacity=\"${op}\">\n          <rect x=\"${s.cx - w/2}\" y=\"${s.cy - h/2}\" width=\"${w}\" height=\"${h}\" rx=\"8\" fill=\"${bg}\" stroke=\"${col}\" stroke-width=\"${isAct ? 2.5 : 1.2}\" ${glow} />\n          <text x=\"${s.cx - w/2 + 12}\" y=\"${s.cy - h/2 + 24}\" fill=\"#FFFFFF\" font-size=\"12\" font-family=\"-apple-system, sans-serif\" font-weight=\"bold\">${s.label || sid}</text>`;\n        if (s.text) {\n          svg += `<text x=\"${s.cx - w/2 + 12}\" y=\"${s.cy - h/2 + 42}\" fill=\"#737373\" font-size=\"10\" font-family=\"-apple-system, sans-serif\">${(s.text || '').substring(0, 32)}</text>`;\n        }\n        if (isAct) {\n          svg += `<circle cx=\"${s.cx + w/2 - 12}\" cy=\"${s.cy - h/2 + 12}\" r=\"4\" fill=\"#DE2626\" />`;\n        }\n        svg += `</g>`;\n      });\n\n      svg += `</g>`;\n\n      if (st.badge_text) {\n        svg += `<g id=\"canvas-hud\">\n          <rect x=\"20\" y=\"20\" width=\"300\" height=\"34\" rx=\"4\" fill=\"#0c0c12\" fill-opacity=\"0.9\" stroke=\"#22222c\" stroke-width=\"1\" />\n          <circle cx=\"34\" cy=\"37\" r=\"4\" fill=\"#DE2626\" />\n          <text x=\"48\" y=\"41\" fill=\"#FFFFFF\" font-size=\"11\" font-family=\"monospace\" font-weight=\"bold\">${st.badge_text.toUpperCase()}</text>\n        </g>`;\n      }\n\n      svg += `</svg>`;\n      slot.innerHTML = svg;\n      window.isReadyToCapture = true;\n    };\n\n    window.pauseAnimation = function() {\n      document.querySelectorAll('#capture-stage *').forEach(el => {\n        el.style.animationPlayState = 'paused';\n      });\n    };\n\n    window.playAnimation = function() {\n      document.querySelectorAll('#capture-stage *').forEach(el => {\n        el.style.animationPlayState = 'running';\n      });\n    };\n  </script>\n</body>\n</html>\n",
      "6d982a2a09609c2f9078a15a95fe09309ac9572558a7044d1bb00c1104bdd10f"
    ],
    [
      "5ce0950a-04f0-4aee-8980-b6f8d8c7595e",
      "game_sprite_sheet_studio_512",
      "template_game_sprite_sheet_studio.html",
      "game_stage",
      512,
      512,
      "1:1",
      "#capture-stage",
      "512x512 Game Sprite Sheet Studio blank-slate stage with 16/32/48/64px cells, pivot reticles, window.setCellSvg(r,c,svg), and #isolated-cell export.",
      "<!DOCTYPE html>\n<!--\n  Name: template_game_sprite_sheet_studio.html\n  Description: Blank-slate game engine sprite sheet design, grid alignment, and Playwright capture stage.\n  Version: 105\n  Date Created: 2026-11-13\n  Author Credit: Elton Boehnen \u00b7 boehnenelton2024@gmail.com \u00b7 boehnenelton2024.pages.dev \u00b7 github.com/boehnenelton\n  License: PolyForm Noncommercial License 1.0.0\n  RELATIONAL_ID: 1dfbfc4d-733b-4e89-b9e2-b26284cf8f4b\n-->\n<html lang=\"en\">\n<head>\n  <meta charset=\"UTF-8\">\n  <title>Canvas Stage \u2014 Game Sprite Sheet Studio</title>\n  <style>\n    * {\n      box-sizing: border-box;\n      margin: 0;\n      padding: 0;\n    }\n    body {\n      background: #000000;\n      color: #FFFFFF;\n      width: 100vw;\n      height: 100vh;\n      display: flex;\n      flex-direction: column;\n      align-items: center;\n      justify-content: center;\n      overflow: hidden;\n      font-family: -apple-system, BlinkMacSystemFont, \"Segoe UI\", Roboto, monospace;\n      image-rendering: pixelated;\n      image-rendering: crisp-edges;\n    }\n    body.theme-light {\n      background: #FFFFFF;\n      color: #000000;\n    }\n    body.theme-transparent {\n      background: transparent !important;\n    }\n\n    /* Fixed capture stage */\n    #capture-stage {\n      position: relative;\n      width: 512px;\n      height: 512px;\n      background: #000000;\n      border: 1px solid #1c1c24;\n      overflow: hidden;\n      display: flex;\n      align-items: center;\n      justify-content: center;\n      flex-shrink: 0;\n    }\n    body.theme-light #capture-stage {\n      background: #FFFFFF;\n      border-color: #E2E2E8;\n    }\n    body.theme-transparent #capture-stage {\n      background: transparent !important;\n      border-color: transparent !important;\n    }\n\n    /* Sprite sheet grid container */\n    #sprite-grid {\n      display: grid;\n      width: 100%;\n      height: 100%;\n      background: transparent;\n    }\n\n    /* Blank-slate sprite cell slots */\n    .sprite-cell {\n      position: relative;\n      border: 1px dashed rgba(255, 255, 255, 0.15);\n      display: flex;\n      flex-direction: column;\n      align-items: center;\n      justify-content: center;\n      overflow: hidden;\n    }\n    .sprite-cell.has-grid {\n      border: 1px solid rgba(222, 38, 38, 0.35);\n    }\n    .sprite-cell.active {\n      border: 1px solid #DE2626;\n      box-shadow: inset 0 0 8px rgba(222, 38, 38, 0.5);\n    }\n    .cell-label {\n      font-size: 8px;\n      font-family: monospace;\n      color: rgba(255, 255, 255, 0.3);\n      user-select: none;\n      pointer-events: none;\n    }\n    body.theme-light .cell-label {\n      color: rgba(0, 0, 0, 0.3);\n    }\n    .cell-pivot {\n      position: absolute;\n      width: 4px;\n      height: 4px;\n      background: #DE2626;\n      border-radius: 50%;\n      opacity: 0.4;\n      pointer-events: none;\n    }\n\n    /* Isolated cell view for single sprite export */\n    #isolated-cell {\n      position: absolute;\n      top: -9999px;\n      left: -9999px;\n      background: #000000;\n      overflow: hidden;\n    }\n    body.mode-isolated #capture-stage {\n      display: none;\n    }\n    body.mode-isolated #isolated-cell {\n      position: relative;\n      top: 0;\n      left: 0;\n      border: 1px solid #DE2626;\n      box-shadow: 0 0 16px rgba(222, 38, 38, 0.5);\n    }\n\n    /* Minimal studio toolbar */\n    #studio-bar {\n      position: fixed;\n      top: 12px;\n      display: flex;\n      gap: 8px;\n      align-items: center;\n      background: rgba(10, 10, 14, 0.85);\n      border: 1px solid #22222a;\n      padding: 6px 14px;\n      border-radius: 6px;\n      z-index: 100;\n    }\n    body.ui-hide #studio-bar {\n      display: none;\n    }\n    .bar-btn {\n      background: #181820;\n      border: 1px solid #333340;\n      color: #FFFFFF;\n      font-size: 11px;\n      font-family: monospace;\n      padding: 4px 10px;\n      cursor: pointer;\n      border-radius: 4px;\n    }\n    .bar-btn.active {\n      background: #DE2626;\n      border-color: #f87171;\n    }\n    .bar-info {\n      font-size: 11px;\n      font-family: monospace;\n      color: #888899;\n      margin-left: 8px;\n    }\n  </style>\n</head>\n<body>\n  <div id=\"studio-bar\">\n    <span style=\"color:#DE2626; font-weight:bold; font-size:12px; font-family:monospace;\">SPRITE_STUDIO</span>\n    <button class=\"bar-btn active\" id=\"btn-grid\" onclick=\"toggleGrid()\">GRID: ON</button>\n    <button class=\"bar-btn\" id=\"btn-size-16\" onclick=\"setCellSize(16)\">16x16</button>\n    <button class=\"bar-btn active\" id=\"btn-size-32\" onclick=\"setCellSize(32)\">32x32</button>\n    <button class=\"bar-btn\" id=\"btn-size-48\" onclick=\"setCellSize(48)\">48x48</button>\n    <button class=\"bar-btn\" id=\"btn-size-64\" onclick=\"setCellSize(64)\">64x64</button>\n    <button class=\"bar-btn\" id=\"btn-theme\" onclick=\"toggleTheme()\">THEME</button>\n    <span class=\"bar-info\" id=\"bar-status\">512x512 | 16x16 CELLS</span>\n  </div>\n\n  <div id=\"capture-stage\">\n    <div id=\"sprite-grid\"></div>\n  </div>\n\n  <div id=\"isolated-cell\"></div>\n\n  <script>\n    window.isReadyToCapture = false;\n\n    // URL Query Parameters\n    const params = new URLSearchParams(window.location.search);\n    let cellSize = parseInt(params.get('cell') || '32', 10);\n    const canvasSize = parseInt(params.get('canvas') || '512', 10);\n    const bgParam = params.get('bg') || 'dark';\n    const modeParam = params.get('mode') || 'stage'; // 'stage' or 'isolated'\n    const uiParam = params.get('ui') || 'show';\n    let showGrid = params.get('grid') !== 'off';\n\n    const stageEl = document.getElementById('capture-stage');\n    const gridEl = document.getElementById('sprite-grid');\n    const isolatedEl = document.getElementById('isolated-cell');\n\n    stageEl.style.width = `${canvasSize}px`;\n    stageEl.style.height = `${canvasSize}px`;\n\n    if (bgParam === 'light') document.body.classList.add('theme-light');\n    if (bgParam === 'transparent') document.body.classList.add('theme-transparent');\n    if (uiParam === 'hide') document.body.classList.add('ui-hide');\n    if (modeParam === 'isolated') document.body.classList.add('mode-isolated');\n\n    function rebuildGrid() {\n      gridEl.innerHTML = '';\n      const cols = Math.floor(canvasSize / cellSize);\n      const rows = Math.floor(canvasSize / cellSize);\n      gridEl.style.gridTemplateColumns = `repeat(${cols}, ${cellSize}px)`;\n      gridEl.style.gridTemplateRows = `repeat(${rows}, ${cellSize}px)`;\n\n      for (let r = 0; r < rows; r++) {\n        for (let c = 0; c < cols; c++) {\n          const cell = document.createElement('div');\n          cell.className = 'sprite-cell' + (showGrid ? ' has-grid' : '');\n          cell.setAttribute('data-row', r);\n          cell.setAttribute('data-col', c);\n          cell.id = `cell-${r}-${c}`;\n\n          if (cellSize >= 32) {\n            const lbl = document.createElement('span');\n            lbl.className = 'cell-label';\n            lbl.textContent = `[${r},${c}]`;\n            cell.appendChild(lbl);\n          }\n\n          const pivot = document.createElement('div');\n          pivot.className = 'cell-pivot';\n          cell.appendChild(pivot);\n\n          cell.addEventListener('click', () => selectCell(r, c));\n          gridEl.appendChild(cell);\n        }\n      }\n\n      document.getElementById('bar-status').textContent = `${canvasSize}x${canvasSize} | ${cols}x${rows} (${cellSize}px)`;\n    }\n\n    function setCellSize(size) {\n      cellSize = size;\n      ['16', '32', '48', '64'].forEach(s => {\n        document.getElementById(`btn-size-${s}`)?.classList.remove('active');\n      });\n      document.getElementById(`btn-size-${size}`)?.classList.add('active');\n      rebuildGrid();\n    }\n\n    function toggleGrid() {\n      showGrid = !showGrid;\n      document.getElementById('btn-grid').classList.toggle('active', showGrid);\n      document.getElementById('btn-grid').textContent = `GRID: ${showGrid ? 'ON' : 'OFF'}`;\n      document.querySelectorAll('.sprite-cell').forEach(c => c.classList.toggle('has-grid', showGrid));\n    }\n\n    function toggleTheme() {\n      if (document.body.classList.contains('theme-light')) {\n        document.body.classList.remove('theme-light');\n        document.body.classList.add('theme-transparent');\n      } else if (document.body.classList.contains('theme-transparent')) {\n        document.body.classList.remove('theme-transparent');\n      } else {\n        document.body.classList.add('theme-light');\n      }\n    }\n\n    function selectCell(r, c) {\n      document.querySelectorAll('.sprite-cell').forEach(el => el.classList.remove('active'));\n      const activeCell = document.getElementById(`cell-${r}-${c}`);\n      if (activeCell) activeCell.classList.add('active');\n\n      isolatedEl.style.width = `${cellSize}px`;\n      isolatedEl.style.height = `${cellSize}px`;\n      const svgEl = activeCell ? activeCell.querySelector('svg') : null;\n      isolatedEl.innerHTML = svgEl ? svgEl.outerHTML : (activeCell ? activeCell.innerHTML : '');\n    }\n\n    function setCellSvg(r, c, svgMarkup, labelText) {\n      const cell = document.getElementById(`cell-${r}-${c}`);\n      if (!cell) return;\n      cell.innerHTML = `<div style=\"width:100%;height:100%;display:flex;align-items:center;justify-content:center;\">${svgMarkup}</div>`;\n      if (labelText && showGrid) {\n        const lbl = document.createElement('span');\n        lbl.className = 'cell-label';\n        lbl.style.position = 'absolute';\n        lbl.style.bottom = '1px';\n        lbl.style.left = '2px';\n        lbl.style.fontSize = '7px';\n        lbl.style.background = 'rgba(0,0,0,0.65)';\n        lbl.style.padding = '0 2px';\n        lbl.textContent = labelText;\n        cell.appendChild(lbl);\n      }\n    }\n\n    function isolateSvg(widthPx, heightPx, svgMarkup, transparentBg) {\n      if (transparentBg !== false) {\n        document.body.classList.add('theme-transparent');\n        isolatedEl.style.background = 'transparent';\n        isolatedEl.style.border = 'none';\n        isolatedEl.style.boxShadow = 'none';\n      }\n      document.body.classList.add('ui-hide');\n      document.body.classList.add('mode-isolated');\n      isolatedEl.style.width = `${widthPx}px`;\n      isolatedEl.style.height = `${heightPx}px`;\n      isolatedEl.innerHTML = svgMarkup;\n      window.isReadyToCapture = true;\n    }\n\n    // Playwright Automation API\n    window.selectCell = selectCell;\n    window.setCellSize = setCellSize;\n    window.setCellSvg = setCellSvg;\n    window.isolateSvg = isolateSvg;\n    window.toggleGrid = toggleGrid;\n    window.setMode = function(mode) {\n      document.body.classList.toggle('mode-isolated', mode === 'isolated');\n    };\n    window.setSvgContent = function(svgMarkup) {\n      gridEl.style.display = 'flex';\n      gridEl.style.alignItems = 'center';\n      gridEl.style.justifyContent = 'center';\n      gridEl.innerHTML = svgMarkup;\n      window.isReadyToCapture = true;\n    };\n    window.seekProgress = function(ratio) {};\n    window.pauseAnimation = function() {};\n    window.playAnimation = function() {};\n\n    rebuildGrid();\n    window.isReadyToCapture = true;\n  </script>\n</body>\n</html>\n",
      "9f123462ce1511d17c186b731f0997cfc5e2b34c86442cc2d9cc6f7e46ceed10"
    ],
    [
      "d8fe1ca5-017f-407a-a09a-432fb1e6737f",
      "game_sprite_animation_stage_400",
      "template_game_sprite_animation_stage.html",
      "game_stage",
      400,
      400,
      "1:1",
      "#capture-stage",
      "400x400 Game Sprite Animation Stage with 2x/4x/8x zoom, onion skinning ghost layer, 4-frame pill strip, and window.setAnimationFrames(frames,label).",
      "<!DOCTYPE html>\n<!--\n  Name: template_game_sprite_animation_stage.html\n  Description: Blank-slate game engine sprite animation timeline, frame stepping, and Playwright capture stage.\n  Version: 105\n  Date Created: 2026-11-13\n  Author Credit: Elton Boehnen \u00b7 boehnenelton2024@gmail.com \u00b7 boehnenelton2024.pages.dev \u00b7 github.com/boehnenelton\n  License: PolyForm Noncommercial License 1.0.0\n  RELATIONAL_ID: 1dfbfc4d-733b-4e89-b9e2-b26284cf8f4b\n-->\n<html lang=\"en\">\n<head>\n  <meta charset=\"UTF-8\">\n  <title>Canvas Stage \u2014 Game Sprite Animation Stage</title>\n  <style>\n    * {\n      box-sizing: border-box;\n      margin: 0;\n      padding: 0;\n    }\n    body {\n      background: #000000;\n      color: #FFFFFF;\n      width: 100vw;\n      height: 100vh;\n      display: flex;\n      flex-direction: column;\n      align-items: center;\n      justify-content: center;\n      overflow: hidden;\n      font-family: -apple-system, BlinkMacSystemFont, \"Segoe UI\", Roboto, monospace;\n      image-rendering: pixelated;\n      image-rendering: crisp-edges;\n    }\n    body.theme-light {\n      background: #FFFFFF;\n      color: #000000;\n    }\n    body.theme-transparent {\n      background: transparent !important;\n    }\n\n    /* Fixed capture stage */\n    #capture-stage {\n      position: relative;\n      width: 400px;\n      height: 400px;\n      background: #000000;\n      border: 1px solid #1c1c24;\n      overflow: hidden;\n      display: flex;\n      flex-direction: column;\n      align-items: center;\n      justify-content: space-between;\n      flex-shrink: 0;\n      padding: 16px;\n    }\n    body.theme-light #capture-stage {\n      background: #FFFFFF;\n      border-color: #E2E2E8;\n    }\n    body.theme-transparent #capture-stage {\n      background: transparent !important;\n      border-color: transparent !important;\n    }\n\n    /* Viewport area for active frame */\n    #viewport-container {\n      position: relative;\n      width: 256px;\n      height: 256px;\n      display: flex;\n      align-items: center;\n      justify-content: center;\n      border: 1px dashed rgba(255, 255, 255, 0.2);\n      background: rgba(18, 18, 24, 0.5);\n    }\n    body.theme-light #viewport-container {\n      background: rgba(240, 240, 245, 0.5);\n      border-color: rgba(0, 0, 0, 0.2);\n    }\n\n    /* Crosshairs & Bounding Box Guides */\n    .crosshair-h {\n      position: absolute;\n      width: 100%;\n      height: 1px;\n      background: rgba(222, 38, 38, 0.4);\n      top: 50%;\n      pointer-events: none;\n    }\n    .crosshair-v {\n      position: absolute;\n      width: 1px;\n      height: 100%;\n      background: rgba(222, 38, 38, 0.4);\n      left: 50%;\n      pointer-events: none;\n    }\n    .bounding-box {\n      position: absolute;\n      width: 64px;\n      height: 64px;\n      border: 1px solid #DE2626;\n      pointer-events: none;\n    }\n\n    /* Active Sprite Slot */\n    #sprite-frame-slot {\n      position: relative;\n      width: 64px;\n      height: 64px;\n      display: flex;\n      align-items: center;\n      justify-content: center;\n      transform: scale(var(--zoom-scale, 2));\n      transform-origin: center;\n    }\n\n    /* Onion Skinning Ghost Layer */\n    #onion-skin-slot {\n      position: absolute;\n      width: 64px;\n      height: 64px;\n      opacity: 0.25;\n      pointer-events: none;\n      display: none;\n      transform: scale(var(--zoom-scale, 2));\n      transform-origin: center;\n    }\n    #onion-skin-slot.active {\n      display: flex;\n    }\n\n    /* Timeline Frame Strip */\n    #timeline-strip {\n      width: 100%;\n      display: flex;\n      gap: 8px;\n      justify-content: center;\n      background: rgba(10, 10, 14, 0.8);\n      padding: 8px;\n      border-radius: 4px;\n      border: 1px solid #22222a;\n    }\n    .frame-pill {\n      flex: 1;\n      height: 36px;\n      display: flex;\n      flex-direction: column;\n      align-items: center;\n      justify-content: center;\n      background: #14141a;\n      border: 1px solid #2d2d38;\n      border-radius: 4px;\n      font-size: 9px;\n      font-family: monospace;\n      color: #888899;\n      cursor: pointer;\n    }\n    .frame-pill.active {\n      background: #DE2626;\n      border-color: #f87171;\n      color: #FFFFFF;\n      font-weight: bold;\n    }\n\n    /* Minimal studio toolbar */\n    #studio-bar {\n      position: fixed;\n      top: 12px;\n      display: flex;\n      gap: 8px;\n      align-items: center;\n      background: rgba(10, 10, 14, 0.85);\n      border: 1px solid #22222a;\n      padding: 6px 14px;\n      border-radius: 6px;\n      z-index: 100;\n    }\n    body.ui-hide #studio-bar {\n      display: none;\n    }\n    .bar-btn {\n      background: #181820;\n      border: 1px solid #333340;\n      color: #FFFFFF;\n      font-size: 11px;\n      font-family: monospace;\n      padding: 4px 10px;\n      cursor: pointer;\n      border-radius: 4px;\n    }\n    .bar-btn.active {\n      background: #DE2626;\n      border-color: #f87171;\n    }\n    .bar-info {\n      font-size: 11px;\n      font-family: monospace;\n      color: #888899;\n      margin-left: 8px;\n    }\n  </style>\n</head>\n<body>\n  <div id=\"studio-bar\">\n    <span style=\"color:#DE2626; font-weight:bold; font-size:12px; font-family:monospace;\">ANIM_STAGE</span>\n    <button class=\"bar-btn\" id=\"btn-play\" onclick=\"togglePlay()\">PLAY</button>\n    <button class=\"bar-btn active\" id=\"btn-zoom-2\" onclick=\"setZoom(2)\">2x</button>\n    <button class=\"bar-btn\" id=\"btn-zoom-4\" onclick=\"setZoom(4)\">4x</button>\n    <button class=\"bar-btn\" id=\"btn-zoom-8\" onclick=\"setZoom(8)\">8x</button>\n    <button class=\"bar-btn\" id=\"btn-onion\" onclick=\"toggleOnionSkin()\">ONION: OFF</button>\n    <button class=\"bar-btn\" id=\"btn-theme\" onclick=\"toggleTheme()\">THEME</button>\n    <span class=\"bar-info\" id=\"bar-status\">FPS: 12 | FRAME 1/4</span>\n  </div>\n\n  <div id=\"capture-stage\">\n    <div id=\"viewport-container\">\n      <div class=\"crosshair-h\"></div>\n      <div class=\"crosshair-v\"></div>\n      <div class=\"bounding-box\"></div>\n      <div id=\"onion-skin-slot\"></div>\n      <div id=\"sprite-frame-slot\"></div>\n    </div>\n\n    <div id=\"timeline-strip\">\n      <div class=\"frame-pill active\" id=\"pill-0\" onclick=\"setFrame(0)\">FRAME 1</div>\n      <div class=\"frame-pill\" id=\"pill-1\" onclick=\"setFrame(1)\">FRAME 2</div>\n      <div class=\"frame-pill\" id=\"pill-2\" onclick=\"setFrame(2)\">FRAME 3</div>\n      <div class=\"frame-pill\" id=\"pill-3\" onclick=\"setFrame(3)\">FRAME 4</div>\n    </div>\n  </div>\n\n  <script>\n    window.isReadyToCapture = false;\n\n    const params = new URLSearchParams(window.location.search);\n    const bgParam = params.get('bg') || 'dark';\n    const uiParam = params.get('ui') || 'show';\n    const fpsParam = parseInt(params.get('fps') || '12', 10);\n    const totalFrames = parseInt(params.get('frames') || '4', 10);\n\n    let currentFrame = 0;\n    let isPlaying = false;\n    let playTimer = null;\n    let onionSkinActive = false;\n    let zoomScale = 2;\n    let customSvgFrames = [];\n    let animNameLabel = 'SPRITE_ANIM';\n\n    if (bgParam === 'light') document.body.classList.add('theme-light');\n    if (bgParam === 'transparent') document.body.classList.add('theme-transparent');\n    if (uiParam === 'hide') document.body.classList.add('ui-hide');\n\n    function setFrame(idx) {\n      const numFrames = customSvgFrames.length > 0 ? customSvgFrames.length : totalFrames;\n      const prevFrame = (idx - 1 + numFrames) % numFrames;\n      currentFrame = idx % numFrames;\n\n      const pillIdx = currentFrame % 4;\n      document.querySelectorAll('.frame-pill').forEach((p, i) => {\n        p.classList.toggle('active', i === pillIdx);\n      });\n\n      const frameSlot = document.getElementById('sprite-frame-slot');\n      const onionSlot = document.getElementById('onion-skin-slot');\n\n      if (onionSkinActive) {\n        if (customSvgFrames.length > 0 && customSvgFrames[prevFrame]) {\n          onionSlot.innerHTML = customSvgFrames[prevFrame];\n        } else {\n          onionSlot.innerHTML = `<span style=\"font-size:8px; font-family:monospace; color:#888;\">GHOST_${prevFrame+1}</span>`;\n        }\n      }\n\n      if (customSvgFrames.length > 0 && customSvgFrames[currentFrame]) {\n        frameSlot.innerHTML = customSvgFrames[currentFrame];\n      } else {\n        frameSlot.innerHTML = `<span style=\"font-size:9px; font-family:monospace; color:#FFF; font-weight:bold;\">FRAME_${currentFrame+1}</span>`;\n      }\n      document.getElementById('bar-status').textContent = `${animNameLabel} | FPS: ${fpsParam} | FRAME ${currentFrame+1}/${numFrames}`;\n    }\n\n    function setAnimationFrames(svgFramesArray, label, enableOnion) {\n      customSvgFrames = Array.isArray(svgFramesArray) ? svgFramesArray : [];\n      if (label) animNameLabel = label;\n      if (enableOnion !== undefined) {\n        onionSkinActive = !!enableOnion;\n        const btn = document.getElementById('btn-onion');\n        if (btn) {\n          btn.textContent = `ONION: ${onionSkinActive ? 'ON' : 'OFF'}`;\n          btn.classList.toggle('active', onionSkinActive);\n        }\n        document.getElementById('onion-skin-slot').classList.toggle('active', onionSkinActive);\n      }\n      setFrame(0);\n      window.isReadyToCapture = true;\n    }\n\n    function setZoom(scale) {\n      zoomScale = scale;\n      document.documentElement.style.setProperty('--zoom-scale', scale);\n      ['2', '4', '8'].forEach(s => {\n        document.getElementById(`btn-zoom-${s}`)?.classList.remove('active');\n      });\n      document.getElementById(`btn-zoom-${scale}`)?.classList.add('active');\n    }\n\n    function togglePlay() {\n      isPlaying = !isPlaying;\n      const btn = document.getElementById('btn-play');\n      btn.textContent = isPlaying ? 'PAUSE' : 'PLAY';\n      btn.classList.toggle('active', isPlaying);\n\n      if (isPlaying) {\n        playTimer = setInterval(() => {\n          const numFrames = customSvgFrames.length > 0 ? customSvgFrames.length : totalFrames;\n          setFrame((currentFrame + 1) % numFrames);\n        }, 1000 / fpsParam);\n      } else {\n        clearInterval(playTimer);\n        playTimer = null;\n      }\n    }\n\n    function toggleOnionSkin() {\n      onionSkinActive = !onionSkinActive;\n      const btn = document.getElementById('btn-onion');\n      btn.textContent = `ONION: ${onionSkinActive ? 'ON' : 'OFF'}`;\n      btn.classList.toggle('active', onionSkinActive);\n      document.getElementById('onion-skin-slot').classList.toggle('active', onionSkinActive);\n    }\n\n    function toggleTheme() {\n      if (document.body.classList.contains('theme-light')) {\n        document.body.classList.remove('theme-light');\n        document.body.classList.add('theme-transparent');\n      } else if (document.body.classList.contains('theme-transparent')) {\n        document.body.classList.remove('theme-transparent');\n      } else {\n        document.body.classList.add('theme-light');\n      }\n    }\n\n    // Playwright Automation API\n    window.setFrame = setFrame;\n    window.setZoom = setZoom;\n    window.setAnimationFrames = setAnimationFrames;\n    window.toggleOnionSkin = toggleOnionSkin;\n    window.setSvgContent = function(svgMarkup) {\n      const frameSlot = document.getElementById('sprite-frame-slot');\n      if (frameSlot) {\n        if (onionSkinActive && frameSlot.innerHTML && !frameSlot.innerHTML.includes('FRAME_')) {\n          document.getElementById('onion-skin-slot').innerHTML = frameSlot.innerHTML;\n        }\n        frameSlot.innerHTML = svgMarkup;\n      }\n      window.isReadyToCapture = true;\n    };\n    window.pauseAnimation = function() {\n      if (isPlaying) togglePlay();\n    };\n    window.playAnimation = function() {\n      if (!isPlaying) togglePlay();\n    };\n    window.seekProgress = function(ratio) {\n      const numFrames = customSvgFrames.length > 0 ? customSvgFrames.length : totalFrames;\n      const targetFrame = Math.min(numFrames - 1, Math.floor(ratio * numFrames));\n      setFrame(targetFrame);\n    };\n\n    setFrame(0);\n    setZoom(2);\n    window.isReadyToCapture = true;\n  </script>\n</body>\n</html>\n",
      "c3086b283685f663fef8f803099affabf1714fb70233532e5e53b8e9d32a664b"
    ],
    [
      "1f2c0e88-4e31-44e3-89d2-7540fbefc91f",
      "game_tilemap_palette_stage_512",
      "template_game_tilemap_palette_stage.html",
      "game_stage",
      512,
      512,
      "1:1",
      "#capture-stage",
      "512x512 Game Tilemap Palette Stage with 16/32/64px tiles, solid/passable collision badges (X/O), window.setTileSvg(r,c,svg,solid), and #isolated-tile export.",
      "<!DOCTYPE html>\n<!--\n  Name: template_game_tilemap_palette_stage.html\n  Description: Blank-slate game engine tilemap palette, autotile matrix, collision flags, and Playwright capture stage.\n  Version: 105\n  Date Created: 2026-11-13\n  Author Credit: Elton Boehnen \u00b7 boehnenelton2024@gmail.com \u00b7 boehnenelton2024.pages.dev \u00b7 github.com/boehnenelton\n  License: PolyForm Noncommercial License 1.0.0\n  RELATIONAL_ID: 1dfbfc4d-733b-4e89-b9e2-b26284cf8f4b\n-->\n<html lang=\"en\">\n<head>\n  <meta charset=\"UTF-8\">\n  <title>Canvas Stage \u2014 Game Tilemap Palette Stage</title>\n  <style>\n    * {\n      box-sizing: border-box;\n      margin: 0;\n      padding: 0;\n    }\n    body {\n      background: #000000;\n      color: #FFFFFF;\n      width: 100vw;\n      height: 100vh;\n      display: flex;\n      flex-direction: column;\n      align-items: center;\n      justify-content: center;\n      overflow: hidden;\n      font-family: -apple-system, BlinkMacSystemFont, \"Segoe UI\", Roboto, monospace;\n      image-rendering: pixelated;\n      image-rendering: crisp-edges;\n    }\n    body.theme-light {\n      background: #FFFFFF;\n      color: #000000;\n    }\n    body.theme-transparent {\n      background: transparent !important;\n    }\n\n    /* Fixed capture stage */\n    #capture-stage {\n      position: relative;\n      width: 512px;\n      height: 512px;\n      background: #000000;\n      border: 1px solid #1c1c24;\n      overflow: hidden;\n      display: flex;\n      align-items: center;\n      justify-content: center;\n      flex-shrink: 0;\n    }\n    body.theme-light #capture-stage {\n      background: #FFFFFF;\n      border-color: #E2E2E8;\n    }\n    body.theme-transparent #capture-stage {\n      background: transparent !important;\n      border-color: transparent !important;\n    }\n\n    /* Tile grid container */\n    #tile-grid {\n      display: grid;\n      width: 100%;\n      height: 100%;\n      background: transparent;\n    }\n\n    /* Blank-slate tile slots */\n    .tile-slot {\n      position: relative;\n      border: 1px solid rgba(255, 255, 255, 0.12);\n      display: flex;\n      flex-direction: column;\n      align-items: center;\n      justify-content: center;\n      overflow: hidden;\n      cursor: pointer;\n    }\n    .tile-slot.solid {\n      background: rgba(222, 38, 38, 0.08);\n      border-color: rgba(222, 38, 38, 0.4);\n    }\n    .tile-slot.active {\n      border: 1.5px solid #DE2626;\n      box-shadow: inset 0 0 10px rgba(222, 38, 38, 0.6);\n    }\n    .tile-label {\n      font-size: 8px;\n      font-family: monospace;\n      color: rgba(255, 255, 255, 0.35);\n      user-select: none;\n      pointer-events: none;\n    }\n    body.theme-light .tile-label {\n      color: rgba(0, 0, 0, 0.35);\n    }\n    .collision-badge {\n      position: absolute;\n      top: 2px;\n      right: 2px;\n      font-size: 7px;\n      font-family: monospace;\n      padding: 1px 3px;\n      border-radius: 2px;\n      display: none;\n    }\n    body.show-collision .collision-badge {\n      display: block;\n    }\n    .collision-badge.solid {\n      background: #DE2626;\n      color: #FFFFFF;\n    }\n    .collision-badge.pass {\n      background: #181820;\n      color: #888899;\n      border: 1px solid #333340;\n    }\n\n    /* Isolated single tile view */\n    #isolated-tile {\n      position: absolute;\n      top: -9999px;\n      left: -9999px;\n      background: #000000;\n      overflow: hidden;\n    }\n    body.mode-isolated #capture-stage {\n      display: none;\n    }\n    body.mode-isolated #isolated-tile {\n      position: relative;\n      top: 0;\n      left: 0;\n      border: 1px solid #DE2626;\n      box-shadow: 0 0 16px rgba(222, 38, 38, 0.5);\n    }\n\n    /* Minimal studio toolbar */\n    #studio-bar {\n      position: fixed;\n      top: 12px;\n      display: flex;\n      gap: 8px;\n      align-items: center;\n      background: rgba(10, 10, 14, 0.85);\n      border: 1px solid #22222a;\n      padding: 6px 14px;\n      border-radius: 6px;\n      z-index: 100;\n    }\n    body.ui-hide #studio-bar {\n      display: none;\n    }\n    .bar-btn {\n      background: #181820;\n      border: 1px solid #333340;\n      color: #FFFFFF;\n      font-size: 11px;\n      font-family: monospace;\n      padding: 4px 10px;\n      cursor: pointer;\n      border-radius: 4px;\n    }\n    .bar-btn.active {\n      background: #DE2626;\n      border-color: #f87171;\n    }\n    .bar-info {\n      font-size: 11px;\n      font-family: monospace;\n      color: #888899;\n      margin-left: 8px;\n    }\n  </style>\n</head>\n<body>\n  <div id=\"studio-bar\">\n    <span style=\"color:#DE2626; font-weight:bold; font-size:12px; font-family:monospace;\">TILE_STUDIO</span>\n    <button class=\"bar-btn\" id=\"btn-size-16\" onclick=\"setTileSize(16)\">16x16</button>\n    <button class=\"bar-btn active\" id=\"btn-size-32\" onclick=\"setTileSize(32)\">32x32</button>\n    <button class=\"bar-btn\" id=\"btn-size-64\" onclick=\"setTileSize(64)\">64x64</button>\n    <button class=\"bar-btn\" id=\"btn-col\" onclick=\"toggleCollision()\">COLLISION: OFF</button>\n    <button class=\"bar-btn\" id=\"btn-theme\" onclick=\"toggleTheme()\">THEME</button>\n    <span class=\"bar-info\" id=\"bar-status\">512x512 | 16x16 TILES (32px)</span>\n  </div>\n\n  <div id=\"capture-stage\">\n    <div id=\"tile-grid\"></div>\n  </div>\n\n  <div id=\"isolated-tile\"></div>\n\n  <script>\n    window.isReadyToCapture = false;\n\n    const params = new URLSearchParams(window.location.search);\n    let tileSize = parseInt(params.get('tilesize') || '32', 10);\n    const canvasSize = parseInt(params.get('canvas') || '512', 10);\n    const bgParam = params.get('bg') || 'dark';\n    const modeParam = params.get('mode') || 'stage';\n    const uiParam = params.get('ui') || 'show';\n    let showCollision = params.get('collision') === 'on';\n\n    const stageEl = document.getElementById('capture-stage');\n    const gridEl = document.getElementById('tile-grid');\n    const isolatedEl = document.getElementById('isolated-tile');\n\n    stageEl.style.width = `${canvasSize}px`;\n    stageEl.style.height = `${canvasSize}px`;\n\n    if (bgParam === 'light') document.body.classList.add('theme-light');\n    if (bgParam === 'transparent') document.body.classList.add('theme-transparent');\n    if (uiParam === 'hide') document.body.classList.add('ui-hide');\n    if (modeParam === 'isolated') document.body.classList.add('mode-isolated');\n    if (showCollision) document.body.classList.add('show-collision');\n\n    function rebuildTiles() {\n      gridEl.innerHTML = '';\n      const cols = Math.floor(canvasSize / tileSize);\n      const rows = Math.floor(canvasSize / tileSize);\n      gridEl.style.gridTemplateColumns = `repeat(${cols}, ${tileSize}px)`;\n      gridEl.style.gridTemplateRows = `repeat(${rows}, ${tileSize}px)`;\n\n      for (let r = 0; r < rows; r++) {\n        for (let c = 0; c < cols; c++) {\n          const tile = document.createElement('div');\n          const isBoundary = r === 0 || r === rows - 1 || c === 0 || c === cols - 1;\n          tile.className = 'tile-slot' + (isBoundary ? ' solid' : '');\n          tile.setAttribute('data-row', r);\n          tile.setAttribute('data-col', c);\n          tile.id = `tile-${r}-${c}`;\n\n          if (tileSize >= 32) {\n            const lbl = document.createElement('span');\n            lbl.className = 'tile-label';\n            lbl.textContent = `T[${r},${c}]`;\n            tile.appendChild(lbl);\n          }\n\n          const badge = document.createElement('span');\n          badge.className = `collision-badge ${isBoundary ? 'solid' : 'pass'}`;\n          badge.textContent = isBoundary ? 'X' : 'O';\n          tile.appendChild(badge);\n\n          tile.addEventListener('click', () => selectTile(r, c));\n          gridEl.appendChild(tile);\n        }\n      }\n\n      document.getElementById('bar-status').textContent = `${canvasSize}x${canvasSize} | ${cols}x${rows} (${tileSize}px)`;\n    }\n\n    function setTileSize(size) {\n      tileSize = size;\n      ['16', '32', '64'].forEach(s => {\n        document.getElementById(`btn-size-${s}`)?.classList.remove('active');\n      });\n      document.getElementById(`btn-size-${size}`)?.classList.add('active');\n      rebuildTiles();\n    }\n\n    function toggleCollision() {\n      showCollision = !showCollision;\n      document.body.classList.toggle('show-collision', showCollision);\n      const btn = document.getElementById('btn-col');\n      btn.textContent = `COLLISION: ${showCollision ? 'ON' : 'OFF'}`;\n      btn.classList.toggle('active', showCollision);\n    }\n\n    function toggleTheme() {\n      if (document.body.classList.contains('theme-light')) {\n        document.body.classList.remove('theme-light');\n        document.body.classList.add('theme-transparent');\n      } else if (document.body.classList.contains('theme-transparent')) {\n        document.body.classList.remove('theme-transparent');\n      } else {\n        document.body.classList.add('theme-light');\n      }\n    }\n\n    function selectTile(r, c) {\n      document.querySelectorAll('.tile-slot').forEach(el => el.classList.remove('active'));\n      const activeTile = document.getElementById(`tile-${r}-${c}`);\n      if (activeTile) activeTile.classList.add('active');\n\n      isolatedEl.style.width = `${tileSize}px`;\n      isolatedEl.style.height = `${tileSize}px`;\n      const svgEl = activeTile ? activeTile.querySelector('svg') : null;\n      isolatedEl.innerHTML = svgEl ? svgEl.outerHTML : (activeTile ? activeTile.innerHTML : '');\n    }\n\n    function setTileSvg(r, c, svgMarkup, isSolid, labelText) {\n      const tile = document.getElementById(`tile-${r}-${c}`);\n      if (!tile) return;\n      tile.classList.toggle('solid', !!isSolid);\n      tile.innerHTML = `<div style=\"width:100%;height:100%;display:flex;align-items:center;justify-content:center;\">${svgMarkup}</div>`;\n      const badge = document.createElement('span');\n      badge.className = `collision-badge ${isSolid ? 'solid' : 'pass'}`;\n      badge.textContent = isSolid ? 'X' : 'O';\n      tile.appendChild(badge);\n      if (labelText) {\n        const lbl = document.createElement('span');\n        lbl.className = 'tile-label';\n        lbl.style.position = 'absolute';\n        lbl.style.bottom = '1px';\n        lbl.style.left = '2px';\n        lbl.style.fontSize = '6px';\n        lbl.style.background = 'rgba(0,0,0,0.7)';\n        lbl.style.padding = '0 2px';\n        lbl.textContent = labelText;\n        tile.appendChild(lbl);\n      }\n    }\n\n    function isolateTileSvg(widthPx, heightPx, svgMarkup) {\n      document.body.classList.add('ui-hide');\n      document.body.classList.add('mode-isolated');\n      isolatedEl.style.border = 'none';\n      isolatedEl.style.boxShadow = 'none';\n      isolatedEl.style.width = `${widthPx}px`;\n      isolatedEl.style.height = `${heightPx}px`;\n      isolatedEl.innerHTML = svgMarkup;\n      window.isReadyToCapture = true;\n    }\n\n    // Playwright Automation API\n    window.selectTile = selectTile;\n    window.setTileSize = setTileSize;\n    window.setTileSvg = setTileSvg;\n    window.isolateTileSvg = isolateTileSvg;\n    window.toggleCollision = toggleCollision;\n    window.setMode = function(mode) {\n      document.body.classList.toggle('mode-isolated', mode === 'isolated');\n    };\n    window.setSvgContent = function(svgMarkup) {\n      gridEl.style.display = 'flex';\n      gridEl.style.alignItems = 'center';\n      gridEl.style.justifyContent = 'center';\n      gridEl.innerHTML = svgMarkup;\n      window.isReadyToCapture = true;\n    };\n    window.seekProgress = function(ratio) {};\n\n    rebuildTiles();\n    window.isReadyToCapture = true;\n  </script>\n</body>\n</html>\n",
      "3140c852d0e18081d4763dc5e7fdd69d97f6cf18888fa45c07d96a16edb8a75a"
    ],
    [
      "5d868042-12d0-41c3-9572-bf87a6f430d2",
      "game_hud_ui_stage_640",
      "template_game_hud_ui_stage.html",
      "game_stage",
      640,
      480,
      "4:3",
      "#capture-stage",
      "640x480 Game HUD & UI Stage with hearts, MP gauge, B/Y active item boxes, virtual gamepad controls, dialog letterbox, and #isolated-element export.",
      "<!DOCTYPE html>\n<!--\n  Name: template_game_hud_ui_stage.html\n  Description: Blank-slate game engine HUD, gauges, inventory frames, virtual controls, and Playwright capture stage.\n  Version: 105\n  Date Created: 2026-11-13\n  Author Credit: Elton Boehnen \u00b7 boehnenelton2024@gmail.com \u00b7 boehnenelton2024.pages.dev \u00b7 github.com/boehnenelton\n  License: PolyForm Noncommercial License 1.0.0\n  RELATIONAL_ID: 1dfbfc4d-733b-4e89-b9e2-b26284cf8f4b\n-->\n<html lang=\"en\">\n<head>\n  <meta charset=\"UTF-8\">\n  <title>Canvas Stage \u2014 Game HUD & UI Stage</title>\n  <style>\n    * {\n      box-sizing: border-box;\n      margin: 0;\n      padding: 0;\n    }\n    body {\n      background: #000000;\n      color: #FFFFFF;\n      width: 100vw;\n      height: 100vh;\n      display: flex;\n      flex-direction: column;\n      align-items: center;\n      justify-content: center;\n      overflow: hidden;\n      font-family: -apple-system, BlinkMacSystemFont, \"Segoe UI\", Roboto, monospace;\n      image-rendering: pixelated;\n      image-rendering: crisp-edges;\n    }\n    body.theme-light {\n      background: #FFFFFF;\n      color: #000000;\n    }\n    body.theme-transparent {\n      background: transparent !important;\n    }\n\n    /* Fixed capture stage */\n    #capture-stage {\n      position: relative;\n      width: 640px;\n      height: 480px;\n      background: #000000;\n      border: 1px solid #1c1c24;\n      overflow: hidden;\n      display: flex;\n      flex-direction: column;\n      justify-content: space-between;\n      flex-shrink: 0;\n      padding: 12px;\n    }\n    body.theme-light #capture-stage {\n      background: #FFFFFF;\n      border-color: #E2E2E8;\n    }\n    body.theme-transparent #capture-stage {\n      background: transparent !important;\n      border-color: transparent !important;\n    }\n\n    /* Top HUD Bar */\n    .hud-row-top {\n      width: 100%;\n      display: flex;\n      justify-content: space-between;\n      align-items: flex-start;\n      pointer-events: none;\n    }\n    .hud-group {\n      display: flex;\n      gap: 6px;\n      align-items: center;\n    }\n\n    /* Health containers */\n    .heart-slot {\n      width: 20px;\n      height: 20px;\n      border: 1px solid #DE2626;\n      background: rgba(222, 38, 38, 0.15);\n      display: flex;\n      align-items: center;\n      justify-content: center;\n      font-size: 8px;\n      font-family: monospace;\n      color: #DE2626;\n      cursor: pointer;\n      pointer-events: auto;\n    }\n\n    /* Magic gauge */\n    .gauge-container {\n      width: 90px;\n      height: 14px;\n      border: 1px solid #3b82f6;\n      background: rgba(59, 130, 246, 0.1);\n      display: flex;\n      align-items: center;\n      padding: 1px;\n      cursor: pointer;\n      pointer-events: auto;\n    }\n    .gauge-fill {\n      width: 60%;\n      height: 100%;\n      background: #3b82f6;\n    }\n    .gauge-label {\n      position: absolute;\n      font-size: 7px;\n      font-family: monospace;\n      color: #FFFFFF;\n      padding-left: 4px;\n    }\n\n    /* Active item boxes */\n    .item-box {\n      width: 36px;\n      height: 36px;\n      border: 1.5px solid #DE2626;\n      background: #101015;\n      display: flex;\n      flex-direction: column;\n      align-items: center;\n      justify-content: center;\n      font-size: 8px;\n      font-family: monospace;\n      color: #FFFFFF;\n      cursor: pointer;\n      pointer-events: auto;\n    }\n    .item-box-key {\n      font-size: 7px;\n      color: #DE2626;\n      font-weight: bold;\n    }\n\n    /* Center game arena placeholder */\n    .arena-placeholder {\n      width: 100%;\n      flex: 1;\n      display: flex;\n      align-items: center;\n      justify-content: center;\n      border: 1px dashed rgba(255, 255, 255, 0.1);\n      margin: 8px 0;\n      color: rgba(255, 255, 255, 0.2);\n      font-size: 10px;\n      font-family: monospace;\n      letter-spacing: 2px;\n      pointer-events: none;\n    }\n\n    /* Bottom HUD Virtual Controls Deck */\n    .hud-row-bottom {\n      width: 100%;\n      display: flex;\n      justify-content: space-between;\n      align-items: flex-end;\n      pointer-events: none;\n    }\n    .joystick-placeholder {\n      width: 72px;\n      height: 72px;\n      border: 1px dashed rgba(255, 255, 255, 0.3);\n      border-radius: 50%;\n      display: flex;\n      align-items: center;\n      justify-content: center;\n      font-size: 8px;\n      font-family: monospace;\n      color: #888899;\n      cursor: pointer;\n      pointer-events: auto;\n    }\n    .action-deck-placeholder {\n      display: grid;\n      grid-template-columns: repeat(2, 32px);\n      gap: 6px;\n      cursor: pointer;\n      pointer-events: auto;\n    }\n    .action-btn-placeholder {\n      width: 32px;\n      height: 32px;\n      border: 1px solid rgba(255, 255, 255, 0.4);\n      border-radius: 50%;\n      display: flex;\n      align-items: center;\n      justify-content: center;\n      font-size: 9px;\n      font-family: monospace;\n      color: #FFFFFF;\n      background: #141418;\n    }\n    .action-btn-placeholder.accent {\n      border-color: #DE2626;\n      color: #DE2626;\n    }\n\n    /* Dialog Box Letterbox Slot */\n    #dialog-box-slot {\n      position: absolute;\n      bottom: 12px;\n      left: 12px;\n      right: 12px;\n      height: 64px;\n      border: 1.5px solid #FFFFFF;\n      background: rgba(0, 0, 0, 0.9);\n      padding: 8px 12px;\n      display: none;\n      font-size: 9px;\n      font-family: monospace;\n      color: #FFFFFF;\n      line-height: 1.4;\n      pointer-events: auto;\n    }\n    #dialog-box-slot.active {\n      display: block;\n    }\n\n    /* Isolated element container */\n    #isolated-element {\n      position: absolute;\n      top: -9999px;\n      left: -9999px;\n      background: #000000;\n      overflow: hidden;\n      display: flex;\n      align-items: center;\n      justify-content: center;\n    }\n    body.mode-isolated #capture-stage {\n      display: none;\n    }\n    body.mode-isolated #isolated-element {\n      position: relative;\n      top: 0;\n      left: 0;\n      border: 1px solid #DE2626;\n      box-shadow: 0 0 16px rgba(222, 38, 38, 0.5);\n    }\n\n    /* Minimal studio toolbar */\n    #studio-bar {\n      position: fixed;\n      top: 12px;\n      display: flex;\n      gap: 8px;\n      align-items: center;\n      background: rgba(10, 10, 14, 0.85);\n      border: 1px solid #22222a;\n      padding: 6px 14px;\n      border-radius: 6px;\n      z-index: 100;\n    }\n    body.ui-hide #studio-bar {\n      display: none;\n    }\n    .bar-btn {\n      background: #181820;\n      border: 1px solid #333340;\n      color: #FFFFFF;\n      font-size: 11px;\n      font-family: monospace;\n      padding: 4px 10px;\n      cursor: pointer;\n      border-radius: 4px;\n    }\n    .bar-btn.active {\n      background: #DE2626;\n      border-color: #f87171;\n    }\n    .bar-info {\n      font-size: 11px;\n      font-family: monospace;\n      color: #888899;\n      margin-left: 8px;\n    }\n  </style>\n</head>\n<body>\n  <div id=\"studio-bar\">\n    <span style=\"color:#DE2626; font-weight:bold; font-size:12px; font-family:monospace;\">HUD_STAGE</span>\n    <button class=\"bar-btn\" id=\"btn-dialog\" onclick=\"toggleDialog()\">DIALOG: OFF</button>\n    <button class=\"bar-btn\" id=\"btn-iso-item\" onclick=\"isolateElement('.item-box')\">ISO: ITEM</button>\n    <button class=\"bar-btn\" id=\"btn-iso-heart\" onclick=\"isolateElement('.heart-slot')\">ISO: HEART</button>\n    <button class=\"bar-btn\" id=\"btn-reset\" onclick=\"resetStage()\">STAGE</button>\n    <button class=\"bar-btn\" id=\"btn-theme\" onclick=\"toggleTheme()\">THEME</button>\n    <span class=\"bar-info\">640x480 | GAME_HUD</span>\n  </div>\n\n  <div id=\"capture-stage\">\n    <!-- Top HUD Row -->\n    <div class=\"hud-row-top\">\n      <div class=\"hud-group\">\n        <div class=\"heart-slot\">H1</div>\n        <div class=\"heart-slot\">H2</div>\n        <div class=\"heart-slot\">H3</div>\n        <div class=\"heart-slot\">H4</div>\n        <div class=\"gauge-container\" style=\"position:relative;\">\n          <div class=\"gauge-fill\"></div>\n          <span class=\"gauge-label\">MP: 60%</span>\n        </div>\n      </div>\n      <div class=\"hud-group\">\n        <div class=\"item-box\">\n          <span class=\"item-box-key\">B</span>\n          <span>SWD</span>\n        </div>\n        <div class=\"item-box\">\n          <span class=\"item-box-key\">Y</span>\n          <span>ITM</span>\n        </div>\n      </div>\n    </div>\n\n    <!-- Arena Placeholder -->\n    <div class=\"arena-placeholder\">GAMEPLAY_CANVAS_VIEWPORT</div>\n\n    <!-- Bottom Controls Row -->\n    <div class=\"hud-row-bottom\">\n      <div class=\"joystick-placeholder\">JOYSTICK</div>\n      <div class=\"action-deck-placeholder\">\n        <div class=\"action-btn-placeholder\">X</div>\n        <div class=\"action-btn-placeholder\">Y</div>\n        <div class=\"action-btn-placeholder accent\">B</div>\n        <div class=\"action-btn-placeholder\">A</div>\n      </div>\n    </div>\n\n    <!-- Dialog Letterbox -->\n    <div id=\"dialog-box-slot\">\n      <span style=\"color:#DE2626; font-weight:bold;\">SPEAKER_NAME</span><br>\n      <span>[LITERAL_DIALOGUE_LINE_1_PLACEHOLDER]</span><br>\n      <span style=\"color:#888899;\">[LITERAL_DIALOGUE_LINE_2_PLACEHOLDER]</span>\n    </div>\n  </div>\n\n  <div id=\"isolated-element\"></div>\n\n  <script>\n    window.isReadyToCapture = false;\n\n    const params = new URLSearchParams(window.location.search);\n    const bgParam = params.get('bg') || 'dark';\n    const uiParam = params.get('ui') || 'show';\n    const dialogParam = params.get('dialog') === 'on';\n\n    if (bgParam === 'light') document.body.classList.add('theme-light');\n    if (bgParam === 'transparent') document.body.classList.add('theme-transparent');\n    if (uiParam === 'hide') document.body.classList.add('ui-hide');\n    if (dialogParam) document.getElementById('dialog-box-slot').classList.add('active');\n\n    function toggleDialog() {\n      const el = document.getElementById('dialog-box-slot');\n      const active = el.classList.toggle('active');\n      const btn = document.getElementById('btn-dialog');\n      btn.textContent = `DIALOG: ${active ? 'ON' : 'OFF'}`;\n      btn.classList.toggle('active', active);\n    }\n\n    function toggleTheme() {\n      if (document.body.classList.contains('theme-light')) {\n        document.body.classList.remove('theme-light');\n        document.body.classList.add('theme-transparent');\n      } else if (document.body.classList.contains('theme-transparent')) {\n        document.body.classList.remove('theme-transparent');\n      } else {\n        document.body.classList.add('theme-light');\n      }\n    }\n\n    function isolateElement(selector) {\n      const target = document.querySelector(selector);\n      if (!target) return;\n\n      const rect = target.getBoundingClientRect();\n      const iso = document.getElementById('isolated-element');\n      iso.style.width = `${Math.ceil(rect.width)}px`;\n      iso.style.height = `${Math.ceil(rect.height)}px`;\n      iso.innerHTML = target.outerHTML;\n\n      document.body.classList.add('mode-isolated');\n    }\n\n    function resetStage() {\n      document.body.classList.remove('mode-isolated');\n    }\n\n    function setHudState(cfg) {\n      if (!cfg) return;\n      if (Array.isArray(cfg.hearts)) {\n        const slots = document.querySelectorAll('.heart-slot');\n        slots.forEach((slot, i) => {\n          if (cfg.hearts[i]) {\n            slot.innerHTML = cfg.hearts[i];\n            slot.style.border = 'none';\n            slot.style.background = 'transparent';\n          }\n        });\n      }\n      if (Array.isArray(cfg.items)) {\n        const boxes = document.querySelectorAll('.item-box');\n        boxes.forEach((box, i) => {\n          if (cfg.items[i]) {\n            const key = i === 0 ? 'B' : 'Y';\n            box.innerHTML = `<span class=\"item-box-key\" style=\"position:absolute;top:1px;left:3px;\">${key}</span><div style=\"width:22px;height:22px;margin-top:4px;\">${cfg.items[i]}</div>`;\n            box.style.position = 'relative';\n          }\n        });\n      }\n      if (cfg.arenaSvg) {\n        const arena = document.querySelector('.arena-placeholder');\n        if (arena) {\n          arena.innerHTML = cfg.arenaSvg;\n          arena.style.border = '1px solid #22222c';\n          arena.style.overflow = 'hidden';\n        }\n      }\n      if (cfg.dialog) {\n        const dlg = document.getElementById('dialog-box-slot');\n        if (dlg) {\n          dlg.classList.add('active');\n          dlg.innerHTML = `<span style=\"color:#DE2626; font-weight:bold;\">${cfg.dialog.speaker || 'SYSTEM'}</span><br><span>${cfg.dialog.line1 || ''}</span><br><span style=\"color:#888899;\">${cfg.dialog.line2 || ''}</span>`;\n        }\n      }\n      window.isReadyToCapture = true;\n    }\n\n    // Playwright Automation API\n    window.isolateElement = isolateElement;\n    window.resetStage = resetStage;\n    window.toggleDialog = toggleDialog;\n    window.setHudState = setHudState;\n    window.setMode = function(mode) {\n      document.body.classList.toggle('mode-isolated', mode === 'isolated');\n    };\n    window.setSvgContent = function(svgMarkup) {\n      const arena = document.querySelector('.arena-placeholder');\n      if (arena) arena.innerHTML = svgMarkup;\n      window.isReadyToCapture = true;\n    };\n    window.seekProgress = function(ratio) {};\n\n    window.isReadyToCapture = true;\n  </script>\n</body>\n</html>\n",
      "f3bb14b76630077a27b5441f2c1f90d340518fd70ebbb2459ce6d52c8d9ea21b"
    ]
  ]
}