      "#capture-stage",
      "Exemplar template template_graphic_kpi_card_320x320.html from /storage/emulated/0/Admin/Dev/Templates/Canvas_SVG_Capture_Templates",
      "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"UTF-8\">\n  <title>Canvas Graphic \u2014 320x320 KPI Card</title>\n  <style>\n    * {\n      box-sizing: border-box;\n      margin: 0;\n      padding: 0;\n    }\n    body {\n      background: #000000;\n      color: #FFFFFF;\n      width: 100vw;\n      height: 100vh;\n      display: flex;\n      align-items: center;\n      justify-content: center;\n      overflow: hidden;\n      font-family: -apple-system, BlinkMacSystemFont, \"Segoe UI\", Roboto, monospace;\n    }\n    #capture-stage {\n      position: relative;\n      width: 320px;\n      height: 320px;\n      background: #000000;\n      overflow: hidden;\n      display: flex;\n      align-items: center;\n      justify-content: center;\n    }\n    .svg-container {\n      width: 100%;\n      height: 100%;\n      display: flex;\n      align-items: center;\n      justify-content: center;\n    }\n    svg {\n      width: 100%;\n      height: 100%;\n      display: block;\n    }\n\n    @keyframes rotateReticle {\n      0% { transform: rotate(0deg); }\n      100% { transform: rotate(360deg); }\n    }\n    @keyframes pulseRing {\n      0%, 100% { filter: drop-shadow(0 0 6px rgba(222, 38, 38, 0.4)); }\n      50% { filter: drop-shadow(0 0 16px rgba(222, 38, 38, 0.9)); }\n    }\n    .anim-rotate {\n      transform-origin: 160px 145px;\n      animation: rotateReticle 10s linear infinite;\n    }\n    .anim-pulse {\n      animation: pulseRing 3s ease-in-out infinite;\n    }\n  </style>\n</head>\n<body>\n  <div id=\"capture-stage\">\n    <div class=\"svg-container\">\n      <svg viewBox=\"0 0 320 320\" xmlns=\"http://www.w3.org/2000/svg\">\n        <defs>\n          <linearGradient id=\"cardBg\" x1=\"0\" y1=\"0\" x2=\"1\" y2=\"1\">\n            <stop offset=\"0%\" stop-color=\"#0f0f16\"/>\n            <stop offset=\"100%\" stop-color=\"#040407\"/>\n          </linearGradient>\n        </defs>\n\n        <!-- Container Box -->\n        <rect x=\"12\" y=\"12\" width=\"296\" height=\"296\" rx=\"20\" fill=\"url(#cardBg)\" stroke=\"#222230\" stroke-width=\"2\"/>\n        <rect x=\"18\" y=\"18\" width=\"284\" height=\"284\" rx=\"16\" fill=\"none\" stroke=\"#DE2626\" stroke-width=\"1\" stroke-dasharray=\"6 4\" opacity=\"0.4\"/>\n\n        <!-- Header Bar -->\n        <text x=\"32\" y=\"44\" fill=\"#FFFFFF\" font-size=\"12\" font-family=\"monospace\" font-weight=\"700\" letter-spacing=\"2\">SYSTEM METRIC</text>\n        <circle cx=\"282\" cy=\"40\" r=\"4\" fill=\"#DE2626\"/>\n        <line x1=\"32\" y1=\"54\" x2=\"288\" y2=\"54\" stroke=\"#1f1f2a\" stroke-width=\"1.5\"/>\n\n        <!-- Radial Gauge -->\n        <g class=\"anim-pulse\">\n          <!-- Background Track -->\n          <circle cx=\"160\" cy=\"145\" r=\"70\" fill=\"none\" stroke=\"#1a1a24\" stroke-width=\"8\"/>\n          <!-- Active Value Arc (~82%) -->\n          <circle cx=\"160\" cy=\"145\" r=\"70\" fill=\"none\" stroke=\"#DE2626\" stroke-width=\"8\" stroke-dasharray=\"360 80\" stroke-dashoffset=\"100\" stroke-linecap=\"round\"/>\n        </g>\n\n        <!-- Orbiting Ticks -->\n        <g class=\"anim-rotate\">\n          <circle cx=\"160\" cy=\"145\" r=\"82\" fill=\"none\" stroke=\"#DE2626\" stroke-width=\"1.5\" stroke-dasharray=\"12 40\" stroke-linecap=\"round\" opacity=\"0.6\"/>\n        </g>\n\n        <!-- Center Typography -->\n        <text x=\"160\" y=\"142\" fill=\"#FFFFFF\" font-size=\"36\" font-family=\"-apple-system, sans-serif\" font-weight=\"800\" text-anchor=\"middle\">99.8%</text>\n        <text x=\"160\" y=\"164\" fill=\"#888899\" font-size=\"11\" font-family=\"monospace\" text-anchor=\"middle\">PARITY INDEX</text>\n\n        <!-- Bottom Status Bar -->\n        <rect x=\"32\" y=\"245\" width=\"256\" height=\"36\" rx=\"8\" fill=\"#12121a\" stroke=\"#252535\" stroke-width=\"1\"/>\n        <text x=\"44\" y=\"267\" fill=\"#888899\" font-size=\"10\" font-family=\"monospace\">STATUS:</text>\n        <text x=\"96\" y=\"267\" fill=\"#FFFFFF\" font-size=\"10\" font-family=\"monospace\" font-weight=\"700\">OPTIMAL / LOCKED</text>\n        <circle cx=\"268\" cy=\"263\" r=\"3.5\" fill=\"#DE2626\"/>\n      </svg>\n    </div>\n  </div>\n\n  <script>\n    window.isReadyToCapture = false;\n    window.pauseAnimation = function() {\n      document.querySelectorAll('*').forEach(el => el.style.animationPlayState = 'paused');\n    };\n    window.playAnimation = function() {\n      document.querySelectorAll('*').forEach(el => el.style.animationPlayState = 'running');\n    };\n    window.seekProgress = function(progress) {\n      const totalDurationSec = 3.0;\n      const targetTimeSec = progress * totalDurationSec;\n      document.querySelectorAll('*').forEach(el => {\n        el.style.animationDelay = `-${targetTimeSec}s`;\n        el.style.animationPlayState = 'paused';\n      });\n    };\n    window.addEventListener('DOMContentLoaded', () => {\n      setTimeout(() => { window.isReadyToCapture = true; }, 300);\n    });\n  </script>\n</body>\n</html>\n",
