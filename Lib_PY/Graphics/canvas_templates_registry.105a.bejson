      "legacy_exemplar",
      160,
      48,
      "160:48",
      "#capture-stage",
      "Exemplar template template_graphic_chip_160x48.html from /storage/emulated/0/Admin/Dev/Templates/Canvas_SVG_Capture_Templates",
      "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"UTF-8\">\n  <title>Canvas Graphic \u2014 160x48 Micro Chip Tag</title>\n  <style>\n    * {\n      box-sizing: border-box;\n      margin: 0;\n      padding: 0;\n    }\n    body {\n      background: #000000;\n      color: #FFFFFF;\n      width: 100vw;\n      height: 100vh;\n      display: flex;\n      align-items: center;\n      justify-content: center;\n      overflow: hidden;\n      font-family: monospace;\n    }\n    #capture-stage {\n      position: relative;\n      width: 160px;\n      height: 48px;\n      background: #000000;\n      overflow: hidden;\n      display: flex;\n      align-items: center;\n      justify-content: center;\n    }\n    .svg-container {\n      width: 100%;\n      height: 100%;\n      display: flex;\n      align-items: center;\n      justify-content: center;\n    }\n    svg {\n      width: 100%;\n      height: 100%;\n      display: block;\n    }\n\n    @keyframes pulseDot {\n      0%, 100% { fill: #DE2626; filter: drop-shadow(0 0 2px #DE2626); }\n      50% { fill: #FFFFFF; filter: drop-shadow(0 0 8px #DE2626); }\n    }\n    .anim-pip {\n      animation: pulseDot 2s ease-in-out infinite;\n    }\n  </style>\n</head>\n<body>\n  <div id=\"capture-stage\">\n    <div class=\"svg-container\">\n      <svg viewBox=\"0 0 160 48\" xmlns=\"http://www.w3.org/2000/svg\">\n        <!-- Pill Background -->\n        <rect x=\"4\" y=\"4\" width=\"152\" height=\"40\" rx=\"20\" fill=\"#0c0c12\" stroke=\"#222230\" stroke-width=\"1.5\"/>\n        <rect x=\"7\" y=\"7\" width=\"146\" height=\"34\" rx=\"17\" fill=\"none\" stroke=\"#DE2626\" stroke-width=\"0.8\" opacity=\"0.4\"/>\n\n        <!-- Status Glowing Pip -->\n        <circle cx=\"22\" cy=\"24\" r=\"5\" fill=\"#1f1418\" stroke=\"#DE2626\" stroke-width=\"1.5\"/>\n        <circle cx=\"22\" cy=\"24\" r=\"2.5\" class=\"anim-pip\"/>\n\n        <!-- Text Label -->\n        <text x=\"36\" y=\"28\" fill=\"#FFFFFF\" font-size=\"11\" font-family=\"monospace\" font-weight=\"700\" letter-spacing=\"1\">L5 \u00b7 UI_AUDIT</text>\n\n        <!-- Right Circuit Micro Trace -->\n        <path d=\"M 134 24 L 144 24 L 148 20\" fill=\"none\" stroke=\"#DE2626\" stroke-width=\"1.2\" stroke-linecap=\"round\"/>\n        <circle cx=\"148\" cy=\"20\" r=\"1.5\" fill=\"#DE2626\"/>\n      </svg>\n    </div>\n  </div>\n\n  <script>\n    window.isReadyToCapture = false;\n    window.pauseAnimation = function() {\n      document.querySelectorAll('*').forEach(el => el.style.animationPlayState = 'paused');\n    };\n    window.playAnimation = function() {\n      document.querySelectorAll('*').forEach(el => el.style.animationPlayState = 'running');\n    };\n    window.seekProgress = function(progress) {\n      const totalDurationSec = 2.0;\n      const targetTimeSec = progress * totalDurationSec;\n      document.querySelectorAll('*').forEach(el => {\n        el.style.animationDelay = `-${targetTimeSec}s`;\n        el.style.animationPlayState = 'paused';\n      });\n    };\n    window.addEventListener('DOMContentLoaded', () => {\n      setTimeout(() => { window.isReadyToCapture = true; }, 150);\n    });\n  </script>\n</body>\n</html>\n",
