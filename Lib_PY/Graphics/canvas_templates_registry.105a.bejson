      "16:9",
      "#capture-stage",
      "16:9 Hero Title / Cover presentation slide template with isometric cube branding, laser accents, and credentials.",
      "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"UTF-8\">\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n  <title>16:9 Hero Title / Cover presentation slide template with isometric cube branding, laser accents, and credentials.</title>\n  <style>\n    * {\n      box-sizing: border-box;\n      margin: 0;\n      padding: 0;\n    }\n    html, body {\n      width: 100vw;\n      height: 100vh;\n      background: #000000;\n      display: flex;\n      align-items: center;\n      justify-content: center;\n      overflow: hidden;\n      font-family: -apple-system, BlinkMacSystemFont, \"Segoe UI\", Roboto, monospace;\n    }\n    #capture-stage {\n      position: relative;\n      width: 1280px;\n      height: 720px;\n      background: #000000;\n      border: 1px solid #1c1c24;\n      overflow: hidden;\n      display: flex;\n      align-items: center;\n      justify-content: center;\n    }\n    .canvas-slot {\n      width: 100%;\n      height: 100%;\n      display: flex;\n      align-items: center;\n      justify-content: center;\n      position: relative;\n    }\n    .canvas-slot > svg, .canvas-slot > img {\n      width: 100%;\n      height: 100%;\n      display: block;\n      object-fit: contain;\n    }\n  </style>\n</head>\n<body>\n  <div id=\"capture-stage\" data-width=\"1280\" data-height=\"720\">\n    <div class=\"canvas-slot\" id=\"stage-slot\">\n      <svg width=\"1280\" height=\"720\" viewBox=\"0 0 1280 720\" xmlns=\"http://www.w3.org/2000/svg\">\n  <rect width=\"1280\" height=\"720\" fill=\"#000000\"/>\n  <polygon points=\"32,24 1248,24 1256,32 1256,688 1248,696 32,696 24,688 24,32\" fill=\"#08080C\" stroke=\"#2A2A38\" stroke-width=\"1.5\"/>\n  <line x1=\"24\" y1=\"24\" x2=\"64\" y2=\"24\" stroke=\"#DE2626\" stroke-width=\"3\"/>\n  <line x1=\"24\" y1=\"24\" x2=\"24\" y2=\"64\" stroke=\"#DE2626\" stroke-width=\"3\"/>\n  <line x1=\"1256\" y1=\"24\" x2=\"1216\" y2=\"24\" stroke=\"#DE2626\" stroke-width=\"3\"/>\n  <line x1=\"1256\" y1=\"24\" x2=\"1256\" y2=\"64\" stroke=\"#DE2626\" stroke-width=\"3\"/>\n  <line x1=\"24\" y1=\"696\" x2=\"64\" y2=\"696\" stroke=\"#DE2626\" stroke-width=\"3\"/>\n  <line x1=\"24\" y1=\"696\" x2=\"24\" y2=\"656\" stroke=\"#DE2626\" stroke-width=\"3\"/>\n  <line x1=\"1256\" y1=\"696\" x2=\"1216\" y2=\"696\" stroke=\"#DE2626\" stroke-width=\"3\"/>\n  <line x1=\"1256\" y1=\"696\" x2=\"1256\" y2=\"656\" stroke=\"#DE2626\" stroke-width=\"3\"/>\n  <rect x=\"64\" y=\"48\" width=\"280\" height=\"32\" rx=\"16\" fill=\"#000000\" stroke=\"#2A2A38\" stroke-width=\"1.5\"/>\n  <circle cx=\"80\" cy=\"64\" r=\"5\" fill=\"#DE2626\"/>\n  <text x=\"96\" y=\"69\" fill=\"#FFFFFF\" font-size=\"12\" font-family=\"monospace\" font-weight=\"bold\" letter-spacing=\"1.5\">BEJSON ECOSYSTEM STANDARDS</text>\n  <rect x=\"1000\" y=\"48\" width=\"216\" height=\"32\" rx=\"16\" fill=\"#000000\" stroke=\"#DE2626\" stroke-width=\"1.5\"/>\n  <text x=\"1020\" y=\"69\" fill=\"#DE2626\" font-size=\"12\" font-family=\"monospace\" font-weight=\"bold\" letter-spacing=\"1.5\">FORMAT 105a // REL. 300</text>\n  <text x=\"80\" y=\"280\" fill=\"#FFFFFF\" font-size=\"50\" font-family=\"monospace\" font-weight=\"900\" letter-spacing=\"2\">BEJSON 105 ARCHITECTURE</text>\n  <line x1=\"80\" y1=\"310\" x2=\"720\" y2=\"310\" stroke=\"#DE2626\" stroke-width=\"3\"/>\n  <text x=\"80\" y=\"360\" fill=\"#AAAAAA\" font-size=\"22\" font-family=\"monospace\">Deterministic Data, Spatial Layout & Graphics Engine</text>\n  <g transform=\"translate(960, 360)\">\n    <ellipse cx=\"0\" cy=\"0\" rx=\"140\" ry=\"60\" fill=\"none\" stroke=\"#DE2626\" stroke-width=\"1.5\" stroke-dasharray=\"8,6\" opacity=\"0.6\"/>\n    <polygon points=\"0,-70 60,-35 60,35 0,70 -60,35 -60,-35\" fill=\"#14141E\" stroke=\"#FFFFFF\" stroke-width=\"2\"/>\n    <line x1=\"0\" y1=\"-70\" x2=\"0\" y2=\"70\" stroke=\"#2A2A38\" stroke-width=\"1.5\"/>\n    <line x1=\"-60\" y1=\"-35\" x2=\"60\" y2=\"35\" stroke=\"#2A2A38\" stroke-width=\"1.5\"/>\n    <line x1=\"60\" y1=\"-35\" x2=\"-60\" y2=\"35\" stroke=\"#2A2A38\" stroke-width=\"1.5\"/>\n    <circle cx=\"0\" cy=\"0\" r=\"6\" fill=\"#DE2626\"/>\n  </g>\n  <line x1=\"64\" y1=\"640\" x2=\"1216\" y2=\"640\" stroke=\"#2A2A38\" stroke-width=\"1\"/>\n  <text x=\"64\" y=\"672\" fill=\"#888899\" font-size=\"14\" font-family=\"monospace\">Author: Elton Boehnen \u00b7 boehnenelton2024@gmail.com</text>\n  <text x=\"1216\" y=\"672\" text-anchor=\"end\" fill=\"#888899\" font-size=\"14\" font-family=\"monospace\">boehnenelton2024.pages.dev \u00b7 github.com/boehnenelton</text>\n</svg>\n    </div>\n    <!-- Pre-recording Coordinate-Based Text Overlay Layer -->\n    <div id=\"overlay-layer\" style=\"position:absolute;top:0;left:0;width:100%;height:100%;pointer-events:none;z-index:100;overflow:hidden;\"></div>\n  </div>\n\n  <script>\n    window.isReadyToCapture = true;\n    window._activeOverlays = [];\n\n    // Dynamically replace the SVG / graphic content in the blank slate\n    window.setSvgContent = function(svgMarkup) {\n      const slot = document.getElementById('stage-slot');\n      if (slot) {\n        slot.innerHTML = svgMarkup;\n        window.isReadyToCapture = true;\n      }\n    };\n\n    // Update dimensions dynamically\n    window.setDimensions = function(width, height) {\n      const stage = document.getElementById('capture-stage');\n      if (stage) {\n        stage.style.width = width + 'px';\n        stage.style.height = height + 'px';\n        stage.setAttribute('data-width', width);\n        stage.setAttribute('data-height', height);\n      }\n    };\n\n    // Pre-recording Coordinate-Based Text Overlay Injection\n    window.setTextOverlays = function(overlays, context) {\n      const layer = document.getElementById('overlay-layer');\n      if (!layer) return;\n      layer.innerHTML = '';\n      window._activeOverlays = overlays || [];\n      const ctx = context || {};\n\n      (window._activeOverlays).forEach(o => {\n        const item = document.createElement('div');\n        item.style.position = 'absolute';\n        item.style.left = typeof o.x === 'number' ? o.x + 'px' : o.x;\n        item.style.top = typeof o.y === 'number' ? o.y + 'px' : o.y;\n        item.style.fontSize = (o.font_size || 20) + 'px';\n        item.style.fontFamily = o.font_family || 'monospace';\n        item.style.fontWeight = o.font_weight || 'bold';\n        item.style.color = o.color || '#FFFFFF';\n        if (o.bg_color) item.style.backgroundColor = o.bg_color;\n        if (o.padding) item.style.padding = o.padding;\n        if (o.border_radius) item.style.borderRadius = o.border_radius;\n        if (o.opacity !== undefined) item.style.opacity = o.opacity;\n        if (o.z_index) item.style.zIndex = o.z_index;\n        if (o.align) item.style.textAlign = o.align;\n\n        let rawText = o.text || '';\n        // Token interpolation\n        rawText = rawText.replace(/{frame}/g, ctx.frame !== undefined ? ctx.frame : '')\n                         .replace(/{time}/g, ctx.time !== undefined ? Number(ctx.time).toFixed(2) : '')\n                         .replace(/{fps}/g, ctx.fps || '')\n                         .replace(/{caption}/g, ctx.caption || '');\n        item.textContent = rawText;\n        layer.appendChild(item);\n      });\n      window.isReadyToCapture = true;\n    };\n\n    // Timeline seeking hook for CSS/SMIL animations inside the dynamic SVG\n    window.seekProgress = function(progress, durationSeconds) {\n      const dur = durationSeconds || 8.0;\n      const targetTimeSec = progress * dur;\n      document.querySelectorAll('#capture-stage *').forEach(el => {\n        el.style.animationDelay = `-${targetTimeSec}s`;\n        el.style.animationPlayState = 'paused';\n      });\n    };\n\n    // Dynamic Diagram View Loader\n    window.loadDiagram = function(diagramData, state, viewport) {\n      const slot = document.getElementById('stage-slot');\n      if (!slot) return;\n      window._activeDiagram = diagramData;\n      window.setDiagramState(state, viewport);\n    };\n\n    window.setDiagramState = function(state, viewport) {\n      const slot = document.getElementById('stage-slot');\n      if (!slot || !window._activeDiagram) return;\n      const diag = window._activeDiagram;\n      const st = state || {};\n      const vp = viewport || {};\n\n      const activeShapes = new Set(st.active_shapes || []);\n      const dimmedShapes = new Set(st.dimmed_shapes || []);\n      const activeConns = new Set(st.active_connectors || []);\n\n      const stage = document.getElementById('capture-stage');\n      const cw = parseInt(stage.getAttribute('data-width') || 800, 10);\n      const ch = parseInt(stage.getAttribute('data-height') || 800, 10);\n\n      const panX = vp.pan_x !== undefined ? vp.pan_x : 0;\n      const panY = vp.pan_y !== undefined ? vp.pan_y : 0;\n      const zoom = vp.zoom !== undefined ? vp.zoom : 1.0;\n\n      // Build internal SVG representation\n      let svg = `<svg viewBox=\"0 0 ${cw} ${ch}\" width=\"${cw}\" height=\"${ch}\" xmlns=\"http://www.w3.org/2000/svg\" style=\"background:#000000;width:100%;height:100%;\">\n        <defs>\n          <marker id=\"arr\" viewBox=\"0 0 10 10\" refX=\"8\" refY=\"5\" markerWidth=\"6\" markerHeight=\"6\" orient=\"auto-start-reverse\">\n            <path d=\"M 0 1.5 L 8 5 L 0 8.5 z\" fill=\"#FFFFFF\" />\n          </marker>\n          <marker id=\"arr-red\" viewBox=\"0 0 10 10\" refX=\"8\" refY=\"5\" markerWidth=\"7\" markerHeight=\"7\" orient=\"auto-start-reverse\">\n            <path d=\"M 0 1 L 9 5 L 0 9 z\" fill=\"#DE2626\" />\n          </marker>\n          <filter id=\"red-glow\" x=\"-20%\" y=\"-20%\" width=\"140%\" height=\"140%\">\n            <feGaussianBlur stdDeviation=\"6\" result=\"blur\" />\n            <feMerge><feMergeNode in=\"blur\" /><feMergeNode in=\"SourceGraphic\" /></feMerge>\n          </filter>\n        </defs>\n        <g id=\"viewport-group\" transform=\"translate(${panX}, ${panY}) scale(${zoom})\">`;\n\n      const shapeMap = {};\n      (diag.shapes || []).forEach(s => {\n        const sid = s.id || s.tempId;\n        if (sid) shapeMap[sid] = s;\n      });\n\n      // Territories\n      (diag.territories || []).forEach(t => {\n        const sz = t.size || 200;\n        const color = t.color || '#DE2626';\n        svg += `<rect x=\"${t.cx - sz/2}\" y=\"${t.cy - sz/2}\" width=\"${sz}\" height=\"${sz}\" rx=\"16\" fill=\"${color}\" fill-opacity=\"0.05\" stroke=\"${color}\" stroke-opacity=\"0.3\" stroke-width=\"1.5\" stroke-dasharray=\"6,4\" />`;\n        if (t.label) {\n          svg += `<text x=\"${t.cx}\" y=\"${t.cy - sz/2 + 20}\" fill=\"${color}\" font-size=\"11\" font-family=\"monospace\" font-weight=\"bold\" letter-spacing=\"1\" text-anchor=\"middle\">${t.label.toUpperCase()}</text>`;\n        }\n      });\n\n      // Connectors\n      (diag.connectors || []).forEach(c => {\n        const fid = c.from || c.fromTempId;\n        const tid = c.to || c.toTempId;\n        if (shapeMap[fid] && shapeMap[tid]) {\n          const s1 = shapeMap[fid];\n          const s2 = shapeMap[tid];\n          const isAct = activeConns.has(`${fid}->${tid}`) || (activeShapes.has(fid) && activeShapes.has(tid));\n          const col = isAct ? '#DE2626' : '#FFFFFF';\n          const mkr = isAct ? 'url(#arr-red)' : 'url(#arr)';\n          svg += `<line x1=\"${s1.cx}\" y1=\"${s1.cy}\" x2=\"${s2.cx}\" y2=\"${s2.cy}\" stroke=\"${col}\" stroke-width=\"${isAct ? 2.5 : 1.5}\" stroke-opacity=\"${isAct ? 1 : 0.4}\" marker-end=\"${mkr}\" />`;\n        }\n      });\n\n      // Shapes\n      (diag.shapes || []).forEach(s => {\n        const sid = s.id || s.tempId;\n        const w = s.sizeClass === 'small' ? 120 : (s.sizeClass === 'large' ? 300 : 200);\n        const h = s.sizeClass === 'small' ? 70 : (s.sizeClass === 'large' ? 150 : 100);\n        const isAct = activeShapes.has(sid);\n        const isDim = dimmedShapes.has(sid);\n        const col = isAct ? '#DE2626' : '#FFFFFF';\n        const bg = isAct ? '#1c0d0d' : '#121218';\n        const glow = isAct ? 'filter=\"url(#red-glow)\"' : '';\n        const op = isDim ? '0.25' : '1.0';\n\n        svg += `<g id=\"s-${sid}\" opacity=\"${op}\">\n          <rect x=\"${s.cx - w/2}\" y=\"${s.cy - h/2}\" width=\"${w}\" height=\"${h}\" rx=\"8\" fill=\"${bg}\" stroke=\"${col}\" stroke-width=\"${isAct ? 2.5 : 1.2}\" ${glow} />\n          <text x=\"${s.cx - w/2 + 12}\" y=\"${s.cy - h/2 + 24}\" fill=\"#FFFFFF\" font-size=\"12\" font-family=\"-apple-system, sans-serif\" font-weight=\"bold\">${s.label || sid}</text>`;\n        if (s.text) {\n          svg += `<text x=\"${s.cx - w/2 + 12}\" y=\"${s.cy - h/2 + 42}\" fill=\"#737373\" font-size=\"10\" font-family=\"-apple-system, sans-serif\">${(s.text || '').substring(0, 32)}</text>`;\n        }\n        if (isAct) {\n          svg += `<circle cx=\"${s.cx + w/2 - 12}\" cy=\"${s.cy - h/2 + 12}\" r=\"4\" fill=\"#DE2626\" />`;\n        }\n        svg += `</g>`;\n      });\n\n      svg += `</g>`;\n\n      if (st.badge_text) {\n        svg += `<g id=\"canvas-hud\">\n          <rect x=\"20\" y=\"20\" width=\"300\" height=\"34\" rx=\"4\" fill=\"#0c0c12\" fill-opacity=\"0.9\" stroke=\"#22222c\" stroke-width=\"1\" />\n          <circle cx=\"34\" cy=\"37\" r=\"4\" fill=\"#DE2626\" />\n          <text x=\"48\" y=\"41\" fill=\"#FFFFFF\" font-size=\"11\" font-family=\"monospace\" font-weight=\"bold\">${st.badge_text.toUpperCase()}</text>\n        </g>`;\n      }\n\n      svg += `</svg>`;\n      slot.innerHTML = svg;\n      window.isReadyToCapture = true;\n    };\n\n    window.pauseAnimation = function() {\n      document.querySelectorAll('#capture-stage *').forEach(el => {\n        el.style.animationPlayState = 'paused';\n      });\n    };\n\n    window.playAnimation = function() {\n      document.querySelectorAll('#capture-stage *').forEach(el => {\n        el.style.animationPlayState = 'running';\n      });\n    };\n  </script>\n</body>\n</html>\n",
      "5b1d2aa27ce2b1189ee58db16cc5f93d44fae8159d9f9cd0a6188a2f4b58d8f4"
    ],
    [
      "c90a0978-0f8f-46ae-bffc-b3e75c785d77",
      "slide_branding_architecture_1280",
      "slide_branding_architecture_1280x720.html",
      "branding_slide",
      1280,
      720,
      "16:9",
      "#capture-stage",
      "16:9 3-Pillar Architectural Blueprint presentation slide template with chamfered card surfaces and red accents.",
      "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"UTF-8\">\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n  <title>16:9 3-Pillar Architectural Blueprint presentation slide template with chamfered card surfaces and red accents.</title>\n  <style>\n    * {\n      box-sizing: border-box;\n      margin: 0;\n      padding: 0;\n    }\n    html, body {\n      width: 100vw;\n      height: 100vh;\n      background: #000000;\n      display: flex;\n      align-items: center;\n      justify-content: center;\n      overflow: hidden;\n      font-family: -apple-system, BlinkMacSystemFont, \"Segoe UI\", Roboto, monospace;\n    }\n    #capture-stage {\n      position: relative;\n      width: 1280px;\n      height: 720px;\n      background: #000000;\n      border: 1px solid #1c1c24;\n      overflow: hidden;\n      display: flex;\n      align-items: center;\n      justify-content: center;\n    }\n    .canvas-slot {\n      width: 100%;\n      height: 100%;\n      display: flex;\n      align-items: center;\n      justify-content: center;\n      position: relative;\n    }\n    .canvas-slot > svg, .canvas-slot > img {\n      width: 100%;\n      height: 100%;\n      display: block;\n      object-fit: contain;\n    }\n  </style>\n</head>\n<body>\n  <div id=\"capture-stage\" data-width=\"1280\" data-height=\"720\">\n    <div class=\"canvas-slot\" id=\"stage-slot\">\n      <svg width=\"1280\" height=\"720\" viewBox=\"0 0 1280 720\" xmlns=\"http://www.w3.org/2000/svg\">\n  <rect width=\"1280\" height=\"720\" fill=\"#000000\"/>\n  <polygon points=\"32,24 1248,24 1256,32 1256,688 1248,696 32,696 24,688 24,32\" fill=\"#08080C\" stroke=\"#2A2A38\" stroke-width=\"1.5\"/>\n  <text x=\"64\" y=\"64\" fill=\"#DE2626\" font-size=\"12\" font-family=\"monospace\" font-weight=\"bold\" letter-spacing=\"1.5\">01 // ARCHITECTURE &amp; TAXONOMY</text>\n  <text x=\"64\" y=\"104\" fill=\"#FFFFFF\" font-size=\"32\" font-family=\"monospace\" font-weight=\"bold\">THREE-TIER SYSTEM DECOMPOSITION</text>\n  <text x=\"64\" y=\"132\" fill=\"#888899\" font-size=\"16\" font-family=\"monospace\">Decoupled persistence, mathematical layout, and visual presentation</text>\n  <g>\n    <rect x=\"64\" y=\"160\" width=\"360\" height=\"450\" rx=\"4\" fill=\"#0A0A10\" stroke=\"#2A2A38\" stroke-width=\"1.5\"/>\n    <rect x=\"64\" y=\"160\" width=\"360\" height=\"4\" fill=\"#DE2626\"/>\n    <text x=\"88\" y=\"202\" fill=\"#DE2626\" font-size=\"14\" font-family=\"monospace\" font-weight=\"bold\">PILLAR // 01</text>\n    <text x=\"88\" y=\"240\" fill=\"#FFFFFF\" font-size=\"22\" font-family=\"monospace\" font-weight=\"bold\">CORE FOUNDATION</text>\n    <text x=\"88\" y=\"272\" fill=\"#888899\" font-size=\"14\" font-family=\"monospace\">BEJSON 104/105 Persistence</text>\n    <line x1=\"88\" y1=\"296\" x2=\"400\" y2=\"296\" stroke=\"#1C1C28\" stroke-width=\"1\"/>\n    <rect x=\"88\" y=\"330\" width=\"6\" height=\"6\" fill=\"#DE2626\"/>\n    <text x=\"104\" y=\"336\" fill=\"#FFFFFF\" font-size=\"14\" font-family=\"monospace\">O(1) Field Map Caching</text>\n    <rect x=\"88\" y=\"372\" width=\"6\" height=\"6\" fill=\"#DE2626\"/>\n    <text x=\"104\" y=\"378\" fill=\"#FFFFFF\" font-size=\"14\" font-family=\"monospace\">MFDB 1.40 Multi-File DB</text>\n    <rect x=\"88\" y=\"414\" width=\"6\" height=\"6\" fill=\"#DE2626\"/>\n    <text x=\"104\" y=\"420\" fill=\"#FFFFFF\" font-size=\"14\" font-family=\"monospace\">E90-E95 UUID Integrity</text>\n    <rect x=\"88\" y=\"456\" width=\"6\" height=\"6\" fill=\"#DE2626\"/>\n    <text x=\"104\" y=\"462\" fill=\"#FFFFFF\" font-size=\"14\" font-family=\"monospace\">Atomic Posix File I/O</text>\n    <rect x=\"88\" y=\"562\" width=\"312\" height=\"28\" rx=\"14\" fill=\"#000000\" stroke=\"#2A2A38\" stroke-width=\"1\"/>\n    <text x=\"244.0\" y=\"580\" text-anchor=\"middle\" fill=\"#888899\" font-size=\"11\" font-family=\"monospace\" font-weight=\"bold\" letter-spacing=\"1.5\">PERSISTENCE</text>\n  </g>\n  <g>\n    <rect x=\"460\" y=\"160\" width=\"360\" height=\"450\" rx=\"4\" fill=\"#0A0A10\" stroke=\"#2A2A38\" stroke-width=\"1.5\"/>\n    <rect x=\"460\" y=\"160\" width=\"360\" height=\"4\" fill=\"#DE2626\"/>\n    <text x=\"484\" y=\"202\" fill=\"#DE2626\" font-size=\"14\" font-family=\"monospace\" font-weight=\"bold\">PILLAR // 02</text>\n    <text x=\"484\" y=\"240\" fill=\"#FFFFFF\" font-size=\"22\" font-family=\"monospace\" font-weight=\"bold\">SPATIAL LAYOUT</text>\n    <text x=\"484\" y=\"272\" fill=\"#888899\" font-size=\"14\" font-family=\"monospace\">BEHTML Spatial Engine</text>\n    <line x1=\"484\" y1=\"296\" x2=\"796\" y2=\"296\" stroke=\"#1C1C28\" stroke-width=\"1\"/>\n    <rect x=\"484\" y=\"330\" width=\"6\" height=\"6\" fill=\"#DE2626\"/>\n    <text x=\"500\" y=\"336\" fill=\"#FFFFFF\" font-size=\"14\" font-family=\"monospace\">8-Lane / 16-Sublane Grid</text>\n    <rect x=\"484\" y=\"372\" width=\"6\" height=\"6\" fill=\"#DE2626\"/>\n    <text x=\"500\" y=\"378\" fill=\"#FFFFFF\" font-size=\"14\" font-family=\"monospace\">Row Quantization (Ry=32px)</text>\n    <rect x=\"484\" y=\"414\" width=\"6\" height=\"6\" fill=\"#DE2626\"/>\n    <text x=\"500\" y=\"420\" fill=\"#FFFFFF\" font-size=\"14\" font-family=\"monospace\">Policy \u00a78.1 Tri-Color</text>\n    <rect x=\"484\" y=\"456\" width=\"6\" height=\"6\" fill=\"#DE2626\"/>\n    <text x=\"500\" y=\"462\" fill=\"#FFFFFF\" font-size=\"14\" font-family=\"monospace\">Zero Filler Skeleton Law</text>\n    <rect x=\"484\" y=\"562\" width=\"312\" height=\"28\" rx=\"14\" fill=\"#000000\" stroke=\"#2A2A38\" stroke-width=\"1\"/>\n    <text x=\"640.0\" y=\"580\" text-anchor=\"middle\" fill=\"#888899\" font-size=\"11\" font-family=\"monospace\" font-weight=\"bold\" letter-spacing=\"1.5\">COORDINATES</text>\n  </g>\n  <g>\n    <rect x=\"856\" y=\"160\" width=\"360\" height=\"450\" rx=\"4\" fill=\"#0A0A10\" stroke=\"#2A2A38\" stroke-width=\"1.5\"/>\n    <rect x=\"856\" y=\"160\" width=\"360\" height=\"4\" fill=\"#DE2626\"/>\n    <text x=\"880\" y=\"202\" fill=\"#DE2626\" font-size=\"14\" font-family=\"monospace\" font-weight=\"bold\">PILLAR // 03</text>\n    <text x=\"880\" y=\"240\" fill=\"#FFFFFF\" font-size=\"22\" font-family=\"monospace\" font-weight=\"bold\">GRAPHICS ENGINE</text>\n    <text x=\"880\" y=\"272\" fill=\"#888899\" font-size=\"14\" font-family=\"monospace\">Vector & Studio Core</text>\n    <line x1=\"880\" y1=\"296\" x2=\"1192\" y2=\"296\" stroke=\"#1C1C28\" stroke-width=\"1\"/>\n    <rect x=\"880\" y=\"330\" width=\"6\" height=\"6\" fill=\"#DE2626\"/>\n    <text x=\"896\" y=\"336\" fill=\"#FFFFFF\" font-size=\"14\" font-family=\"monospace\">105a Timeline Quantization</text>\n    <rect x=\"880\" y=\"372\" width=\"6\" height=\"6\" fill=\"#DE2626\"/>\n    <text x=\"896\" y=\"378\" fill=\"#FFFFFF\" font-size=\"14\" font-family=\"monospace\">Two-Tier Barrier of Entry</text>\n    <rect x=\"880\" y=\"414\" width=\"6\" height=\"6\" fill=\"#DE2626\"/>\n    <text x=\"896\" y=\"420\" fill=\"#FFFFFF\" font-size=\"14\" font-family=\"monospace\">Playwright ARM64 Exporters</text>\n    <rect x=\"880\" y=\"456\" width=\"6\" height=\"6\" fill=\"#DE2626\"/>\n    <text x=\"896\" y=\"462\" fill=\"#FFFFFF\" font-size=\"14\" font-family=\"monospace\">Remove_Frame_Source Scoop</text>\n    <rect x=\"880\" y=\"562\" width=\"312\" height=\"28\" rx=\"14\" fill=\"#000000\" stroke=\"#2A2A38\" stroke-width=\"1\"/>\n    <text x=\"1036.0\" y=\"580\" text-anchor=\"middle\" fill=\"#888899\" font-size=\"11\" font-family=\"monospace\" font-weight=\"bold\" letter-spacing=\"1.5\">ANIMATION</text>\n  </g>\n  <line x1=\"64\" y1=\"664\" x2=\"1216\" y2=\"664\" stroke=\"#2A2A38\" stroke-width=\"1\"/>\n  <text x=\"64\" y=\"688\" fill=\"#888899\" font-size=\"12\" font-family=\"monospace\">ELTON BOEHNEN BEJSON ECOSYSTEM \u00b7 RELEASE 300</text>\n  <text x=\"1216\" y=\"688\" text-anchor=\"end\" fill=\"#888899\" font-size=\"12\" font-family=\"monospace\">CONFIDENTIAL // SPECIFICATION SLIDE</text>\n</svg>\n    </div>\n    <!-- Pre-recording Coordinate-Based Text Overlay Layer -->\n    <div id=\"overlay-layer\" style=\"position:absolute;top:0;left:0;width:100%;height:100%;pointer-events:none;z-index:100;overflow:hidden;\"></div>\n  </div>\n\n  <script>\n    window.isReadyToCapture = true;\n    window._activeOverlays = [];\n\n    // Dynamically replace the SVG / graphic content in the blank slate\n    window.setSvgContent = function(svgMarkup) {\n      const slot = document.getElementById('stage-slot');\n      if (slot) {\n        slot.innerHTML = svgMarkup;\n        window.isReadyToCapture = true;\n      }\n    };\n\n    // Update dimensions dynamically\n    window.setDimensions = function(width, height) {\n      const stage = document.getElementById('capture-stage');\n      if (stage) {\n        stage.style.width = width + 'px';\n        stage.style.height = height + 'px';\n        stage.setAttribute('data-width', width);\n        stage.setAttribute('data-height', height);\n      }\n    };\n\n    // Pre-recording Coordinate-Based Text Overlay Injection\n    window.setTextOverlays = function(overlays, context) {\n      const layer = document.getElementById('overlay-layer');\n      if (!layer) return;\n      layer.innerHTML = '';\n      window._activeOverlays = overlays || [];\n      const ctx = context || {};\n\n      (window._activeOverlays).forEach(o => {\n        const item = document.createElement('div');\n        item.style.position = 'absolute';\n        item.style.left = typeof o.x === 'number' ? o.x + 'px' : o.x;\n        item.style.top = typeof o.y === 'number' ? o.y + 'px' : o.y;\n        item.style.fontSize = (o.font_size || 20) + 'px';\n        item.style.fontFamily = o.font_family || 'monospace';\n        item.style.fontWeight = o.font_weight || 'bold';\n        item.style.color = o.color || '#FFFFFF';\n        if (o.bg_color) item.style.backgroundColor = o.bg_color;\n        if (o.padding) item.style.padding = o.padding;\n        if (o.border_radius) item.style.borderRadius = o.border_radius;\n        if (o.opacity !== undefined) item.style.opacity = o.opacity;\n        if (o.z_index) item.style.zIndex = o.z_index;\n        if (o.align) item.style.textAlign = o.align;\n\n        let rawText = o.text || '';\n        // Token interpolation\n        rawText = rawText.replace(/{frame}/g, ctx.frame !== undefined ? ctx.frame : '')\n                         .replace(/{time}/g, ctx.time !== undefined ? Number(ctx.time).toFixed(2) : '')\n                         .replace(/{fps}/g, ctx.fps || '')\n                         .replace(/{caption}/g, ctx.caption || '');\n        item.textContent = rawText;\n        layer.appendChild(item);\n      });\n      window.isReadyToCapture = true;\n    };\n\n    // Timeline seeking hook for CSS/SMIL animations inside the dynamic SVG\n    window.seekProgress = function(progress, durationSeconds) {\n      const dur = durationSeconds || 8.0;\n      const targetTimeSec = progress * dur;\n      document.querySelectorAll('#capture-stage *').forEach(el => {\n        el.style.animationDelay = `-${targetTimeSec}s`;\n        el.style.animationPlayState = 'paused';\n      });\n    };\n\n    // Dynamic Diagram View Loader\n    window.loadDiagram = function(diagramData, state, viewport) {\n      const slot = document.getElementById('stage-slot');\n      if (!slot) return;\n      window._activeDiagram = diagramData;\n      window.setDiagramState(state, viewport);\n    };\n\n    window.setDiagramState = function(state, viewport) {\n      const slot = document.getElementById('stage-slot');\n      if (!slot || !window._activeDiagram) return;\n      const diag = window._activeDiagram;\n      const st = state || {};\n      const vp = viewport || {};\n\n      const activeShapes = new Set(st.active_shapes || []);\n      const dimmedShapes = new Set(st.dimmed_shapes || []);\n      const activeConns = new Set(st.active_connectors || []);\n\n      const stage = document.getElementById('capture-stage');\n      const cw = parseInt(stage.getAttribute('data-width') || 800, 10);\n      const ch = parseInt(stage.getAttribute('data-height') || 800, 10);\n\n      const panX = vp.pan_x !== undefined ? vp.pan_x : 0;\n      const panY = vp.pan_y !== undefined ? vp.pan_y : 0;\n      const zoom = vp.zoom !== undefined ? vp.zoom : 1.0;\n\n      // Build internal SVG representation\n      let svg = `<svg viewBox=\"0 0 ${cw} ${ch}\" width=\"${cw}\" height=\"${ch}\" xmlns=\"http://www.w3.org/2000/svg\" style=\"background:#000000;width:100%;height:100%;\">\n        <defs>\n          <marker id=\"arr\" viewBox=\"0 0 10 10\" refX=\"8\" refY=\"5\" markerWidth=\"6\" markerHeight=\"6\" orient=\"auto-start-reverse\">\n            <path d=\"M 0 1.5 L 8 5 L 0 8.5 z\" fill=\"#FFFFFF\" />\n          </marker>\n          <marker id=\"arr-red\" viewBox=\"0 0 10 10\" refX=\"8\" refY=\"5\" markerWidth=\"7\" markerHeight=\"7\" orient=\"auto-start-reverse\">\n            <path d=\"M 0 1 L 9 5 L 0 9 z\" fill=\"#DE2626\" />\n          </marker>\n          <filter id=\"red-glow\" x=\"-20%\" y=\"-20%\" width=\"140%\" height=\"140%\">\n            <feGaussianBlur stdDeviation=\"6\" result=\"blur\" />\n            <feMerge><feMergeNode in=\"blur\" /><feMergeNode in=\"SourceGraphic\" /></feMerge>\n          </filter>\n        </defs>\n        <g id=\"viewport-group\" transform=\"translate(${panX}, ${panY}) scale(${zoom})\">`;\n\n      const shapeMap = {};\n      (diag.shapes || []).forEach(s => {\n        const sid = s.id || s.tempId;\n        if (sid) shapeMap[sid] = s;\n      });\n\n      // Territories\n      (diag.territories || []).forEach(t => {\n        const sz = t.size || 200;\n        const color = t.color || '#DE2626';\n        svg += `<rect x=\"${t.cx - sz/2}\" y=\"${t.cy - sz/2}\" width=\"${sz}\" height=\"${sz}\" rx=\"16\" fill=\"${color}\" fill-opacity=\"0.05\" stroke=\"${color}\" stroke-opacity=\"0.3\" stroke-width=\"1.5\" stroke-dasharray=\"6,4\" />`;\n        if (t.label) {\n          svg += `<text x=\"${t.cx}\" y=\"${t.cy - sz/2 + 20}\" fill=\"${color}\" font-size=\"11\" font-family=\"monospace\" font-weight=\"bold\" letter-spacing=\"1\" text-anchor=\"middle\">${t.label.toUpperCase()}</text>`;\n        }\n      });\n\n      // Connectors\n      (diag.connectors || []).forEach(c => {\n        const fid = c.from || c.fromTempId;\n        const tid = c.to || c.toTempId;\n        if (shapeMap[fid] && shapeMap[tid]) {\n          const s1 = shapeMap[fid];\n          const s2 = shapeMap[tid];\n          const isAct = activeConns.has(`${fid}->${tid}`) || (activeShapes.has(fid) && activeShapes.has(tid));\n          const col = isAct ? '#DE2626' : '#FFFFFF';\n          const mkr = isAct ? 'url(#arr-red)' : 'url(#arr)';\n          svg += `<line x1=\"${s1.cx}\" y1=\"${s1.cy}\" x2=\"${s2.cx}\" y2=\"${s2.cy}\" stroke=\"${col}\" stroke-width=\"${isAct ? 2.5 : 1.5}\" stroke-opacity=\"${isAct ? 1 : 0.4}\" marker-end=\"${mkr}\" />`;\n        }\n      });\n\n      // Shapes\n      (diag.shapes || []).forEach(s => {\n        const sid = s.id || s.tempId;\n        const w = s.sizeClass === 'small' ? 120 : (s.sizeClass === 'large' ? 300 : 200);\n        const h = s.sizeClass === 'small' ? 70 : (s.sizeClass === 'large' ? 150 : 100);\n        const isAct = activeShapes.has(sid);\n        const isDim = dimmedShapes.has(sid);\n        const col = isAct ? '#DE2626' : '#FFFFFF';\n        const bg = isAct ? '#1c0d0d' : '#121218';\n        const glow = isAct ? 'filter=\"url(#red-glow)\"' : '';\n        const op = isDim ? '0.25' : '1.0';\n\n        svg += `<g id=\"s-${sid}\" opacity=\"${op}\">\n          <rect x=\"${s.cx - w/2}\" y=\"${s.cy - h/2}\" width=\"${w}\" height=\"${h}\" rx=\"8\" fill=\"${bg}\" stroke=\"${col}\" stroke-width=\"${isAct ? 2.5 : 1.2}\" ${glow} />\n          <text x=\"${s.cx - w/2 + 12}\" y=\"${s.cy - h/2 + 24}\" fill=\"#FFFFFF\" font-size=\"12\" font-family=\"-apple-system, sans-serif\" font-weight=\"bold\">${s.label || sid}</text>`;\n        if (s.text) {\n          svg += `<text x=\"${s.cx - w/2 + 12}\" y=\"${s.cy - h/2 + 42}\" fill=\"#737373\" font-size=\"10\" font-family=\"-apple-system, sans-serif\">${(s.text || '').substring(0, 32)}</text>`;\n        }\n        if (isAct) {\n          svg += `<circle cx=\"${s.cx + w/2 - 12}\" cy=\"${s.cy - h/2 + 12}\" r=\"4\" fill=\"#DE2626\" />`;\n        }\n        svg += `</g>`;\n      });\n\n      svg += `</g>`;\n\n      if (st.badge_text) {\n        svg += `<g id=\"canvas-hud\">\n          <rect x=\"20\" y=\"20\" width=\"300\" height=\"34\" rx=\"4\" fill=\"#0c0c12\" fill-opacity=\"0.9\" stroke=\"#22222c\" stroke-width=\"1\" />\n          <circle cx=\"34\" cy=\"37\" r=\"4\" fill=\"#DE2626\" />\n          <text x=\"48\" y=\"41\" fill=\"#FFFFFF\" font-size=\"11\" font-family=\"monospace\" font-weight=\"bold\">${st.badge_text.toUpperCase()}</text>\n        </g>`;\n      }\n\n      svg += `</svg>`;\n      slot.innerHTML = svg;\n      window.isReadyToCapture = true;\n    };\n\n    window.pauseAnimation = function() {\n      document.querySelectorAll('#capture-stage *').forEach(el => {\n        el.style.animationPlayState = 'paused';\n      });\n    };\n\n    window.playAnimation = function() {\n      document.querySelectorAll('#capture-stage *').forEach(el => {\n        el.style.animationPlayState = 'running';\n      });\n    };\n  </script>\n</body>\n</html>\n",
      "0010d7a943858ded231a2cadb2e1710061502134c3fd40112bee04e6d2f42af7"
