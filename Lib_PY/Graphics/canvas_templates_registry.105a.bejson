      "#capture-stage",
      "Exemplar template template_icon_bejson_104_standard.html from /storage/emulated/0/Admin/Dev/Templates/Canvas_SVG_Capture_Templates",
      "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"UTF-8\">\n  <title>BEJSON 104 Icon \u2014 Standard Monolith Cube</title>\n  <style>\n    * { box-sizing: border-box; margin: 0; padding: 0; }\n    body {\n      background: #000000;\n      color: #FFFFFF;\n      width: 100vw;\n      height: 100vh;\n      display: flex;\n      align-items: center;\n      justify-content: center;\n      overflow: hidden;\n      font-family: monospace;\n    }\n    #capture-stage {\n      position: relative;\n      width: 512px;\n      height: 512px;\n      background: #000000;\n      overflow: hidden;\n      display: flex;\n      align-items: center;\n      justify-content: center;\n    }\n    .svg-container { width: 100%; height: 100%; display: flex; align-items: center; justify-content: center; }\n    svg { width: 100%; height: 100%; display: block; }\n\n    @keyframes pulseCore {\n      0%, 100% {\n        transform: scale(1);\n        filter: drop-shadow(0 0 10px rgba(222, 38, 38, 0.4));\n      }\n      50% {\n        transform: scale(1.05);\n        filter: drop-shadow(0 0 24px rgba(222, 38, 38, 0.9));\n      }\n    }\n    @keyframes orbitReticle {\n      0% { transform: rotate(0deg); }\n      100% { transform: rotate(360deg); }\n    }\n    @keyframes counterSpin {\n      0% { transform: rotate(0deg); }\n      100% { transform: rotate(-360deg); }\n    }\n    @keyframes vertexPulse {\n      0%, 100% { fill: #FFFFFF; r: 4px; }\n      50% { fill: #DE2626; r: 6px; filter: drop-shadow(0 0 6px #DE2626); }\n    }\n\n    .anim-core { transform-origin: 256px 256px; animation: pulseCore 4s ease-in-out infinite; }\n    .anim-orbit { transform-origin: 256px 256px; animation: orbitReticle 12s linear infinite; }\n    .anim-counter { transform-origin: 256px 256px; animation: counterSpin 16s linear infinite; }\n    .anim-vertex { animation: vertexPulse 2s ease-in-out infinite; }\n  </style>\n</head>\n<body>\n  <div id=\"capture-stage\">\n    <div class=\"svg-container\">\n      <svg viewBox=\"0 0 512 512\" xmlns=\"http://www.w3.org/2000/svg\">\n        <defs>\n          <linearGradient id=\"bgGrad\" x1=\"0\" y1=\"0\" x2=\"1\" y2=\"1\">\n            <stop offset=\"0%\" stop-color=\"#0c0c12\"/>\n            <stop offset=\"100%\" stop-color=\"#020204\"/>\n          </linearGradient>\n          <linearGradient id=\"topFace\" x1=\"0\" y1=\"0\" x2=\"1\" y2=\"1\">\n            <stop offset=\"0%\" stop-color=\"#FFFFFF\"/>\n            <stop offset=\"100%\" stop-color=\"#CCCCCC\"/>\n          </linearGradient>\n          <linearGradient id=\"leftFace\" x1=\"0\" y1=\"0\" x2=\"0\" y2=\"1\">\n            <stop offset=\"0%\" stop-color=\"#2c2c3a\"/>\n            <stop offset=\"100%\" stop-color=\"#14141c\"/>\n          </linearGradient>\n          <linearGradient id=\"rightFace\" x1=\"0\" y1=\"0\" x2=\"0\" y2=\"1\">\n            <stop offset=\"0%\" stop-color=\"#1e1e28\"/>\n            <stop offset=\"100%\" stop-color=\"#0d0d14\"/>\n          </linearGradient>\n        </defs>\n\n        <!-- Squircle Base Frame -->\n        <rect x=\"24\" y=\"24\" width=\"464\" height=\"464\" rx=\"108\" fill=\"url(#bgGrad)\" stroke=\"#222230\" stroke-width=\"3\"/>\n        <rect x=\"32\" y=\"32\" width=\"448\" height=\"448\" rx=\"100\" fill=\"none\" stroke=\"#DE2626\" stroke-width=\"1.5\" stroke-dasharray=\"10 8\" opacity=\"0.6\"/>\n\n        <!-- Counter-rotating Outer Telemetry Ring -->\n        <g class=\"anim-counter\">\n          <circle cx=\"256\" cy=\"256\" r=\"192\" fill=\"none\" stroke=\"#181822\" stroke-width=\"1.5\"/>\n          <circle cx=\"256\" cy=\"256\" r=\"192\" fill=\"none\" stroke=\"#FFFFFF\" stroke-width=\"2\" stroke-dasharray=\"12 180\" opacity=\"0.4\"/>\n        </g>\n\n        <!-- Orbiting Reticle -->\n        <g class=\"anim-orbit\">\n          <circle cx=\"256\" cy=\"256\" r=\"160\" fill=\"none\" stroke=\"#252535\" stroke-width=\"1.5\"/>\n          <circle cx=\"256\" cy=\"256\" r=\"160\" fill=\"none\" stroke=\"#DE2626\" stroke-width=\"3\" stroke-dasharray=\"40 120\" stroke-linecap=\"round\"/>\n          <circle cx=\"416\" cy=\"256\" r=\"5\" fill=\"#DE2626\" filter=\"drop-shadow(0 0 4px #DE2626)\"/>\n          <circle cx=\"96\" cy=\"256\" r=\"5\" fill=\"#DE2626\" filter=\"drop-shadow(0 0 4px #DE2626)\"/>\n        </g>\n\n        <!-- Inner Target Reticle -->\n        <circle cx=\"256\" cy=\"256\" r=\"128\" fill=\"none\" stroke=\"#1f1f2c\" stroke-width=\"1.5\"/>\n        <line x1=\"256\" y1=\"96\" x2=\"256\" y2=\"112\" stroke=\"#DE2626\" stroke-width=\"2\"/>\n        <line x1=\"256\" y1=\"400\" x2=\"256\" y2=\"416\" stroke=\"#DE2626\" stroke-width=\"2\"/>\n        <line x1=\"96\" y1=\"256\" x2=\"112\" y2=\"256\" stroke=\"#DE2626\" stroke-width=\"2\"/>\n        <line x1=\"400\" y1=\"256\" x2=\"416\" y2=\"256\" stroke=\"#DE2626\" stroke-width=\"2\"/>\n\n        <!-- 104 Standard Monolith Cube Core -->\n        <g class=\"anim-core\">\n          <!-- Top Face -->\n          <polygon points=\"256,156 346,208 256,260 166,208\" fill=\"url(#topFace)\" stroke=\"#DE2626\" stroke-width=\"2\"/>\n          <!-- Left Face -->\n          <polygon points=\"256,260 166,208 166,312 256,364\" fill=\"url(#leftFace)\" stroke=\"#3a3a4e\" stroke-width=\"2\"/>\n          <!-- Right Face -->\n          <polygon points=\"256,260 346,208 346,312 256,364\" fill=\"url(#rightFace)\" stroke=\"#3a3a4e\" stroke-width=\"2\"/>\n\n          <!-- Accent Center Seam -->\n          <line x1=\"256\" y1=\"260\" x2=\"256\" y2=\"364\" stroke=\"#DE2626\" stroke-width=\"3\"/>\n\n          <!-- Vertex Indicator Nodes -->\n          <circle cx=\"256\" cy=\"156\" class=\"anim-vertex\"/>\n          <circle cx=\"346\" cy=\"208\" class=\"anim-vertex\"/>\n          <circle cx=\"166\" cy=\"208\" class=\"anim-vertex\"/>\n          <circle cx=\"256\" cy=\"260\" class=\"anim-vertex\"/>\n          <circle cx=\"166\" cy=\"312\" class=\"anim-vertex\"/>\n          <circle cx=\"346\" cy=\"312\" class=\"anim-vertex\"/>\n          <circle cx=\"256\" cy=\"364\" class=\"anim-vertex\"/>\n        </g>\n\n        <!-- Monogram & Telemetry Labels -->\n        <text x=\"256\" y=\"440\" fill=\"#DE2626\" font-size=\"14\" font-family=\"monospace\" font-weight=\"700\" letter-spacing=\"4\" text-anchor=\"middle\">BEJSON 104</text>\n        <text x=\"256\" y=\"458\" fill=\"#555566\" font-size=\"10\" font-family=\"monospace\" letter-spacing=\"2\" text-anchor=\"middle\">STANDARD CUBE</text>\n      </svg>\n    </div>\n  </div>\n\n  <script>\n    window.isReadyToCapture = false;\n    window.pauseAnimation = function() { document.querySelectorAll('*').forEach(el => el.style.animationPlayState = 'paused'); };\n    window.playAnimation = function() { document.querySelectorAll('*').forEach(el => el.style.animationPlayState = 'running'); };\n    window.seekProgress = function(progress) {\n      const dur = 4.0;\n      const t = progress * dur;\n      document.querySelectorAll('*').forEach(el => {\n        el.style.animationDelay = `-${t}s`;\n        el.style.animationPlayState = 'paused';\n      });\n    };\n    window.addEventListener('DOMContentLoaded', () => { setTimeout(() => { window.isReadyToCapture = true; }, 300); });\n  </script>\n</body>\n</html>\n",
