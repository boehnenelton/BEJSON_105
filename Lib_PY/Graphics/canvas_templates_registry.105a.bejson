      "c5999158-4d01-4886-abea-591bff8e4a16",
      "legacy_template_icon_bejson_104_nested",
      "template_icon_bejson_104_nested.html",
      "legacy_exemplar",
      800,
      800,
      "800:800",
      "#capture-stage",
      "Exemplar template template_icon_bejson_104_nested.html from /storage/emulated/0/Admin/Dev/Templates/Canvas_SVG_Capture_Templates",
      "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"UTF-8\">\n  <title>BEJSON Nested Icon \u2014 Nested 104 Cube Complex</title>\n  <style>\n    * { box-sizing: border-box; margin: 0; padding: 0; }\n    body {\n      background: #000000;\n      color: #FFFFFF;\n      width: 100vw;\n      height: 100vh;\n      display: flex;\n      align-items: center;\n      justify-content: center;\n      overflow: hidden;\n      font-family: monospace;\n    }\n    #capture-stage {\n      position: relative;\n      width: 512px;\n      height: 512px;\n      background: #000000;\n      overflow: hidden;\n      display: flex;\n      align-items: center;\n      justify-content: center;\n    }\n    .svg-container { width: 100%; height: 100%; display: flex; align-items: center; justify-content: center; }\n    svg { width: 100%; height: 100%; display: block; }\n\n    @keyframes rotateInner {\n      0% { transform: scale(1) rotate(0deg); }\n      50% { transform: scale(1.12) rotate(180deg); filter: drop-shadow(0 0 16px rgba(222, 38, 38, 0.9)); }\n      100% { transform: scale(1) rotate(360deg); }\n    }\n    @keyframes pulseOuterWire {\n      0%, 100% { stroke: #333344; stroke-width: 1.5; }\n      50% { stroke: #DE2626; stroke-width: 2.5; filter: drop-shadow(0 0 8px rgba(222, 38, 38, 0.6)); }\n    }\n\n    .anim-inner { transform-origin: 256px 256px; animation: rotateInner 8s ease-in-out infinite; }\n    .anim-wire { animation: pulseOuterWire 4s ease-in-out infinite; }\n  </style>\n</head>\n<body>\n  <div id=\"capture-stage\">\n    <div class=\"svg-container\">\n      <svg viewBox=\"0 0 512 512\" xmlns=\"http://www.w3.org/2000/svg\">\n        <defs>\n          <linearGradient id=\"bgGradNested\" x1=\"0\" y1=\"0\" x2=\"1\" y2=\"1\">\n            <stop offset=\"0%\" stop-color=\"#0b0b12\"/>\n            <stop offset=\"100%\" stop-color=\"#020204\"/>\n          </linearGradient>\n          <linearGradient id=\"innerTop\" x1=\"0\" y1=\"0\" x2=\"1\" y2=\"1\">\n            <stop offset=\"0%\" stop-color=\"#FFFFFF\"/>\n            <stop offset=\"100%\" stop-color=\"#DE2626\"/>\n          </linearGradient>\n        </defs>\n\n        <!-- Squircle Shell -->\n        <rect x=\"24\" y=\"24\" width=\"464\" height=\"464\" rx=\"108\" fill=\"url(#bgGradNested)\" stroke=\"#1e1e2c\" stroke-width=\"3\"/>\n        <rect x=\"32\" y=\"32\" width=\"448\" height=\"448\" rx=\"100\" fill=\"none\" stroke=\"#DE2626\" stroke-width=\"1.5\" stroke-dasharray=\"10 6\" opacity=\"0.5\"/>\n\n        <!-- Outer Wireframe Cube (Parent Container, Depth 0) -->\n        <g class=\"anim-wire\">\n          <!-- Top Wire -->\n          <polygon points=\"256,120 376,188 256,256 136,188\" fill=\"none\" stroke-linecap=\"round\"/>\n          <!-- Base Wire -->\n          <polygon points=\"256,392 376,324 376,188 256,256\" fill=\"none\" stroke-linecap=\"round\"/>\n          <polygon points=\"256,392 136,324 136,188 256,256\" fill=\"none\" stroke-linecap=\"round\"/>\n          <!-- Outer Center Spine -->\n          <line x1=\"256\" y1=\"256\" x2=\"256\" y2=\"392\" stroke=\"#DE2626\" stroke-width=\"2\"/>\n        </g>\n\n        <!-- Dynamic Ray Connectors from Outer Vertices to Center -->\n        <line x1=\"136\" y1=\"188\" x2=\"216\" y2=\"236\" stroke=\"#DE2626\" stroke-width=\"1\" stroke-dasharray=\"4 4\" opacity=\"0.6\"/>\n        <line x1=\"376\" y1=\"188\" x2=\"296\" y2=\"236\" stroke=\"#DE2626\" stroke-width=\"1\" stroke-dasharray=\"4 4\" opacity=\"0.6\"/>\n        <line x1=\"256\" y1=\"120\" x2=\"256\" y2=\"216\" stroke=\"#DE2626\" stroke-width=\"1\" stroke-dasharray=\"4 4\" opacity=\"0.6\"/>\n        <line x1=\"256\" y1=\"392\" x2=\"256\" y2=\"296\" stroke=\"#DE2626\" stroke-width=\"1\" stroke-dasharray=\"4 4\" opacity=\"0.6\"/>\n\n        <!-- Inner Solid Cube (Nested Child Entity, Depth 1) -->\n        <g class=\"anim-inner\">\n          <!-- Top Face -->\n          <polygon points=\"256,216 296,236 256,256 216,236\" fill=\"url(#innerTop)\" stroke=\"#DE2626\" stroke-width=\"2\"/>\n          <!-- Left Face -->\n          <polygon points=\"256,256 216,236 216,276 256,296\" fill=\"#301518\" stroke=\"#DE2626\" stroke-width=\"2\"/>\n          <!-- Right Face -->\n          <polygon points=\"256,256 296,236 296,276 256,296\" fill=\"#1b0c0e\" stroke=\"#DE2626\" stroke-width=\"2\"/>\n          <!-- Center Spine -->\n          <line x1=\"256\" y1=\"256\" x2=\"256\" y2=\"296\" stroke=\"#FFFFFF\" stroke-width=\"2\"/>\n          <circle cx=\"256\" cy=\"256\" r=\"3.5\" fill=\"#FFFFFF\"/>\n        </g>\n\n        <!-- Corner Micro-Brackets -->\n        <path d=\"M 64 64 L 76 64 M 64 64 L 64 76\" stroke=\"#DE2626\" stroke-width=\"2\" fill=\"none\"/>\n        <path d=\"M 448 64 L 436 64 M 448 64 L 448 76\" stroke=\"#DE2626\" stroke-width=\"2\" fill=\"none\"/>\n        <path d=\"M 64 448 L 76 448 M 64 448 L 64 436\" stroke=\"#DE2626\" stroke-width=\"2\" fill=\"none\"/>\n        <path d=\"M 448 448 L 436 448 M 448 448 L 448 436\" stroke=\"#DE2626\" stroke-width=\"2\" fill=\"none\"/>\n\n        <!-- Labels -->\n        <text x=\"256\" y=\"440\" fill=\"#DE2626\" font-size=\"15\" font-family=\"monospace\" font-weight=\"700\" letter-spacing=\"4\" text-anchor=\"middle\">BEJSON NESTED</text>\n        <text x=\"256\" y=\"458\" fill=\"#666677\" font-size=\"10\" font-family=\"monospace\" letter-spacing=\"2\" text-anchor=\"middle\">RECURSIVE CELL PAYLOAD</text>\n      </svg>\n    </div>\n  </div>\n\n  <script>\n    window.isReadyToCapture = false;\n    window.pauseAnimation = function() { document.querySelectorAll('*').forEach(el => el.style.animationPlayState = 'paused'); };\n    window.playAnimation = function() { document.querySelectorAll('*').forEach(el => el.style.animationPlayState = 'running'); };\n    window.seekProgress = function(progress) {\n      const dur = 4.0;\n      const t = progress * dur;\n      document.querySelectorAll('*').forEach(el => {\n        el.style.animationDelay = `-${t}s`;\n        el.style.animationPlayState = 'paused';\n      });\n    };\n    window.addEventListener('DOMContentLoaded', () => { setTimeout(() => { window.isReadyToCapture = true; }, 300); });\n  </script>\n</body>\n</html>\n",
