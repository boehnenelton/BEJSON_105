      "#capture-stage",
      "Exemplar template template_icon_bejson_104db_pillar.html from /storage/emulated/0/Admin/Dev/Templates/Canvas_SVG_Capture_Templates",
      "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"UTF-8\">\n  <title>BEJSON 104db Icon \u2014 Stacked Pillar</title>\n  <style>\n    * { box-sizing: border-box; margin: 0; padding: 0; }\n    body {\n      background: #000000;\n      color: #FFFFFF;\n      width: 100vw;\n      height: 100vh;\n      display: flex;\n      align-items: center;\n      justify-content: center;\n      overflow: hidden;\n      font-family: monospace;\n    }\n    #capture-stage {\n      position: relative;\n      width: 512px;\n      height: 512px;\n      background: #000000;\n      overflow: hidden;\n      display: flex;\n      align-items: center;\n      justify-content: center;\n    }\n    .svg-container { width: 100%; height: 100%; display: flex; align-items: center; justify-content: center; }\n    svg { width: 100%; height: 100%; display: block; }\n\n    @keyframes cascadeGlow1 {\n      0%, 100% { fill: #20202c; filter: none; }\n      20% { fill: #DE2626; filter: drop-shadow(0 0 10px #DE2626); }\n    }\n    @keyframes cascadeGlow2 {\n      0%, 100% { fill: #20202c; filter: none; }\n      50% { fill: #DE2626; filter: drop-shadow(0 0 10px #DE2626); }\n    }\n    @keyframes cascadeGlow3 {\n      0%, 100% { fill: #20202c; filter: none; }\n      80% { fill: #DE2626; filter: drop-shadow(0 0 10px #DE2626); }\n    }\n    @keyframes pulsePillar {\n      0%, 100% { transform: scale(1); }\n      50% { transform: scale(1.03); }\n    }\n\n    .anim-node1 { animation: cascadeGlow1 3s infinite; }\n    .anim-node2 { animation: cascadeGlow2 3s infinite; }\n    .anim-node3 { animation: cascadeGlow3 3s infinite; }\n    .anim-pillar { transform-origin: 256px 260px; animation: pulsePillar 4s ease-in-out infinite; }\n  </style>\n</head>\n<body>\n  <div id=\"capture-stage\">\n    <div class=\"svg-container\">\n      <svg viewBox=\"0 0 512 512\" xmlns=\"http://www.w3.org/2000/svg\">\n        <defs>\n          <linearGradient id=\"bgGrad104db\" x1=\"0\" y1=\"0\" x2=\"1\" y2=\"1\">\n            <stop offset=\"0%\" stop-color=\"#0a0a10\"/>\n            <stop offset=\"100%\" stop-color=\"#020204\"/>\n          </linearGradient>\n          <linearGradient id=\"topWhite\" x1=\"0\" y1=\"0\" x2=\"1\" y2=\"1\">\n            <stop offset=\"0%\" stop-color=\"#FFFFFF\"/>\n            <stop offset=\"100%\" stop-color=\"#CCCCCC\"/>\n          </linearGradient>\n        </defs>\n\n        <!-- Outer Squircle Frame -->\n        <rect x=\"24\" y=\"24\" width=\"464\" height=\"464\" rx=\"108\" fill=\"url(#bgGrad104db)\" stroke=\"#202030\" stroke-width=\"3\"/>\n        <rect x=\"32\" y=\"32\" width=\"448\" height=\"448\" rx=\"100\" fill=\"none\" stroke=\"#DE2626\" stroke-width=\"1.5\" stroke-dasharray=\"10 6\" opacity=\"0.6\"/>\n\n        <!-- Vertical Rail Accents -->\n        <line x1=\"120\" y1=\"64\" x2=\"120\" y2=\"448\" stroke=\"#1c1c28\" stroke-width=\"1.5\"/>\n        <line x1=\"392\" y1=\"64\" x2=\"392\" y2=\"448\" stroke=\"#1c1c28\" stroke-width=\"1.5\"/>\n        <line x1=\"120\" y1=\"200\" x2=\"120\" y2=\"300\" stroke=\"#DE2626\" stroke-width=\"2\"/>\n        <line x1=\"392\" y1=\"200\" x2=\"392\" y2=\"300\" stroke=\"#DE2626\" stroke-width=\"2\"/>\n\n        <g class=\"anim-pillar\">\n          <!-- Cube 1 (Bottom Tier) -->\n          <g transform=\"translate(0, 110)\">\n            <polygon points=\"256,230 326,270 256,310 186,270\" fill=\"#20202c\" stroke=\"#3d3d52\" stroke-width=\"2\"/>\n            <polygon points=\"256,310 186,270 186,340 256,380\" fill=\"#181822\" stroke=\"#3d3d52\" stroke-width=\"2\"/>\n            <polygon points=\"256,310 326,270 326,340 256,380\" fill=\"#101018\" stroke=\"#3d3d52\" stroke-width=\"2\"/>\n            <line x1=\"256\" y1=\"310\" x2=\"256\" y2=\"380\" stroke=\"#DE2626\" stroke-width=\"2.5\"/>\n            <circle cx=\"256\" cy=\"310\" r=\"4\" class=\"anim-node3\"/>\n          </g>\n\n          <!-- Cube 2 (Middle Tier) -->\n          <g transform=\"translate(0, 40)\">\n            <polygon points=\"256,180 326,220 256,260 186,220\" fill=\"#2c2c3d\" stroke=\"#484860\" stroke-width=\"2\"/>\n            <polygon points=\"256,260 186,220 186,290 256,330\" fill=\"#20202c\" stroke=\"#484860\" stroke-width=\"2\"/>\n            <polygon points=\"256,260 326,220 326,290 256,330\" fill=\"#161620\" stroke=\"#484860\" stroke-width=\"2\"/>\n            <line x1=\"256\" y1=\"260\" x2=\"256\" y2=\"330\" stroke=\"#DE2626\" stroke-width=\"2.5\"/>\n            <circle cx=\"256\" cy=\"260\" r=\"4\" class=\"anim-node2\"/>\n          </g>\n\n          <!-- Cube 3 (Top Tier Monolith) -->\n          <g transform=\"translate(0, -30)\">\n            <polygon points=\"256,130 326,170 256,210 186,170\" fill=\"url(#topWhite)\" stroke=\"#DE2626\" stroke-width=\"2\"/>\n            <polygon points=\"256,210 186,170 186,240 256,280\" fill=\"#2c2c3d\" stroke=\"#DE2626\" stroke-width=\"2\"/>\n            <polygon points=\"256,210 326,170 326,240 256,280\" fill=\"#1c1c28\" stroke=\"#DE2626\" stroke-width=\"2\"/>\n            <line x1=\"256\" y1=\"210\" x2=\"256\" y2=\"280\" stroke=\"#DE2626\" stroke-width=\"3\"/>\n            <circle cx=\"256\" cy=\"130\" r=\"5\" fill=\"#DE2626\"/>\n            <circle cx=\"256\" cy=\"210\" r=\"4.5\" class=\"anim-node1\"/>\n          </g>\n        </g>\n\n        <!-- Title & Spec Labels -->\n        <text x=\"256\" y=\"80\" fill=\"#DE2626\" font-size=\"15\" font-family=\"monospace\" font-weight=\"700\" letter-spacing=\"4\" text-anchor=\"middle\">BEJSON 104db</text>\n        <text x=\"256\" y=\"98\" fill=\"#666677\" font-size=\"10\" font-family=\"monospace\" letter-spacing=\"2\" text-anchor=\"middle\">STACKED PILLAR TAXONOMY</text>\n      </svg>\n    </div>\n  </div>\n\n  <script>\n    window.isReadyToCapture = false;\n    window.pauseAnimation = function() { document.querySelectorAll('*').forEach(el => el.style.animationPlayState = 'paused'); };\n    window.playAnimation = function() { document.querySelectorAll('*').forEach(el => el.style.animationPlayState = 'running'); };\n    window.seekProgress = function(progress) {\n      const dur = 3.0;\n      const t = progress * dur;\n      document.querySelectorAll('*').forEach(el => {\n        el.style.animationDelay = `-${t}s`;\n        el.style.animationPlayState = 'paused';\n      });\n    };\n    window.addEventListener('DOMContentLoaded', () => { setTimeout(() => { window.isReadyToCapture = true; }, 300); });\n  </script>\n</body>\n</html>\n",
