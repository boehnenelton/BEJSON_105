      "98748fb3-bffa-427d-8e4a-5af8cc823846",
      "legacy_template_icon_256x256",
      "template_icon_256x256.html",
      "legacy_exemplar",
      256,
      256,
      "256:256",
      "#capture-stage",
      "Exemplar template template_icon_256x256.html from /storage/emulated/0/Admin/Dev/Templates/Canvas_SVG_Capture_Templates",
      "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"UTF-8\">\n  <title>Canvas Icon \u2014 256x256 App Icon</title>\n  <style>\n    * {\n      box-sizing: border-box;\n      margin: 0;\n      padding: 0;\n    }\n    body {\n      background: #000000;\n      color: #FFFFFF;\n      width: 100vw;\n      height: 100vh;\n      display: flex;\n      align-items: center;\n      justify-content: center;\n      overflow: hidden;\n      font-family: monospace;\n    }\n    #capture-stage {\n      position: relative;\n      width: 256px;\n      height: 256px;\n      background: #000000;\n      overflow: hidden;\n      display: flex;\n      align-items: center;\n      justify-content: center;\n    }\n    .svg-container {\n      width: 100%;\n      height: 100%;\n      display: flex;\n      align-items: center;\n      justify-content: center;\n    }\n    svg {\n      width: 100%;\n      height: 100%;\n      display: block;\n    }\n\n    @keyframes pulseCore {\n      0%, 100% {\n        transform: scale(1);\n        filter: drop-shadow(0 0 6px rgba(222, 38, 38, 0.4));\n      }\n      50% {\n        transform: scale(1.06);\n        filter: drop-shadow(0 0 16px rgba(222, 38, 38, 0.9));\n      }\n    }\n    @keyframes spinRays {\n      0% { transform: rotate(0deg); }\n      100% { transform: rotate(360deg); }\n    }\n\n    .anim-core {\n      transform-origin: 128px 128px;\n      animation: pulseCore 3.5s ease-in-out infinite;\n    }\n    .anim-spin {\n      transform-origin: 128px 128px;\n      animation: spinRays 10s linear infinite;\n    }\n  </style>\n</head>\n<body>\n  <div id=\"capture-stage\">\n    <div class=\"svg-container\">\n      <svg viewBox=\"0 0 256 256\" xmlns=\"http://www.w3.org/2000/svg\">\n        <defs>\n          <linearGradient id=\"bg256\" x1=\"0\" y1=\"0\" x2=\"1\" y2=\"1\">\n            <stop offset=\"0%\" stop-color=\"#0f0f14\"/>\n            <stop offset=\"100%\" stop-color=\"#000000\"/>\n          </linearGradient>\n        </defs>\n\n        <!-- Squircle Body -->\n        <rect x=\"12\" y=\"12\" width=\"232\" height=\"232\" rx=\"54\" fill=\"url(#bg256)\" stroke=\"#262633\" stroke-width=\"2\"/>\n        <rect x=\"18\" y=\"18\" width=\"220\" height=\"220\" rx=\"48\" fill=\"none\" stroke=\"#DE2626\" stroke-width=\"1.2\" stroke-dasharray=\"6 4\" opacity=\"0.5\"/>\n\n        <!-- Rotating Outer Ray Ring -->\n        <g class=\"anim-spin\">\n          <circle cx=\"128\" cy=\"128\" r=\"88\" fill=\"none\" stroke=\"#1f1f28\" stroke-width=\"1.5\"/>\n          <line x1=\"128\" y1=\"36\" x2=\"128\" y2=\"44\" stroke=\"#DE2626\" stroke-width=\"2\"/>\n          <line x1=\"128\" y1=\"212\" x2=\"128\" y2=\"220\" stroke=\"#DE2626\" stroke-width=\"2\"/>\n          <line x1=\"36\" y1=\"128\" x2=\"44\" y2=\"128\" stroke=\"#DE2626\" stroke-width=\"2\"/>\n          <line x1=\"212\" y1=\"128\" x2=\"220\" y2=\"128\" stroke=\"#DE2626\" stroke-width=\"2\"/>\n        </g>\n\n        <!-- Hexagonal Reticle -->\n        <polygon points=\"128,58 188,93 188,163 128,198 68,163 68,93\" fill=\"none\" stroke=\"#2a2a38\" stroke-width=\"1.5\"/>\n\n        <!-- Core Isometric Cube -->\n        <g class=\"anim-core\">\n          <!-- Top Face -->\n          <polygon points=\"128,88 168,111 128,134 88,111\" fill=\"#FFFFFF\" stroke=\"#DE2626\" stroke-width=\"1.5\"/>\n          <!-- Left Face -->\n          <polygon points=\"128,134 88,111 88,157 128,180\" fill=\"#22222c\" stroke=\"#333344\" stroke-width=\"1.5\"/>\n          <!-- Right Face -->\n          <polygon points=\"128,134 168,111 168,157 128,180\" fill=\"#14141c\" stroke=\"#333344\" stroke-width=\"1.5\"/>\n          <!-- Red Center Spine -->\n          <line x1=\"128\" y1=\"134\" x2=\"128\" y2=\"180\" stroke=\"#DE2626\" stroke-width=\"2\"/>\n          <!-- Center Pulse Pip -->\n          <circle cx=\"128\" cy=\"134\" r=\"3\" fill=\"#DE2626\"/>\n        </g>\n\n        <!-- Corner Ticks -->\n        <line x1=\"36\" y1=\"36\" x2=\"44\" y2=\"36\" stroke=\"#DE2626\" stroke-width=\"1.5\"/>\n        <line x1=\"36\" y1=\"36\" x2=\"36\" y2=\"44\" stroke=\"#DE2626\" stroke-width=\"1.5\"/>\n        <line x1=\"220\" y1=\"36\" x2=\"212\" y2=\"36\" stroke=\"#DE2626\" stroke-width=\"1.5\"/>\n        <line x1=\"220\" y1=\"36\" x2=\"220\" y2=\"44\" stroke=\"#DE2626\" stroke-width=\"1.5\"/>\n      </svg>\n    </div>\n  </div>\n\n  <script>\n    window.isReadyToCapture = false;\n    window.pauseAnimation = function() {\n      document.querySelectorAll('*').forEach(el => el.style.animationPlayState = 'paused');\n    };\n    window.playAnimation = function() {\n      document.querySelectorAll('*').forEach(el => el.style.animationPlayState = 'running');\n    };\n    window.seekProgress = function(progress) {\n      const totalDurationSec = 3.5;\n      const targetTimeSec = progress * totalDurationSec;\n      document.querySelectorAll('*').forEach(el => {\n        el.style.animationDelay = `-${targetTimeSec}s`;\n        el.style.animationPlayState = 'paused';\n      });\n    };\n    window.addEventListener('DOMContentLoaded', () => {\n      setTimeout(() => { window.isReadyToCapture = true; }, 300);\n    });\n  </script>\n</body>\n</html>\n",
