    [
      "b4086052-b7f8-4a41-af18-e2e8d1420cb3",
      "legacy_template_newagent_article_hero_1280x640",
      "template_newagent_article_hero_1280x640.html",
      "legacy_exemplar",
      1280,
      640,
      "1280:640",
      "#capture-stage",
      "Exemplar template template_newagent_article_hero_1280x640.html from /storage/emulated/0/Admin/Dev/Templates/Canvas_SVG_Capture_Templates",
      "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"UTF-8\">\n  <title>NewAgent Article Hero \u2014 1280x640</title>\n  <style>\n    * {\n      box-sizing: border-box;\n      margin: 0;\n      padding: 0;\n    }\n    body {\n      background: #000000;\n      color: #FFFFFF;\n      width: 100vw;\n      height: 100vh;\n      display: flex;\n      align-items: center;\n      justify-content: center;\n      overflow: hidden;\n      font-family: -apple-system, BlinkMacSystemFont, \"Segoe UI\", Roboto, monospace;\n    }\n    #capture-stage {\n      position: relative;\n      width: 1280px;\n      height: 640px;\n      background: #000000;\n      border: 1px solid #1a1a22;\n      overflow: hidden;\n      display: flex;\n      align-items: center;\n      justify-content: center;\n    }\n    .svg-container {\n      width: 100%;\n      height: 100%;\n    }\n    svg {\n      width: 100%;\n      height: 100%;\n      display: block;\n    }\n    @keyframes pulseRed {\n      0%, 100% {\n        stroke: #DE2626;\n        filter: drop-shadow(0 0 6px rgba(222, 38, 38, 0.6));\n      }\n      50% {\n        stroke: #ff4d4d;\n        filter: drop-shadow(0 0 16px rgba(222, 38, 38, 0.9));\n      }\n    }\n    @keyframes coreFloat {\n      0%, 100% {\n        transform: translateY(0);\n      }\n      50% {\n        transform: translateY(-8px);\n      }\n    }\n    .anim-pulse {\n      animation: pulseRed 3s ease-in-out infinite;\n    }\n    .anim-core {\n      animation: coreFloat 4s ease-in-out infinite;\n    }\n  </style>\n</head>\n<body>\n  <div id=\"capture-stage\" data-width=\"1280\" data-height=\"640\" data-ratio=\"2:1\">\n    <div class=\"svg-container\">\n      <svg id=\"svg-root\" viewBox=\"0 0 1280 640\" xmlns=\"http://www.w3.org/2000/svg\">\n        <defs>\n          <radialGradient id=\"stageGlow\" cx=\"50%\" cy=\"45%\" r=\"65%\">\n            <stop offset=\"0%\" stop-color=\"#1c0707\" stop-opacity=\"0.95\" />\n            <stop offset=\"50%\" stop-color=\"#08080c\" stop-opacity=\"0.7\" />\n            <stop offset=\"100%\" stop-color=\"#000000\" stop-opacity=\"1\" />\n          </radialGradient>\n          <linearGradient id=\"cubeTop\" x1=\"0%\" y1=\"0%\" x2=\"100%\" y2=\"100%\">\n            <stop offset=\"0%\" stop-color=\"#FFFFFF\" />\n            <stop offset=\"100%\" stop-color=\"#CCCCCC\" />\n          </linearGradient>\n          <linearGradient id=\"cubeLeft\" x1=\"0%\" y1=\"0%\" x2=\"100%\" y2=\"100%\">\n            <stop offset=\"0%\" stop-color=\"#888888\" />\n            <stop offset=\"100%\" stop-color=\"#444444\" />\n          </linearGradient>\n          <linearGradient id=\"cubeRight\" x1=\"0%\" y1=\"0%\" x2=\"100%\" y2=\"100%\">\n            <stop offset=\"0%\" stop-color=\"#666666\" />\n            <stop offset=\"100%\" stop-color=\"#222222\" />\n          </linearGradient>\n          <linearGradient id=\"accentBeam\" x1=\"0%\" y1=\"0%\" x2=\"100%\" y2=\"0%\">\n            <stop offset=\"0%\" stop-color=\"#DE2626\" stop-opacity=\"0\" />\n            <stop offset=\"50%\" stop-color=\"#DE2626\" stop-opacity=\"1\" />\n            <stop offset=\"100%\" stop-color=\"#DE2626\" stop-opacity=\"0\" />\n          </linearGradient>\n        </defs>\n\n        <!-- Ambient Backdrop -->\n        <rect width=\"1280\" height=\"640\" fill=\"url(#stageGlow)\" />\n\n        <!-- 8-Lane X-Axis Production Grid (160px intervals) -->\n        <g opacity=\"0.08\" stroke=\"#FFFFFF\" stroke-width=\"1\">\n          <line x1=\"160\" y1=\"0\" x2=\"160\" y2=\"640\" />\n          <line x1=\"320\" y1=\"0\" x2=\"320\" y2=\"640\" />\n          <line x1=\"480\" y1=\"0\" x2=\"480\" y2=\"640\" />\n          <line x1=\"640\" y1=\"0\" x2=\"640\" y2=\"640\" />\n          <line x1=\"800\" y1=\"0\" x2=\"800\" y2=\"640\" />\n          <line x1=\"960\" y1=\"0\" x2=\"960\" y2=\"640\" />\n          <line x1=\"1120\" y1=\"0\" x2=\"1120\" y2=\"640\" />\n          <!-- Quantized Horizontal Lines (32px Ry) -->\n          <line x1=\"0\" y1=\"96\" x2=\"1280\" y2=\"96\" />\n          <line x1=\"0\" y1=\"192\" x2=\"1280\" y2=\"192\" />\n          <line x1=\"0\" y1=\"320\" x2=\"1280\" y2=\"320\" />\n          <line x1=\"0\" y1=\"448\" x2=\"1280\" y2=\"448\" />\n          <line x1=\"0\" y1=\"544\" x2=\"1280\" y2=\"544\" />\n        </g>\n\n        <!-- Header HUD Telemetry Bar -->\n        <rect x=\"0\" y=\"0\" width=\"1280\" height=\"48\" fill=\"#08080a\" />\n        <line x1=\"0\" y1=\"48\" x2=\"1280\" y2=\"48\" stroke=\"#DE2626\" stroke-width=\"1.5\" />\n        <text x=\"32\" y=\"30\" fill=\"#DE2626\" font-size=\"13\" font-family=\"monospace\" font-weight=\"700\" letter-spacing=\"2\">NEWAGENT // ECOSYSTEM ARCHITECTURE</text>\n        <text x=\"640\" y=\"30\" fill=\"#777788\" font-size=\"11\" font-family=\"monospace\" text-anchor=\"middle\" letter-spacing=\"1\">RELATIONAL_ID: a84c9f12-0012-4f81-9b04-3e911284a105</text>\n        <text x=\"1248\" y=\"30\" fill=\"#AAAAAA\" font-size=\"12\" font-family=\"monospace\" text-anchor=\"end\" font-weight=\"600\">BEJSON 104a &bull; MFDB v1.40</text>\n\n        <!-- Laser Data Rays Connecting Subsystems to Central Core -->\n        <g stroke=\"#DE2626\" stroke-width=\"1.5\" opacity=\"0.75\" class=\"anim-pulse\">\n          <line x1=\"220\" y1=\"170\" x2=\"560\" y2=\"280\" />\n          <line x1=\"220\" y1=\"420\" x2=\"560\" y2=\"340\" />\n          <line x1=\"1060\" y1=\"170\" x2=\"720\" y2=\"280\" />\n          <line x1=\"1060\" y1=\"420\" x2=\"720\" y2=\"340\" />\n        </g>\n\n        <!-- Peripheral Component Nodes (Left Side) -->\n        <g transform=\"translate(140, 140)\">\n          <rect x=\"-10\" y=\"-16\" width=\"220\" height=\"60\" rx=\"4\" fill=\"#0c0c10\" stroke=\"#2a2a38\" stroke-width=\"1.5\" />\n          <rect x=\"-10\" y=\"-16\" width=\"4\" height=\"60\" fill=\"#DE2626\" />\n          <text x=\"14\" y=\"10\" fill=\"#FFFFFF\" font-size=\"13\" font-family=\"monospace\" font-weight=\"700\">REST ENGINE</text>\n          <text x=\"14\" y=\"30\" fill=\"#888899\" font-size=\"11\" font-family=\"monospace\">Gemini &bull; Groq &bull; OpenRouter</text>\n        </g>\n\n        <g transform=\"translate(140, 390)\">\n          <rect x=\"-10\" y=\"-16\" width=\"220\" height=\"60\" rx=\"4\" fill=\"#0c0c10\" stroke=\"#2a2a38\" stroke-width=\"1.5\" />\n          <rect x=\"-10\" y=\"-16\" width=\"4\" height=\"60\" fill=\"#DE2626\" />\n          <text x=\"14\" y=\"10\" fill=\"#FFFFFF\" font-size=\"13\" font-family=\"monospace\" font-weight=\"700\">ZERO-LEAKAGE VAULT</text>\n          <text x=\"14\" y=\"30\" fill=\"#888899\" font-size=\"11\" font-family=\"monospace\">RAM-Only ENV:* Key Pointers</text>\n        </g>\n\n        <!-- Peripheral Component Nodes (Right Side) -->\n        <g transform=\"translate(940, 140)\">\n          <rect x=\"-10\" y=\"-16\" width=\"220\" height=\"60\" rx=\"4\" fill=\"#0c0c10\" stroke=\"#2a2a38\" stroke-width=\"1.5\" />\n          <rect x=\"-10\" y=\"-16\" width=\"4\" height=\"60\" fill=\"#DE2626\" />\n          <text x=\"14\" y=\"10\" fill=\"#FFFFFF\" font-size=\"13\" font-family=\"monospace\" font-weight=\"700\">INTERACTIONS DRIVER</text>\n          <text x=\"14\" y=\"30\" fill=\"#888899\" font-size=\"11\" font-family=\"monospace\">Stateful gemini-3.x Context</text>\n        </g>\n\n        <g transform=\"translate(940, 390)\">\n          <rect x=\"-10\" y=\"-16\" width=\"220\" height=\"60\" rx=\"4\" fill=\"#0c0c10\" stroke=\"#2a2a38\" stroke-width=\"1.5\" />\n          <rect x=\"-10\" y=\"-16\" width=\"4\" height=\"60\" fill=\"#DE2626\" />\n          <text x=\"14\" y=\"10\" fill=\"#FFFFFF\" font-size=\"13\" font-family=\"monospace\" font-weight=\"700\">CONTEXT DRIPPER</text>\n          <text x=\"14\" y=\"30\" fill=\"#888899\" font-size=\"11\" font-family=\"monospace\">Dynamic Keyword Memory Bubble</text>\n        </g>\n\n        <!-- Central Isometric 104a Floating-Top Core Cube -->\n        <g transform=\"translate(640, 310)\" class=\"anim-core\">\n          <!-- Outer Halo Ring -->\n          <circle cx=\"0\" cy=\"0\" r=\"110\" fill=\"none\" stroke=\"#DE2626\" stroke-width=\"1\" stroke-dasharray=\"6 6\" opacity=\"0.4\" />\n          <circle cx=\"0\" cy=\"0\" r=\"85\" fill=\"none\" stroke=\"#FFFFFF\" stroke-width=\"1\" opacity=\"0.15\" />\n\n          <!-- Base Cube: Left Face -->\n          <polygon points=\"0,20 -60,-15 -60,55 0,90\" fill=\"url(#cubeLeft)\" stroke=\"#000000\" stroke-width=\"1\" />\n          <!-- Base Cube: Right Face -->\n          <polygon points=\"0,20 60,-15 60,55 0,90\" fill=\"url(#cubeRight)\" stroke=\"#000000\" stroke-width=\"1\" />\n          <!-- Floating Top Geometry (104a Signature) -->\n          <polygon points=\"0,-45 -60,-75 0,-105 60,-75\" fill=\"url(#cubeTop)\" stroke=\"#DE2626\" stroke-width=\"2\" />\n          <polygon points=\"0,-45 -60,-75 -60,-65 0,-35\" fill=\"#888888\" />\n          <polygon points=\"0,-45 60,-75 60,-65 0,-35\" fill=\"#555555\" />\n\n          <!-- Center Beacon Gem -->\n          <circle cx=\"0\" cy=\"-75\" r=\"7\" fill=\"#DE2626\" />\n        </g>\n\n        <!-- Main Banner Title Overlay (Bottom Center) -->\n        <g transform=\"translate(640, 490)\">\n          <rect x=\"-420\" y=\"-10\" width=\"840\" height=\"70\" rx=\"6\" fill=\"#08080c\" fill-opacity=\"0.9\" stroke=\"#22222e\" stroke-width=\"1\" />\n          <text x=\"0\" y=\"24\" fill=\"#FFFFFF\" font-size=\"24\" font-family=\"-apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif\" font-weight=\"900\" text-anchor=\"middle\" letter-spacing=\"3\">MASTERING NEWAGENT</text>\n          <text x=\"0\" y=\"48\" fill=\"#DE2626\" font-size=\"11\" font-family=\"monospace\" font-weight=\"700\" text-anchor=\"middle\" letter-spacing=\"2\">HIGH-PERFORMANCE ASYNC AI ORCHESTRATION &bull; TABULAR BEJSON PERSISTENCE</text>\n        </g>\n\n        <!-- Footer Metric / Status Strip -->\n        <rect x=\"0\" y=\"592\" width=\"1280\" height=\"48\" fill=\"#050508\" />\n        <line x1=\"0\" y1=\"592\" x2=\"1280\" y2=\"592\" stroke=\"#1f1f28\" stroke-width=\"1\" />\n        <g transform=\"translate(640, 622)\">\n          <text x=\"0\" y=\"0\" fill=\"#888899\" font-size=\"12\" font-family=\"monospace\" text-anchor=\"middle\">\n            <tspan fill=\"#00FF66\">&bull; 131 TESTS PASSING</tspan>\n            <tspan fill=\"#555566\"> &bull; </tspan>\n            <tspan fill=\"#FFFFFF\">40%&ndash;70% TOKEN REDUCTION</tspan>\n            <tspan fill=\"#555566\"> &bull; </tspan>\n            <tspan fill=\"#DE2626\">O(1) FIELD MAP CACHE</tspan>\n            <tspan fill=\"#555566\"> &bull; </tspan>\n            <tspan fill=\"#FFFFFF\">RAM-ONLY CREDENTIALS</tspan>\n          </text>\n        </g>\n      </svg>\n    </div>\n  </div>\n\n  <script>\n    window.seekProgress = function(ratio) {\n      console.log(\"Timeline seek:\", ratio);\n    };\n  </script>\n</body>\n</html>\n",
