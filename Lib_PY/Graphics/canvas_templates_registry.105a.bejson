      "240:80",
      "#capture-stage",
      "Exemplar template template_graphic_button_240x80.html from /storage/emulated/0/Admin/Dev/Templates/Canvas_SVG_Capture_Templates",
      "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"UTF-8\">\n  <title>Canvas Graphic \u2014 240x80 Action Button</title>\n  <style>\n    * {\n      box-sizing: border-box;\n      margin: 0;\n      padding: 0;\n    }\n    body {\n      background: #000000;\n      color: #FFFFFF;\n      width: 100vw;\n      height: 100vh;\n      display: flex;\n      align-items: center;\n      justify-content: center;\n      overflow: hidden;\n      font-family: monospace;\n    }\n    #capture-stage {\n      position: relative;\n      width: 240px;\n      height: 80px;\n      background: #000000;\n      overflow: hidden;\n      display: flex;\n      align-items: center;\n      justify-content: center;\n    }\n    .svg-container {\n      width: 100%;\n      height: 100%;\n      display: flex;\n      align-items: center;\n      justify-content: center;\n    }\n    svg {\n      width: 100%;\n      height: 100%;\n      display: block;\n    }\n\n    @keyframes pulseGlow {\n      0%, 100% {\n        filter: drop-shadow(0 0 4px rgba(222, 38, 38, 0.4));\n      }\n      50% {\n        filter: drop-shadow(0 0 12px rgba(222, 38, 38, 0.9));\n      }\n    }\n    @keyframes chevronShift {\n      0%, 100% { transform: translateX(0); }\n      50% { transform: translateX(4px); }\n    }\n\n    .anim-glow {\n      animation: pulseGlow 2.5s ease-in-out infinite;\n    }\n    .anim-arrow {\n      animation: chevronShift 1.5s ease-in-out infinite;\n    }\n  </style>\n</head>\n<body>\n  <div id=\"capture-stage\">\n    <div class=\"svg-container\">\n      <svg viewBox=\"0 0 240 80\" xmlns=\"http://www.w3.org/2000/svg\">\n        <defs>\n          <linearGradient id=\"btnBg\" x1=\"0\" y1=\"0\" x2=\"1\" y2=\"1\">\n            <stop offset=\"0%\" stop-color=\"#14141d\"/>\n            <stop offset=\"100%\" stop-color=\"#08080c\"/>\n          </linearGradient>\n        </defs>\n\n        <!-- Button Outer Perimeter with Chamfers -->\n        <g class=\"anim-glow\">\n          <polygon points=\"18,8 222,8 232,18 232,62 222,72 18,72 8,62 8,18\" fill=\"url(#btnBg)\" stroke=\"#DE2626\" stroke-width=\"2\"/>\n        </g>\n        <polygon points=\"21,12 219,12 228,21 228,59 219,68 21,68 12,59 12,21\" fill=\"none\" stroke=\"#252535\" stroke-width=\"1\"/>\n\n        <!-- Left Micro-Cube Icon -->\n        <g transform=\"translate(18, 16)\">\n          <!-- Cube Top -->\n          <polygon points=\"16,10 26,16 16,22 6,16\" fill=\"#FFFFFF\" stroke=\"#DE2626\" stroke-width=\"1\"/>\n          <!-- Cube Left -->\n          <polygon points=\"16,22 6,16 6,28 16,34\" fill=\"#252533\" stroke=\"#3d3d50\" stroke-width=\"1\"/>\n          <!-- Cube Right -->\n          <polygon points=\"16,22 26,16 26,28 16,34\" fill=\"#14141c\" stroke=\"#3d3d50\" stroke-width=\"1\"/>\n          <line x1=\"16\" y1=\"22\" x2=\"16\" y2=\"34\" stroke=\"#DE2626\" stroke-width=\"1.5\"/>\n          <circle cx=\"16\" cy=\"22\" r=\"1.5\" fill=\"#DE2626\"/>\n        </g>\n\n        <!-- Button Label -->\n        <text x=\"64\" y=\"44\" fill=\"#FFFFFF\" font-size=\"12\" font-family=\"monospace\" font-weight=\"700\" letter-spacing=\"2\">INITIALIZE_CORE</text>\n        <text x=\"64\" y=\"58\" fill=\"#777788\" font-size=\"8\" font-family=\"monospace\" letter-spacing=\"1\">L5 \u00b7 DETERMINISTIC</text>\n\n        <!-- Right Chevron Accent -->\n        <g class=\"anim-arrow\" transform=\"translate(208, 34)\">\n          <path d=\"M 0 0 L 6 6 L 0 12\" fill=\"none\" stroke=\"#DE2626\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/>\n        </g>\n      </svg>\n    </div>\n  </div>\n\n  <script>\n    window.isReadyToCapture = false;\n    window.pauseAnimation = function() {\n      document.querySelectorAll('*').forEach(el => el.style.animationPlayState = 'paused');\n    };\n    window.playAnimation = function() {\n      document.querySelectorAll('*').forEach(el => el.style.animationPlayState = 'running');\n    };\n    window.seekProgress = function(progress) {\n      const totalDurationSec = 2.5;\n      const targetTimeSec = progress * totalDurationSec;\n      document.querySelectorAll('*').forEach(el => {\n        el.style.animationDelay = `-${targetTimeSec}s`;\n        el.style.animationPlayState = 'paused';\n      });\n    };\n    window.addEventListener('DOMContentLoaded', () => {\n      setTimeout(() => { window.isReadyToCapture = true; }, 200);\n    });\n  </script>\n</body>\n</html>\n",
